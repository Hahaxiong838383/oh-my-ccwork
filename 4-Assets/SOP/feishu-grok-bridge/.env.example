# feishu-grok-bridge — copy to .env on the host (never commit real secrets)
FEISHU_CREDENTIAL_SECRET=
FEISHU_ACCOUNTS_FILE=
ALLOW_OPEN_IDS=

GROK_BIN=
GROK_CWD=
# full-mode turns / short Q&A turns
GROK_MAX_TURNS=40
GROK_SHORT_MAX_TURNS=8
# single-run wall clock (ms). NOT "idle 10min then rotate session".
GROK_TIMEOUT_MS=600000
# session size gates (bytes)
GROK_SESSION_MAX_BYTES=20971520
GROK_SESSION_RESUME_MAX_BYTES=5242880
# sticky session map path (optional)
# GROK_SESSION_MAP=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.feishu.cn,.larksuite.com
LOG_FILE=
GROK_ALLOWED_ROOTS=
GROK_MEMORY=1
# applied only in full mode
GROK_EXTRA_ARGS=--experimental-memory
