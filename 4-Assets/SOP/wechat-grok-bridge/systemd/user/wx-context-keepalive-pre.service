[Unit]
Description=WeChat context_token check (before dream push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/wechat-grok-bridge
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/bin:/bin
EnvironmentFile=-%h/wechat-grok-bridge/.env
Environment=WX_KEEPALIVE_PREMORNING_AGE_H=12
Environment=WX_KEEPALIVE_STALE_AGE_H=22
Environment=WX_KEEPALIVE_COOLDOWN_H=8
ExecStart=/usr/bin/node %h/wechat-grok-bridge/scripts/wechat-context-keepalive.mjs --pre-morning
Nice=10
TimeoutStartSec=90
