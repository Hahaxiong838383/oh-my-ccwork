# 微信凭据（wechat-qr-login-module AES 存储）
WECHAT_CREDENTIAL_SECRET=replace-with-32plus-random-chars-please
WECHAT_ACCOUNTS_FILE=/home/USER/wechat-qr-login-module/.data/wechat-accounts.json

# 白名单：ilink_user_id，逗号分隔；扫码登录者会自动加入；空=放行全部（仅首装调试）
ALLOW_USER_IDS=

# 群聊策略
REQUIRE_GROUP_PREFIX=1
GROUP_SESSIONS_PER_USER=1
BOT_DISPLAY_NAME=

# Grok
GROK_BIN=/home/USER/.grok/bin/grok
GROK_CWD=/home/USER/wechat-grok-bridge/workspace
GROK_HOME=/home/USER/.grok
GROK_MAX_TURNS=100
GROK_SHORT_MAX_TURNS=24
# 动态墙钟：按任务复杂度估预算（非写死 15min）
# GROK_TIMEOUT_MS 仅作 standard 锚点；实际在 MIN~MAX 间动态选
GROK_TIMEOUT_MS=900000
GROK_TIMEOUT_MIN_MS=480000
GROK_TIMEOUT_MAX_MS=2700000
# max-turns / 墙钟 自动续跑（同 session，避免丢进度）
GROK_CONTINUE_ON_MAX_TURNS=3
GROK_CONTINUE_MAX_TURNS=100
GROK_SESSION_MAX_BYTES=20971520
GROK_SESSION_RESUME_MAX_BYTES=2097152
GROK_EXTRA_ARGS=--experimental-memory
GROK_ALLOWED_ROOTS=/home/USER

# session-gc 用
WECHAT_GROK_BRIDGE_ROOT=/home/USER/wechat-grok-bridge

# 出网代理（linux-lan 本机 xray）
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808
ALL_PROXY=socks5h://127.0.0.1:10808
NO_PROXY=localhost,127.0.0.1,::1,192.168.0.0/16,10.0.0.0/8,.weixin.qq.com,ilinkai.weixin.qq.com,novac2c.cdn.weixin.qq.com

LOG_FILE=/home/USER/wechat-grok-bridge/logs/bridge.log

# second-brain 知识库（存库 / 知识库状态 / 整理知识库 / 本周复盘）
SECOND_BRAIN_VAULT=/home/USER/second-brain
# 入库默认靠口令：存库/入库/收藏/记录 …（见 lib/vault-ingest.mjs）
# 1=仅「薄分享」（几乎只有链接/附件、无任务语气）才自动入库；默认 0 推荐
VAULT_AUTO_INGEST=0
# 1=薄分享里的公众号链接可自动入库（仍受任务语气拦截；默认 0）
VAULT_AUTO_INGEST_WECHAT=0

# 微信进度反馈（仅通道内；默认开）
# Quicksilver：首条进度 12s（原 60s），心跳 90s
WX_STATUS=1
WX_STATUS_FIRST_SEC=12
WX_STATUS_HEARTBEAT_SEC=90
WX_STATUS_MAX_BEATS=8
WX_STATUS_SPARSE_SEC=300
WX_STATUS_IDLE_WARN_SEC=180
WX_STATUS_PRE_TIMEOUT_SEC=120

# 桥启动时后台预热 grok 二进制/鉴权（1=开，0=关）
GROK_PREWARM=1

# 常驻 Grok leader（共享 auth/热路径；headless 经 --leader-socket 复用）
GROK_LEADER=1
# GROK_LEADER_SOCKET=/home/USER/wechat-grok-bridge/data/leader.sock
# GROK_LEADER_RESTART_MS=3000
# GROK_LEADER_MAX_RESTARTS=20

# 并发 worker 池大小（默认 2；1=等同旧串行队列）
GROK_WORKER_POOL_SIZE=2

# 微信流式气泡（streaming-json 节流追加；定稿只补后缀+附件）
WX_STREAM=1
WX_STREAM_INTERVAL_MS=1800
WX_STREAM_MIN_CHARS=48
WX_STREAM_MAX_CHARS=1600
# WX_STREAM_PREFIX=【进行中】\n
# 是否把 thought 低频刷成【进度】（默认关，防刷屏）
WX_STREAM_THOUGHT=0
# WX_STREAM_THOUGHT_INTERVAL_MS=45000
