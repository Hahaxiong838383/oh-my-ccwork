#!/usr/bin/env bash

set -u

REPORT="${H_PLATFORM_DAILY_REPORT:-$HOME/.local/state/h-platform-daily-ops/latest.json}"
SERVICE="${H_PLATFORM_DAILY_SERVICE:-h-platform-daily-ops.service}"

if [[ "${H_PLATFORM_DAILY_SKIP_RUN:-0}" == "1" ]]; then
  service_rc="${H_PLATFORM_DAILY_SERVICE_RC:-0}"
else
  /usr/bin/systemctl --user start --wait "$SERVICE"
  service_rc=$?
fi

/usr/bin/python3 - "$REPORT" "$service_rc" <<'PY'
import json
import pathlib
import sys

report_path = pathlib.Path(sys.argv[1])
service_rc = int(sys.argv[2])

memory_refs = [
    "project_feishu_grok_h_byos",
    "feedback_tenant_capability_drift_mechanism",
    "feedback_identifier_shape_is_not_identity",
    "feedback_concurrent_sessions_shared_checkout",
]

try:
    report = json.loads(report_path.read_text(encoding="utf-8"))
except Exception as exc:
    print(json.dumps({
        "schemaVersion": 1,
        "ok": False,
        "serviceExit": service_rc,
        "report": str(report_path),
        "reportError": f"{type(exc).__name__}: {exc}",
        "issues": [],
        "memoryRefs": memory_refs,
    }, ensure_ascii=False, separators=(",", ":")))
    raise SystemExit(3)

issues = []
for item in report.get("issues") or []:
    if not isinstance(item, dict):
        continue
    issues.append({
        "code": str(item.get("code") or "unknown"),
        "level": str(item.get("level") or "unknown"),
        "message": str(item.get("message") or ""),
    })

print(json.dumps({
    "schemaVersion": 1,
    "ok": service_rc == 0,
    "serviceExit": service_rc,
    "checkedAt": report.get("checkedAt"),
    "status": report.get("status"),
    "issueCount": len(issues),
    "issues": issues,
    "memoryRefs": memory_refs,
    "summary": report.get("summary") or {},
    "report": str(report_path),
}, ensure_ascii=False, separators=(",", ":")))

raise SystemExit(service_rc)
PY
