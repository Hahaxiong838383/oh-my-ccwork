# Garden Skills · gpt-image-2 凭据配置模板（脱敏，可入 git）
#
# 实际凭据存放位置：~/.gateway.env（chmod 600，本地，不在任何 git repo 内）
# 自动加载：gpt-image-2/scripts/shared.js 的 loadAmbientEnv() 优先级 cwd/.env > cwd/.gateway.env > ~/.gateway.env
#
# 配置时复制本模板到 ~/.gateway.env，填入实际值，执行 chmod 600 ~/.gateway.env
# 然后任意位置跑 node SoT/skills/gpt-image-2/scripts/check-mode.js 验证 has_api_key=true

ENABLE_GARDEN_IMAGEGEN=1
OPENAI_API_KEY=sk-REDACTED
OPENAI_BASE_URL=https://1052.cc.cd:5005/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# 故障排查：
# - check-mode 输出 mode=A 但出图 404 → BASE_URL 改为 https://1052.cc.cd:5005（去 /v1）
# - 401 Unauthorized → key 失效，找老板要新的
# - timeout → 网关 1052.cc.cd:5005 网络不通，本地 curl 测一下
