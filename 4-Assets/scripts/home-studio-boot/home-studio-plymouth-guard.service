# Finish a verified headless GDM/Plymouth handoff without restarting GDM.
[Unit]
Description=home-studio headless Plymouth handoff recovery
After=gdm.service plymouth-start.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/home-studio-plymouth-guard.py
TimeoutStartSec=45s
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
