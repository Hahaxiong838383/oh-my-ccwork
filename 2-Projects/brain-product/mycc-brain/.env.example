# mycc-brain 配置
# 复制为 .env.local 使用；运行时优先级：现有 shell env > .env.local > .env
BRAIN_PORT=19080
BRAIN_API_KEY=sk-brain-dev
BRAIN_DEFAULT_MODEL=cc-gemini-3.1-flash

# Qwen (DashScope) — 主力
QWEN_API_KEY=

# DeepSeek — 备选
DEEPSEEK_API_KEY=

# Ollama — 本地模型
OLLAMA_BASE_URL=http://localhost:11434

# Gemini Proxy / MiniMax（Studio 当前验证阶段默认路由）
GEMINI_PROXY_KEY=
MINIMAX_API_KEY=

# 记忆数据目录（默认可指向 monorepo 根目录下 0-System）
DATA_DIR=/path/to/mycc/0-System

# Gemini — eval Judge 用（跨家族消偏）
GEMINI_API_KEY=
