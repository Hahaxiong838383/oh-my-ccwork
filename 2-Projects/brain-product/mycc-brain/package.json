{
  "name": "mycc-brain",
  "version": "0.10.0",
  "description": "mycc-brain: OpenAI-compatible API proxy with memory injection",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mycc-brain-mcp": "dist/mcp-entry.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp-entry.js",
    "eval": "tsx src/eval/eval.ts",
    "eval:dry": "tsx src/eval/eval.ts --dry-run"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
