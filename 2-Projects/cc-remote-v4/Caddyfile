:19443 {
	# V4: Basic Auth 由 nginx 外层处理，Caddy 不再认证

	# 管理面板
	handle / {
		root * /Users/rayman.chen/mycc/2-Projects/cc-remote-v4/panel
		file_server
	}
	handle /panel/* {
		root * /Users/rayman.chen/mycc/2-Projects/cc-remote-v4/panel
		file_server
	}

	# 按键注入 API
	handle /api/* {
		reverse_proxy localhost:19100
	}

	# ttyd 实例反代（固定 3 个路径 → 3 个端口）
	# 新建 session 会复用这些路径（替换旧 ttyd 进程）
	handle /claude/* {
		reverse_proxy localhost:19001 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle /codex/* {
		reverse_proxy localhost:19002 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle /gemini/* {
		reverse_proxy localhost:19003 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}
