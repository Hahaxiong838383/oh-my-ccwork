# ── 编译产物(根目录的裸二进制 + app bundle,不入库) ──
/cc-monitor
/cc-monitor-dock
/cc-monitor-menubar
/cc-monitor.app/
/cc-monitor-dock.app/
*.dSYM/

# ── Xcode 构建产物 / 用户态(保留 .xcodeproj 工程本体,可复现) ──
xcode/cc-monitor/build/
xcode/**/xcuserdata/
xcode/**/*.xcuserstate
**/DerivedData/

# ── AppIcon 资源 PNG 必须入库(覆盖 mycc 根 .gitignore 的 *.png,否则克隆后图标丢失) ──
!xcode/cc-monitor/cc-monitor/Assets.xcassets/AppIcon.appiconset/*.png
