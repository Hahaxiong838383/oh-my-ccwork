+import hashlib
+import json
+from pathlib import Path
+import sys
+import pytest
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'proxy'))
+from compatibility import CompatibilityGuard
+
+
+def test_version_and_binary_guard(tmp_path, monkeypatch):
+    executable = tmp_path / 'trim-media'
+    executable.write_bytes(b'official-fixture-v1')
+    manifest = tmp_path / 'manifest'
+    manifest.write_text('version="0.9.8-1"\n')
+    lock = tmp_path / 'compatibility.json'
+    lock.write_text(json.dumps({'executable': str(executable), 'manifest': str(manifest),
+        'version': '0.9.8-1', 'sha256': hashlib.sha256(executable.read_bytes()).hexdigest()}))
+    monkeypatch.setenv('FNMEDIA_COMPAT_LOCK', str(lock))
+    guard = CompatibilityGuard()
+    guard.validate()
+    assert not guard.changed()
+    manifest.write_text('version="0.9.9-1"\n')
+    assert guard.changed()
+    with pytest.raises(RuntimeError): CompatibilityGuard().validate()
+    manifest.write_text('version="0.9.8-1"\n')
+    replacement = tmp_path / 'replacement'
+    replacement.write_bytes(b'official-fixture-v2')
+    replacement.replace(executable)
+    assert guard.changed()
+    with pytest.raises(RuntimeError): CompatibilityGuard().validate()
+    executable.unlink()
+    assert guard.changed()
+
+
+def test_missing_lock_fails_closed(tmp_path, monkeypatch):
+    monkeypatch.setenv('FNMEDIA_COMPAT_LOCK', str(tmp_path / 'missing.json'))
+    with pytest.raises(FileNotFoundError): CompatibilityGuard()
