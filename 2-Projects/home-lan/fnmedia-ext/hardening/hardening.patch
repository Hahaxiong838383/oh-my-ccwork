+def test_app_entry_redirects_to_cookie_scope():
+    tmp_path = Path(tempfile.mkdtemp(prefix="fgw-", dir="/tmp"))
+    (tmp_path / 'ui').mkdir()
+    (tmp_path / 'repo').mkdir()
+    path = tmp_path / 'fnmedia-ext.sock'
+    proc = subprocess.Popen([sys.executable, str(ROOT / 'proxy/webui_gateway.py'), str(tmp_path / 'repo')])
+    try:
+        deadline = time.monotonic() + 4
+        while not path.exists() and time.monotonic() < deadline:
+            time.sleep(.05)
+        with socket.socket(socket.AF_UNIX) as client:
+            client.settimeout(3)
+            client.connect(str(path))
+            client.sendall(b'GET /app/fnmedia-ext/ HTTP/1.1\r\nHost: nas:5667\r\nConnection: close\r\n\r\n')
+            result = b''
+            while chunk := client.recv(4096): result += chunk
+        assert b'302 Found' in result
+        assert b'Location: /v/online-admin\r\n' in result
+        assert b'Cache-Control: no-store' in result
+    finally:
+        proc.terminate()
+        proc.wait(timeout=5)
+        shutil.rmtree(tmp_path)
