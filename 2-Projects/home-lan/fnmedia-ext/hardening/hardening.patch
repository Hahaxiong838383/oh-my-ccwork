+#!/usr/bin/env python3
+"""fnmedia-ext 接管恢复：带归属校验的 fail-safe socket 复原。
+
+背景（v0.2.17 前的缺陷）：
+  supervise.py 把官方 trim_media.sock 改名为 trim_media_upstream.sock，再把自己的
+  socket 换名到 trim_media.sock。若 supervisor 被 SIGKILL / OOM / 启动失败打断，
+  磁盘上会留下「target=本代理（或空）、upstream=官方」的半接管现场；systemd 单元
+  Restart=no 且没有 ExecStopPost，没人收拾，下次启动又因「预检发现 upstream 存在」
+  直接拒绝启动 —— 官方 socket 长时间缺位。
+
+本模块的原则：
+  1. 归属可证明才动手（inode + dev 身份，辅以 pid + /proc starttime 防 PID 复用）；
+  2. 不删除活着的、不是我们的监听者（未知替换的官方 socket）；
+  3. 不删除非 socket 文件 / 符号链接；
+  4. 任何不确定 → 退出码 3（UNSAFE），保持现场等人工处理，绝不猜测；
+  5. 幂等：重复执行结果一致（systemd ExecStartPre / ExecStopPost 都可能反复调用）；
+  6. 关键区屏蔽 SIGTERM/SIGINT，恢复动作是几个原子 rename/unlink，不会被半途打断。
+
+退出码：
+  0 已恢复或本来无需恢复
+  1 执行失败（IO/权限等）
+  3 现场归属不明，拒绝自动处理（需要人工）
+  4 另一个 supervisor/recovery 正在运行（flock 占用）
+  5 命令行/环境配置错误
+"""
+from __future__ import annotations
+
+import argparse
+import ctypes
+import errno
+import fcntl
+import json
+import os
+from pathlib import Path
+import signal
+import socket
+import stat
+import struct
+import sys
+import time
+from dataclasses import dataclass
+from typing import Any, Mapping
+
+LOG_PREFIX = "[fnmedia-recover]"
+
+DEFAULT_TARGET = "/var/run/trim_media.sock"
+DEFAULT_UPSTREAM = "/var/run/trim_media_upstream.sock"
+DEFAULT_STATE_DIR = "/run/fnmedia-ext"
+DEFAULT_OFFICIAL = "trim-media"
+
+STATE_NAME = "takeover.json"
+LOCK_NAME = "takeover.lock"
+STATE_VERSION = 1
+
+EXIT_OK = 0
+EXIT_FAIL = 1
+EXIT_UNSAFE = 3
+EXIT_BUSY = 4
+EXIT_USAGE = 5
+
+_RENAME_NOREPLACE = 1
+_AT_FDCWD = -100
+
+
+class RecoveryError(RuntimeError):
+    """带退出码的恢复错误。"""
+
+    def __init__(self, code: int, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+def log(message: str) -> None:
+    print(f"{LOG_PREFIX} {message}", flush=True)
+
+
+# ---------------------------------------------------------------- 配置
+
+@dataclass(frozen=True)
+class Paths:
+    target: Path
+    upstream: Path
+    state_dir: Path
+    official_names: tuple[str, ...]
+    official_wait: float = 60.0
+    kill_timeout: float = 8.0
+    health_timeout: float = 20.0
+
+    @property
+    def state_file(self) -> Path:
+        return self.state_dir / STATE_NAME
+
+    @property
+    def lock_file(self) -> Path:
+        return self.state_dir / LOCK_NAME
+
+
+def paths_from_env(env: Mapping[str, str] | None = None) -> Paths:
+    env = os.environ if env is None else env
+
+    def _num(key: str, default: float) -> float:
+        raw = (env.get(key) or "").strip()
+        if not raw:
+            return default
+        try:
+            value = float(raw)
+        except ValueError:
+            raise RecoveryError(EXIT_USAGE, f"{key} 不是数字: {raw!r}")
+        if value < 0:
+            raise RecoveryError(EXIT_USAGE, f"{key} 不能为负: {value}")
+        return value
+
+    raw_names = (env.get("FNMEDIA_OFFICIAL_EXE") or DEFAULT_OFFICIAL)
+    names = tuple(n.strip().lower() for n in raw_names.split(",") if n.strip())
+    if not names:
+        raise RecoveryError(EXIT_USAGE, "FNMEDIA_OFFICIAL_EXE 为空")
+
+    return Paths(
+        target=Path(env.get("FNMEDIA_TARGET_SOCK") or DEFAULT_TARGET),
+        upstream=Path(env.get("FNMEDIA_UPSTREAM_SOCK") or DEFAULT_UPSTREAM),
+        state_dir=Path(env.get("FNMEDIA_STATE_DIR") or DEFAULT_STATE_DIR),
+        official_names=names,
+        official_wait=_num("FNMEDIA_OFFICIAL_WAIT", 60.0),
+        kill_timeout=_num("FNMEDIA_KILL_TIMEOUT", 8.0),
+        health_timeout=_num("FNMEDIA_HEALTH_TIMEOUT", 20.0),
+    )
+
+
+# ---------------------------------------------------------------- 原子 rename
+
+_libc = ctypes.CDLL(None, use_errno=True)
+
+
+def rename_noreplace(src: Path | str, dst: Path | str) -> None:
+    """renameat2(RENAME_NOREPLACE)：目标已存在则 EEXIST，绝不覆盖。"""
+    if _libc.renameat2(_AT_FDCWD, os.fsencode(str(src)),
+                       _AT_FDCWD, os.fsencode(str(dst)), _RENAME_NOREPLACE) != 0:
+        err = ctypes.get_errno()
+        raise OSError(err, f"renameat2(NOREPLACE) {src} -> {dst}: {os.strerror(err)}")
+
+
+# ---------------------------------------------------------------- /proc 身份
+
+def _read_proc_stat(pid: int) -> dict[str, Any] | None:
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as fh:
+            data = fh.read()
+    except (FileNotFoundError, ProcessLookupError, PermissionError, OSError):
+        return None
+    rparen = data.rfind(b")")
+    if rparen < 0:
+        return None
+    rest = data[rparen + 2:].split()
+    if len(rest) < 20:
+        return None
+    try:
+        return {"state": rest[0].decode("ascii", "replace"),
+                "starttime": int(rest[19])}
+    except ValueError:
+        return None
+
+
+def proc_starttime(pid: int | None) -> int | None:
+    if not pid:
+        return None
+    st = _read_proc_stat(int(pid))
+    return None if st is None else st["starttime"]
+
+
+def proc_state(pid: int | None) -> str | None:
+    if not pid:
+        return None
+    st = _read_proc_stat(int(pid))
+    return None if st is None else st["state"]
+
+
+def proc_exe(pid: int | None) -> str | None:
+    if not pid:
+        return None
+    try:
+        return os.readlink(f"/proc/{int(pid)}/exe")
+    except OSError:
+        return None
+
+
+def proc_cmdline0(pid: int | None) -> str | None:
+    if not pid:
+        return None
+    try:
+        with open(f"/proc/{int(pid)}/cmdline", "rb") as fh:
+            raw = fh.read()
+    except OSError:
+        return None
+    first = raw.split(b"\0", 1)[0]
+    return first.decode("utf-8", "replace") or None
+
+
+def proc_identity(pid: int | None) -> dict[str, Any] | None:
+    """进程身份快照；进程不存在返回 None。starttime 用来防 PID 复用。"""
+    if not pid:
+        return None
+    pid = int(pid)
+    st = _read_proc_stat(pid)
+    if st is None:
+        return None
+    return {
+        "pid": pid,
+        "starttime": st["starttime"],
+        "state": st["state"],
+        "exe": proc_exe(pid),
+        "cmdline0": proc_cmdline0(pid),
+    }
+
+
+def identity_strict(identity: Mapping[str, Any] | None,
+                    recorded: Mapping[str, Any] | None) -> bool:
+    """pid 与 /proc starttime 都必须一致；缺 starttime 一律视为不匹配。"""
+    if not identity or not recorded:
+        return False
+    if not recorded.get("pid") or identity.get("pid") != recorded.get("pid"):
+        return False
+    rec_st = recorded.get("starttime")
+    cur_st = identity.get("starttime")
+    if rec_st is None or cur_st is None:
+        return False
+    return int(rec_st) == int(cur_st)
+
+
+def is_official(identity: Mapping[str, Any] | None, names: tuple[str, ...]) -> bool:
+    if not identity or not names:
+        return False
+    lowered = {n.lower() for n in names}
+    for candidate in (identity.get("exe"), identity.get("cmdline0")):
+        if candidate and os.path.basename(str(candidate)).lower() in lowered:
+            return True
+    return False
+
+
+# ---------------------------------------------------------------- socket 事实
+
+def peer_pid(path: Path | str, timeout: float = 1.0) -> int | None:
+    """连接 socket 取 SO_PEERCRED。
+
+    None = 路径在但没有监听者（死 socket）；异常 = 无法判定归属。
+    超时不能当作“死”，因为可能是 backlog 满的活监听者 → 抛 UNSAFE。
+    """
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    try:
+        sock.connect(str(path))
+    except (ConnectionRefusedError, FileNotFoundError):
+        return None
+    except socket.timeout:
+        raise RecoveryError(EXIT_UNSAFE, f"连接 {path} 超时，无法判定监听者归属")
+    except OSError as exc:
+        if exc.errno in (errno.ECONNREFUSED, errno.ENOENT):
+            return None
+        raise RecoveryError(EXIT_UNSAFE, f"连接 {path} 失败，无法判定归属: {exc}")
+    try:
+        raw = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
+        return struct.unpack("3i", raw)[0]
+    finally:
+        sock.close()
+
+
+def peer_identity(path: Path | str) -> dict[str, Any] | None:
+    pid = peer_pid(path)
+    if pid is None:
+        return None
+    return proc_identity(pid)
+
+
+def socket_facts(path: Path | str) -> dict[str, Any]:
+    """路径现场事实：inode 身份、是否 socket/符号链接、是否有活监听者。"""
+    path = Path(path)
+    try:
+        st = os.lstat(path)
+    except FileNotFoundError:
+        return {"path": str(path), "exists": False, "is_socket": False,
+                "is_symlink": False, "live": False, "live_pid": None}
+    except OSError as exc:
+        raise RecoveryError(EXIT_UNSAFE, f"lstat {path} 失败: {exc}")
+
+    is_socket = stat.S_ISSOCK(st.st_mode)
+    facts: dict[str, Any] = {
+        "path": str(path),
+        "exists": True,
+        "dev": st.st_dev,
+        "ino": st.st_ino,
+        # rename 只改 ctime，不动 mtime；unlink 后重建的 socket 即使 inode 号被复用，
+        # mtime 也不同 —— 所以身份用 dev+ino+mtime_ns，不能只看 inode。
+        "mtime_ns": st.st_mtime_ns,
+        "ctime_ns": st.st_ctime_ns,
+        "mode": stat.S_IMODE(st.st_mode),
+        "is_socket": is_socket,
+        "is_symlink": stat.S_ISLNK(st.st_mode),
+        "is_regular": stat.S_ISREG(st.st_mode),
+        "live": False,
+        "live_pid": None,
+    }
+    if is_socket:
+        pid = peer_pid(path)
+        facts["live_pid"] = pid
+        facts["live"] = pid is not None
+    return facts
+
+
+def inode_of(facts: Mapping[str, Any] | None, record: Mapping[str, Any] | None) -> bool:
+    """同一 socket inode 身份：dev + ino + mtime_ns 全等。
+
+    只比 ino 不够——unlink 后立刻重建会复用 inode 号（已实测）。mtime 在 rename
+    前后不变（rename 只更新 ctime），所以跨改名后仍可比较。
+    """
+    if not facts or not record:
+        return False
+    if not facts.get("exists") or facts.get("is_symlink"):
+        return False
+    if not record.get("ino"):
+        return False
+    if int(facts.get("ino", -1)) != int(record["ino"]):
+        return False
+    if int(facts.get("dev", -2)) != int(record.get("dev", -3)):
+        return False
+    rec_mtime = record.get("mtime_ns")
+    if rec_mtime is None:
+        return False  # 旧格式/无 mtime 记录 → 无法证明是同一个 inode
+    return int(facts.get("mtime_ns", -4)) == int(rec_mtime)
+
+
+def safe_unlink_socket(path: Path | str, expected: Mapping[str, Any] | None = None,
+                       *, reason: str = "") -> bool:
+    """只删「无监听者 + 确认是 socket + 非符号链接 + inode 符合预期」的路径。"""
+    path = Path(path)
+    facts = socket_facts(path)
+    if not facts.get("exists"):
+        return False
+    if facts.get("is_symlink"):
+        log(f"拒绝 unlink {path}：是符号链接 {reason}".rstrip())
+        return False
+    if not facts.get("is_socket"):
+        log(f"拒绝 unlink {path}：不是 socket {reason}".rstrip())
+        return False
+    if facts.get("live"):
+        log(f"拒绝 unlink {path}：仍有监听者 pid={facts.get('live_pid')} {reason}".rstrip())
+        return False
+    if expected is not None and not inode_of(facts, expected):
+        log(f"拒绝 unlink {path}：inode {facts.get('dev')}:{facts.get('ino')} "
+            f"与预期不符 {reason}".rstrip())
+        return False
+    # 再确认一次，缩小 TOCTOU 窗口
+    current = socket_facts(path)
+    if not current.get("exists") or current.get("live"):
+        return False
+    if expected is not None and not inode_of(current, expected):
+        log(f"拒绝 unlink {path}：复查 inode 已变化 {reason}".rstrip())
+        return False
+    os.unlink(path)
+    log(f"已删除 {path} {reason}".rstrip())
+    return True
+
+
+# ---------------------------------------------------------------- 目录/权限加固
+
+def ensure_state_dir(paths: Paths) -> None:
+    """状态目录必须是真实目录、属主是当前 euid、权限 0700。"""
+    directory = paths.state_dir
+    try:
+        st = os.lstat(directory)
+    except FileNotFoundError:
+        directory.mkdir(mode=0o700, parents=True, exist_ok=False)
+        st = os.lstat(directory)
+    except OSError as exc:
+        raise RecoveryError(EXIT_FAIL, f"lstat {directory} 失败: {exc}")
+
+    if stat.S_ISLNK(st.st_mode):
+        raise RecoveryError(EXIT_UNSAFE, f"状态目录 {directory} 是符号链接，拒绝使用")
+    if not stat.S_ISDIR(st.st_mode):
+        raise RecoveryError(EXIT_UNSAFE, f"状态目录 {directory} 不是目录")
+    if st.st_uid != os.geteuid() and os.geteuid() != 0:
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"状态目录 {directory} 属主 uid={st.st_uid} 非当前用户")
+    mode = stat.S_IMODE(st.st_mode)
+    if mode != 0o700:
+        try:
+            os.chmod(directory, 0o700)
+            log(f"状态目录 {directory} 权限 {oct(mode)} -> 0o700")
+        except OSError as exc:
+            raise RecoveryError(EXIT_FAIL, f"chmod {directory} 失败: {exc}")
+
+
+def check_paths(paths: Paths) -> None:
+    """target/upstream 必须同目录（rename 同文件系统），且本身不是符号链接。"""
+    if paths.target == paths.upstream:
+        raise RecoveryError(EXIT_USAGE, "target 与 upstream 路径相同")
+    tdir = os.path.realpath(str(paths.target.parent))
+    udir = os.path.realpath(str(paths.upstream.parent))
+    if tdir != udir:
+        raise RecoveryError(EXIT_USAGE,
+                            f"target/upstream 不在同一目录（rename 需同文件系统）: {tdir} != {udir}")
+    try:
+        st = os.stat(tdir)
+    except OSError as exc:
+        raise RecoveryError(EXIT_FAIL, f"socket 目录不可用 {tdir}: {exc}")
+    if not stat.S_ISDIR(st.st_mode):
+        raise RecoveryError(EXIT_UNSAFE, f"socket 目录 {tdir} 不是目录")
+    for path in (paths.target, paths.upstream):
+        try:
+            lst = os.lstat(path)
+        except FileNotFoundError:
+            continue
+        except OSError as exc:
+            raise RecoveryError(EXIT_UNSAFE, f"lstat {path} 失败: {exc}")
+        if stat.S_ISLNK(lst.st_mode):
+            raise RecoveryError(EXIT_UNSAFE,
+                                f"{path} 是符号链接（指向 {os.readlink(path)}），拒绝操作")
+
+
+# ---------------------------------------------------------------- 状态文件
+
+def read_state(paths: Paths) -> dict[str, Any] | None:
+    try:
+        raw = paths.state_file.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise RecoveryError(EXIT_UNSAFE, f"读取状态 {paths.state_file} 失败: {exc}")
+    try:
+        state = json.loads(raw)
+    except ValueError as exc:
+        raise RecoveryError(EXIT_UNSAFE, f"状态文件损坏 {paths.state_file}: {exc}")
+    if not isinstance(state, dict) or state.get("version") != STATE_VERSION:
+        raise RecoveryError(EXIT_UNSAFE, f"状态文件版本不支持: {state!r:.120}")
+    return state
+
+
+def write_state(paths: Paths, state: dict[str, Any]) -> None:
+    """0600 + fsync + 原子 replace：崩溃后要么旧状态要么新状态。"""
+    ensure_state_dir(paths)
+    state = dict(state)
+    state["version"] = STATE_VERSION
+    state["updated"] = time.time()
+    tmp = paths.state_file.with_name(paths.state_file.name + f".{os.getpid()}.tmp")
+    payload = json.dumps(state, ensure_ascii=False, sort_keys=True)
+    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
+    try:
+        os.write(fd, payload.encode("utf-8"))
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    os.chmod(tmp, 0o600)
+    os.replace(tmp, paths.state_file)
+    dir_fd = os.open(str(paths.state_dir), os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(dir_fd)
+    finally:
+        os.close(dir_fd)
+
+
+def clear_state(paths: Paths) -> None:
+    try:
+        os.unlink(paths.state_file)
+        log(f"已清除接管状态 {paths.state_file}")
+    except FileNotFoundError:
+        pass
+    except OSError as exc:
+        raise RecoveryError(EXIT_FAIL, f"删除状态 {paths.state_file} 失败: {exc}")
+
+
+# ---------------------------------------------------------------- 互斥锁
+
+class TakeoverLock:
+    """flock 独占：supervisor 存活期间一直持有，防止恢复进程抢现场。"""
+
+    def __init__(self, paths: Paths):
+        self.paths = paths
+        self._fd: int | None = None
+
+    def acquire(self, blocking: bool = False, timeout: float = 0.0) -> bool:
+        ensure_state_dir(self.paths)
+        fd = os.open(str(self.paths.lock_file),
+                     os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+        flags = fcntl.LOCK_EX if blocking else fcntl.LOCK_EX | fcntl.LOCK_NB
+        deadline = time.monotonic() + max(timeout, 0.0)
+        while True:
+            try:
+                fcntl.flock(fd, flags)
+                self._fd = fd
+                os.ftruncate(fd, 0)
+                os.write(fd, f"{os.getpid()}\n".encode())
+                return True
+            except OSError as exc:
+                if exc.errno not in (errno.EACCES, errno.EAGAIN):
+                    os.close(fd)
+                    raise RecoveryError(EXIT_FAIL, f"flock {self.paths.lock_file} 失败: {exc}")
+                if not blocking or time.monotonic() >= deadline:
+                    os.close(fd)
+                    return False
+                time.sleep(0.05)
+
+    def release(self) -> None:
+        if self._fd is not None:
+            try:
+                fcntl.flock(self._fd, fcntl.LOCK_UN)
+            finally:
+                os.close(self._fd)
+                self._fd = None
+
+    def __enter__(self) -> "TakeoverLock":
+        if not self.acquire():
+            raise RecoveryError(EXIT_BUSY, f"锁被占用 {self.paths.lock_file}")
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        self.release()
+
+
+# ---------------------------------------------------------------- 子进程清理
+
+def _alive(pid: int | None, starttime: int | None) -> bool:
+    """PID 活着（非僵尸）且 starttime 仍一致 → 是同一个进程。"""
+    if not pid:
+        return False
+    ident = proc_identity(pid)
+    if ident is None:
+        return False
+    if ident.get("state") == "Z":
+        return False
+    if starttime is None:
+        return False
+    return int(ident.get("starttime", -1)) == int(starttime)
+
+
+def kill_leftover_child(recorded: Mapping[str, Any] | None, kill_timeout: float) -> bool:
+    """只杀状态文件里记录过、且 pid+starttime 对得上的我们自己的子进程。"""
+    if not recorded or not recorded.get("pid"):
+        return True
+    pid = int(recorded["pid"])
+    starttime = recorded.get("starttime")
+    if not _alive(pid, starttime):
+        log(f"遗留子进程 {pid} 已不存在（或 starttime 不符，PID 已复用），不处理")
+        return True
+    if not identity_strict(proc_identity(pid), recorded):
+        log(f"遗留子进程 {pid} 身份不一致，拒绝发送信号")
+        return False
+    log(f"终止接管期遗留子进程 pid={pid}")
+    try:
+        os.kill(pid, signal.SIGTERM)
+    except ProcessLookupError:
+        return True
+    except OSError as exc:
+        log(f"向 {pid} 发送 SIGTERM 失败: {exc}")
+        return False
+    deadline = time.monotonic() + kill_timeout
+    while time.monotonic() < deadline:
+        if not _alive(pid, starttime):
+            return True
+        time.sleep(0.05)
+    log(f"子进程 {pid} 未响应 SIGTERM，发送 SIGKILL")
+    try:
+        os.kill(pid, signal.SIGKILL)
+    except ProcessLookupError:
+        return True
+    except OSError as exc:
+        log(f"向 {pid} 发送 SIGKILL 失败: {exc}")
+        return False
+    deadline = time.monotonic() + 5.0
+    while time.monotonic() < deadline:
+        if not _alive(pid, starttime):
+            return True
+        time.sleep(0.05)
+    log(f"子进程 {pid} 在 SIGKILL 后仍存活，放弃")
+    return False
+
+
+# ---------------------------------------------------------------- 恢复核心
+
+def _staged_path(paths: Paths, state: Mapping[str, Any]) -> Path | None:
+    """只接受位于我们自己的 0700 状态目录内的暂存 socket 路径。"""
+    own = state.get("own") or {}
+    raw = own.get("staged") or state.get("staged")
+    if not raw:
+        return None
+    candidate = Path(str(raw))
+    try:
+        real_dir = os.path.realpath(str(paths.state_dir))
+        real_parent = os.path.realpath(str(candidate.parent))
+    except OSError:
+        return None
+    if real_parent != real_dir:
+        log(f"状态里的暂存路径不在 {paths.state_dir} 内，忽略: {candidate}")
+        return None
+    return candidate
+
+
+def _cleanup_staging(paths: Paths, state: Mapping[str, Any]) -> None:
+    """接管尚未落地时清理：遗留子进程 + 暂存 socket。"""
+    child = state.get("child") or {}
+    if not kill_leftover_child(child, paths.kill_timeout):
+        raise RecoveryError(EXIT_UNSAFE, "暂存阶段遗留子进程无法终止，放弃恢复")
+    staged = _staged_path(paths, state)
+    if staged is None:
+        return
+    own = state.get("own") or {}
+    record = own if own.get("ino") else None   # 有 inode 记录就严格比对
+    try:
+        safe_unlink_socket(staged, record, reason="(暂存 socket 清理)")
+    except RecoveryError as exc:
+        log(f"暂存 socket 清理跳过: {exc}")
+
+
+def _record_official(state: Mapping[str, Any]) -> dict[str, Any]:
+    official = state.get("official") or {}
+    if not isinstance(official, dict):
+        raise RecoveryError(EXIT_UNSAFE, "状态文件里的 official 字段非法")
+    return official
+
+
+def _assert_restorable(paths: Paths, official: Mapping[str, Any]) -> None:
+    """真正 rename 前最后一刻的归属复核。"""
+    uf = socket_facts(paths.upstream)
+    if not uf.get("exists"):
+        raise RecoveryError(EXIT_UNSAFE, f"{paths.upstream} 已不存在，无法恢复")
+    if uf.get("is_symlink") or not uf.get("is_socket"):
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"{paths.upstream} 不是普通 socket（symlink={uf.get('is_symlink')}），拒绝恢复")
+    if not inode_of(uf, official):
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"{paths.upstream} inode {uf.get('dev')}:{uf.get('ino')} 与记录的官方 "
+                            f"{official.get('dev')}:{official.get('ino')} 不符")
+    if uf.get("live"):
+        ident = peer_identity(paths.upstream)
+        if not identity_strict(ident, official):
+            raise RecoveryError(EXIT_UNSAFE,
+                                f"{paths.upstream} 的监听者 {ident} 与记录的官方进程不一致")
+    tf = socket_facts(paths.target)
+    if tf.get("exists"):
+        raise RecoveryError(EXIT_UNSAFE, f"{paths.target} 已存在，拒绝覆盖")
+
+
+def _restore_from_upstream(paths: Paths, official: Mapping[str, Any]) -> None:
+    _assert_restorable(paths, official)
+    rename_noreplace(paths.upstream, paths.target)
+    after = socket_facts(paths.target)
+    if not inode_of(after, official):
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"恢复后 {paths.target} inode 校验失败: "
+                            f"{after.get('dev')}:{after.get('ino')}")
+    log(f"已把官方 socket 恢复到 {paths.target}（inode {official.get('dev')}:{official.get('ino')}）")
+
+
+def _recover_locked(paths: Paths, role: str) -> int:
+    ensure_state_dir(paths)
+    check_paths(paths)
+    state = read_state(paths)
+    tf = socket_facts(paths.target)
+    uf = socket_facts(paths.upstream)
+
+    if state is None:
+        if not uf.get("exists"):
+            log("无接管状态、无 upstream socket：无需恢复")
+            return EXIT_OK
+        raise RecoveryError(
+            EXIT_UNSAFE,
+            f"{paths.upstream} 存在但没有接管状态记录，无法证明归属；"
+            "拒绝自动改名/删除（请人工确认后处理）")
+
+    if str(state.get("target")) != str(paths.target) or \
+            str(state.get("upstream")) != str(paths.upstream):
+        raise RecoveryError(EXIT_UNSAFE, "状态记录的路径与当前配置不一致，拒绝恢复")
+
+    official = _record_official(state)
+    own = state.get("own") or {}
+    child = state.get("child") or {}
+    phase = str(state.get("phase") or "unknown")
+    log(f"role={role} phase={phase} target_exists={tf.get('exists')} "
+        f"upstream_exists={uf.get('exists')}")
+
+    # 两个都在? 先看 upstream 是不是我们亲手改名的那个官方 inode。
+    upstream_is_official = inode_of(uf, official)
+
+    if not tf.get("exists") and not uf.get("exists"):
+        log("状态记录存在，但 target/upstream 都不存在（/run 可能已被清空），清理状态")
+        _cleanup_staging(paths, state)
+        clear_state(paths)
+        return EXIT_OK
+
+    if not uf.get("exists"):
+        # 接管从未落地（暂存阶段被打断）：先清掉我们自己的遗留子进程与暂存 socket，
+        # 否则幸存子进程会占着 listen.sock 让下一次启动无法接管。
+        _cleanup_staging(paths, state)
+        tf = socket_facts(paths.target)
+
+    if uf.get("exists") and not uf.get("is_socket"):
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"{paths.upstream} 不是 socket（symlink={uf.get('is_symlink')} "
+                            f"regular={uf.get('is_regular')}），拒绝删除")
+
+    if tf.get("exists") and (tf.get("is_symlink") or not tf.get("is_socket")):
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"{paths.target} 不是普通 socket（symlink={tf.get('is_symlink')} "
+                            f"regular={tf.get('is_regular')}），拒绝操作")
+
+    if uf.get("exists") and upstream_is_official:
+        # 官方 socket 已被我们改名到 upstream：把路径还回去。
+        if uf.get("live") and not identity_strict(peer_identity(paths.upstream), official):
+            raise RecoveryError(EXIT_UNSAFE,
+                                f"{paths.upstream} 的监听者不是记录的官方进程，拒绝恢复")
+
+        if not tf.get("exists"):
+            _restore_from_upstream(paths, official)
+            clear_state(paths)
+            return EXIT_OK
+
+        if inode_of(tf, own):
+            # target 是我们自己的 inode（SIGKILL 后的遗留）。
+            if tf.get("live"):
+                ident = peer_identity(paths.target)
+                if not identity_strict(ident, child):
+                    raise RecoveryError(
+                        EXIT_UNSAFE,
+                        f"{paths.target} 是我们创建的 inode，但监听者 {ident} 不是记录的接管子进程，"
+                        "拒绝删除")
+                if not kill_leftover_child(child, paths.kill_timeout):
+                    raise RecoveryError(EXIT_UNSAFE, "接管子进程无法终止，放弃恢复")
+            tf = socket_facts(paths.target)
+            if tf.get("live"):
+                raise RecoveryError(EXIT_UNSAFE, f"{paths.target} 在清理后仍有监听者，放弃恢复")
+            if not safe_unlink_socket(paths.target, own, reason="(本代理遗留 socket)"):
+                raise RecoveryError(EXIT_UNSAFE, f"删除本代理遗留 socket {paths.target} 失败")
+            _restore_from_upstream(paths, official)
+            clear_state(paths)
+            return EXIT_OK
+
+        if tf.get("live") and is_official(peer_identity(paths.target), paths.official_names):
+            # 官方自己重新绑定到了 target（已自行恢复）；upstream 只是旧的死 inode。
+            if uf.get("live"):
+                raise RecoveryError(
+                    EXIT_UNSAFE, "target 与 upstream 同时存在官方监听者，现场矛盾，拒绝处理")
+            if safe_unlink_socket(paths.upstream, official, reason="(官方已自行重新绑定的旧 inode)"):
+                clear_state(paths)
+                log("官方已自行重新接管 target，已清理陈旧 upstream")
+                return EXIT_OK
+            raise RecoveryError(EXIT_UNSAFE, "无法清理陈旧 upstream socket")
+
+        raise RecoveryError(
+            EXIT_UNSAFE,
+            f"{paths.target} 既不是我们的 inode 也不是官方监听者（inode "
+            f"{tf.get('dev')}:{tf.get('ino')} live={tf.get('live')}），拒绝删除")
+
+    if uf.get("exists") and not upstream_is_official:
+        # upstream 存在但不是记录里的官方 inode：只接受“活着且 exe 身份是官方”的情况。
+        if uf.get("live"):
+            ident = peer_identity(paths.upstream)
+            if ident is None:
+                raise RecoveryError(EXIT_UNSAFE, f"{paths.upstream} 无法读取监听者身份，拒绝处理")
+            if is_official(ident, paths.official_names) and not tf.get("exists"):
+                log(f"upstream inode 与记录不符，但监听者身份是官方 {ident}，仍恢复路径")
+                _assert_restorable(paths, {"dev": uf.get("dev"), "ino": uf.get("ino"),
+                                           "mtime_ns": uf.get("mtime_ns"),
+                                           "pid": ident.get("pid"),
+                                           "starttime": ident.get("starttime")})
+                rename_noreplace(paths.upstream, paths.target)
+                clear_state(paths)
+                return EXIT_OK
+            raise RecoveryError(EXIT_UNSAFE,
+                                f"{paths.upstream} 监听者 {ident} 既非记录官方也非已知身份，拒绝处理")
+        # upstream 是死 socket 且 inode 未知。
+        target_ident = peer_identity(paths.target) if tf.get("live") else None
+        if tf.get("live") and is_official(target_ident, paths.official_names):
+            if safe_unlink_socket(paths.upstream, None, reason="(死 socket, 官方已占 target)"):
+                clear_state(paths)
+                return EXIT_OK
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"{paths.upstream} 是无主死 socket（inode {uf.get('dev')}:{uf.get('ino')}），"
+                            "无法证明归属，拒绝删除")
+
+    # 只剩 target，没有 upstream：接管根本没落地，或回滚已完成。
+    if not tf.get("exists"):
+        clear_state(paths)
+        return EXIT_OK
+    if tf.get("live"):
+        ident = peer_identity(paths.target)
+        if is_official(ident, paths.official_names):
+            log("target 是存活的官方 socket，清理残留状态")
+            clear_state(paths)
+            return EXIT_OK
+        if inode_of(tf, own) and identity_strict(ident, child):
+            if not kill_leftover_child(child, paths.kill_timeout):
+                raise RecoveryError(EXIT_UNSAFE, "接管子进程无法终止，放弃恢复")
+            tf = socket_facts(paths.target)
+            if tf.get("live"):
+                raise RecoveryError(EXIT_UNSAFE, "子进程清理后 socket 仍有监听者")
+            safe_unlink_socket(paths.target, own, reason="(无 upstream 可回滚的本代理 socket)")
+            clear_state(paths)
+            return EXIT_OK
+        raise RecoveryError(EXIT_UNSAFE,
+                            f"{paths.target} 的监听者 {ident} 身份不明，且无 upstream 可回滚")
+    if inode_of(tf, own):
+        safe_unlink_socket(paths.target, own, reason="(无 upstream 可回滚的本代理死 socket)")
+        clear_state(paths)
+        return EXIT_OK
+    raise RecoveryError(EXIT_UNSAFE,
+                        f"{paths.target} 是无主死 socket（inode {tf.get('dev')}:{tf.get('ino')}），"
+                        "且无 upstream，拒绝删除")
+
+
+def recover(paths: Paths, role: str = "manual", lock: TakeoverLock | None = None) -> int:
+    """对外入口：加锁 + 屏蔽停止信号 + 归属校验恢复。返回退出码。"""
+    own_lock = None
+    if lock is None:
+        own_lock = TakeoverLock(paths)
+        if not own_lock.acquire():
+            log(f"另一个进程正持有 {paths.lock_file}，跳过恢复")
+            return EXIT_BUSY
+        lock = own_lock
+    old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGINT})
+    try:
+        return _recover_locked(paths, role)
+    except RecoveryError as exc:
+        log(f"恢复中止（{exc.code}）: {exc}")
+        return exc.code
+    except OSError as exc:
+        log(f"恢复失败: {type(exc).__name__}: {exc}")
+        return EXIT_FAIL
+    finally:
+        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
+        if own_lock is not None:
+            own_lock.release()
+
+
+# ---------------------------------------------------------------- CLI
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(
+        description="fnmedia-ext 接管状态恢复（归属校验，fail-safe）")
+    parser.add_argument("--role", default="manual",
+                        choices=("manual", "pre-start", "exec-stop-post", "shutdown"),
+                        help="调用来源，仅用于日志")
+    args = parser.parse_args(argv)
+    try:
+        paths = paths_from_env()
+        ensure_state_dir(paths)
+    except RecoveryError as exc:
+        log(f"配置错误（{exc.code}）: {exc}")
+        return exc.code
+    return recover(paths, role=args.role)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
