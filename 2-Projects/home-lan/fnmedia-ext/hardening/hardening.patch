--- a/proxy/history.py
+++ b/proxy/history.py
@@ -1,35 +1,49 @@
 #!/usr/bin/env python3
-"""在线播放进度（继续观看）。state/history.json。
+"""在线播放进度（继续观看），每用户隔离。
 
 记录由前端高频 POST /play/record 驱动，内存更新 + 限频落盘；
 GET /play/list 时与官方本地历史合并，让在线条目出现在「继续观看」。
+
+隔离模型
