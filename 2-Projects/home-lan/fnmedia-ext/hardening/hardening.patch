+      fi
+      if [ -e "${UPSTREAM_SOCK}" ] || [ -e "${STATE_DIR}/takeover.json" ]; then
+        log_line "停止后仍存在接管现场（${UPSTREAM_SOCK} 或 ${STATE_DIR}/takeover.json）"
+        [ "${rc}" -eq 0 ] && rc=3
+      fi
+      if [ -e "${TARGET_SOCK}" ] && [ ! -S "${TARGET_SOCK}" ]; then
+        log_line "${TARGET_SOCK} 存在但不是 socket"
