+
+
+# ------------------------------------------------------- 状态只镜像 runner
+@pytest.mark.asyncio
+async def test_status_mirrors_maintenance_runner_state(site):
+    client, box = site
+    queued = (await client.post("/v/api/ext/update/now",
+                                headers=ADMIN_HEADERS, json={"confirm": True})).json()
+    rid = queued["request_id"]
+
+    # 维护 runner 写的真实状态：进行中
+    (box / "update-status.json").write_text(json.dumps({
+        "status": "installing", "message": "正在安装 1.4.8",
+        "request_id": rid, "heartbeat": int(time.time()),
+        "latest_version": "1.4.8", "last_check": int(time.time()) - 60,
+        "next_check": int(time.time()) + 3540, "last_error": ""}))
+    st = (await client.get("/v/api/ext/update/status",
+                           headers=ADMIN_HEADERS)).json()
+    assert st["status"] == "installing"
+    assert st["progress"] == "正在安装 1.4.8"
+    assert st["latest_version"] == "1.4.8"
+    assert st["maintenance_online"] is True
+    assert st["pending"] is False              # request_id 已被 runner 认领
+    assert st["last_error"] == ""
+
+    # 失败：错误原文透出，不能被“成功”覆盖
+    (box / "update-status.json").write_text(json.dumps({
+        "status": "failed", "message": "安装包校验失败",
+        "request_id": rid, "heartbeat": int(time.time()),
+        "latest_version": "1.4.8", "last_check": int(time.time()),
+        "next_check": 0, "last_error": "sha256 mismatch"}))
+    st = (await client.get("/v/api/ext/update/status",
+                           headers=ADMIN_HEADERS)).json()
+    assert st["status"] == "failed"
+    assert st["progress"] == "安装包校验失败"
+    assert st["last_error"] == "sha256 mismatch"
+    assert st["next_check"] == 0
