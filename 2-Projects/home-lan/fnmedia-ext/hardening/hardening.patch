+  if verify_restored; then
+    if [ "$stop_rc" -ne 0 ] || [ "$rec_rc" -ne 0 ]; then
+      warn "停止阶段返回 stop=$stop_rc recover=$rec_rc，但归属校验确认官方 socket 已还原"
+    fi
+    return 0
+  fi
+
+  err "归属校验未通过：官方 socket 未确认还原（stop=$stop_rc recover=$rec_rc）"
+  err "现场已保留，可重跑：sudo bash $ROOT/deploy/uninstall.sh --stop-only"
+  err "排查：ls -l /var/run/trim_media*.sock；journalctl -u $UNIT -n 50 --no-pager"
+  return 3
+}
