+        assert wait_until(lambda: self.box.alive(self.box.target), 10)
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "refused"
+        assert decision.reason == "listener_not_official"
+        assert "exe_basename_not_official" in decision.checks
+
+    def test_changed_tracks_manifest_and_binary_stamps(self):
+        self.box.start_official()
+        guard = self.box.guard()
