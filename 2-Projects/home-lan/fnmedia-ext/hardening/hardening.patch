new file mode 100644
index 0000000..9592092
--- /dev/null
+++ b/proxy/compatibility_runtime.py
@@ -0,0 +1,524 @@
+#!/usr/bin/env python3
+"""官方影视（trim-media）兼容探针运行时：只读公开协议 + 监听者身份。
+
+设计边界
+--------
+* 只对本机 Unix socket 发 **GET**；不发送 Cookie / Authorization / 用户令牌。
+* ``/v/api/v1/sys/config`` 需要公开协议签名，用 ``fnmedia_authx.make_authx``
+  现场生成（不含任何用户凭据）；签名值与密钥常量绝不写日志、不落盘。
+* 只读 ``/proc/<pid>/exe`` 的字节做 SHA-256 和 stat，不读内存 / environ / fd，
+  不执行、不解析官方二进制。
+* 不写官方文件、不改 socket、不碰数据库。
+
+它能证明什么
+------------
+* target/upstream 的监听者是否仍是官方进程，完整 exe 路径是否就是
+  ``compatibility.json`` 里钉住的那个可执行文件；
+* 运行中的二进制摘要是否等于磁盘上的摘要（升级只写了一半时两者会不一致）；
+* 未登录的公开协议面（``sys/version``、``sys/config``）是否仍是
+  ``HTTP 200 + code 0 + 预期 data 字段``，以及 ``user/info`` 是否仍要求登录。
+
+它**不能**证明（不要据此宣称“升级兼容已验”）：
+
+* 登录后的 ``user/info``、``search/item/season/episode/play/stream`` 数据结构；
+* 播放链路、官方数据库 schema、nginx 路由与客户端行为。
+
+因此兼容判定最多只到 ``probation``（试用），见 ``compatibility.py``。
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import socket
+import stat
+import struct
+import sys
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+PROBE_TIMEOUT = 3.0
+MAX_BODY_BYTES = 256 * 1024
+MAX_HEADER_BYTES = 64 * 1024
+DEFAULT_OFFICIAL_NAMES = ("trim-media",)
+
+SYS_VERSION_PATH = "/v/api/v1/sys/version"
+SYS_CONFIG_PATH = "/v/api/v1/sys/config"
+USER_INFO_PATH = "/v/api/v1/user/info"
+
+# 实机只读证据（v0.9.8-1）：
+#   /sys/version  未签名 HTTP200 code0 data{version, mediasrvVersion}
+#   /sys/config   签名   HTTP200 code0 data{initialized, nas_oauth, supported_languages, ...}
+#   /user/info    签名   HTTP200 code -2（无会话）
+#   /sys/options  实际 501，不探测
+REQUIRED_VERSION_KEYS = ("version", "mediasrvVersion")
+REQUIRED_CONFIG_KEYS = ("initialized", "nas_oauth", "supported_languages")
+
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_VERSION_RE = re.compile(r'^\s*version\s*=\s*"?([^"\s]+)"?\s*$')
+_STATUS_RE = re.compile(r"^HTTP/\d(?:\.\d)?\s+(\d{3})(?:\s+(.*))?$")
+
+_MAKE_AUTHX: Any = None
+
+
+class ProbeError(RuntimeError):
+    """探针自身无法完成（不是 socket、超时、响应畸形）。调用方必须 fail-closed。"""
+
+
+# ------------------------------------------------------------------ 文件摘要
+
+def sha256_file(path: str | os.PathLike[str]) -> str | None:
+    """流式摘要；读不到返回 None（调用方必须当作不兼容）。"""
+    digest = hashlib.sha256()
+    try:
+        with open(path, "rb") as stream:
+            for chunk in iter(lambda: stream.read(1 << 20), b""):
+                digest.update(chunk)
+    except OSError:
+        return None
+    return digest.hexdigest()
+
+
+def file_stamp(path: str | os.PathLike[str]) -> tuple[int, int, int, int, int] | None:
+    try:
+        st = os.stat(path)
+    except OSError:
+        return None
+    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+
+
+def manifest_version(path: str | os.PathLike[str] | None) -> str | None:
+    """读 manifest 的 version=（只读、限长）。"""
+    if not path:
+        return None
+    try:
+        raw = Path(path).read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return None
+    for line in raw.splitlines():
+        match = _VERSION_RE.match(line)
+        if match:
+            return match.group(1)
+    return None
+
+
+def valid_sha256(value: Any) -> str | None:
+    if isinstance(value, str) and _SHA256_RE.match(value.strip().lower()):
+        return value.strip().lower()
+    return None
+
+
+# ------------------------------------------------------------------ 监听者身份
+
+@dataclass(frozen=True)
+class Identity:
+    """target/upstream 上正在监听的进程事实。problems 为空才代表官方。"""
+
+    socket: str
+    pid: int | None
+    starttime: int | None
+    exe: str | None
+    expected_exe: str | None
+    running_sha256: str | None
+    disk_sha256: str | None
+    same_inode: bool
+    problems: tuple[str, ...]
+
+    @property
+    def is_official(self) -> bool:
+        return not self.problems
+
+    def brief(self) -> str:
+        return (f"pid={self.pid} exe={self.exe} sha={self.running_sha256} "
+                f"problems={'|'.join(self.problems) or 'none'}")
+
+
+def _proc_starttime(pid: int) -> int | None:
+    try:
+        with open(f"/proc/{int(pid)}/stat", "rb") as stream:
+            raw = stream.read()
+    except OSError:
+        return None
+    rparen = raw.rfind(b")")
+    if rparen < 0:
+        return None
+    fields = raw[rparen + 2:].split()
+    if len(fields) < 20:
+        return None
+    try:
+        return int(fields[19])
+    except ValueError:
+        return None
+
+
+def _proc_exe(pid: int) -> str | None:
+    try:
+        return os.readlink(f"/proc/{int(pid)}/exe")
+    except OSError:
+        return None
+
+
+def _peer_pid(path: str | os.PathLike[str], timeout: float) -> int | None:
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(max(timeout, 0.05))
+    try:
+        sock.connect(str(path))
+    except OSError:
+        sock.close()
+        return None
+    try:
+        raw = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
+        return struct.unpack("3i", raw)[0] or None
+    except OSError:
+        return None
+    finally:
+        sock.close()
+
+
+def identify(socket_path: str | os.PathLike[str], *,
+             expected_exe: str | None,
+             official_names: Sequence[str] = DEFAULT_OFFICIAL_NAMES,
+             timeout: float = 1.0) -> Identity:
+    """按 /proc 事实核对 socket 的监听者。任何不确定都写进 problems。"""
+    name = str(socket_path)
+    problems: list[str] = []
+    try:
+        st = os.lstat(name)
+    except OSError:
+        return Identity(name, None, None, None, expected_exe, None, None, False,
+                        ("socket_missing",))
+    if stat.S_ISLNK(st.st_mode):
+        return Identity(name, None, None, None, expected_exe, None, None, False,
+                        ("socket_symlink",))
+    if not stat.S_ISSOCK(st.st_mode):
+        return Identity(name, None, None, None, expected_exe, None, None, False,
+                        ("socket_not_socket",))
+
+    pid = _peer_pid(name, timeout)
+    if pid is None:
+        return Identity(name, None, None, None, expected_exe, None, None, False,
+                        ("no_listener",))
+    starttime = _proc_starttime(pid)
+    if starttime is None:
+        problems.append("proc_starttime_unreadable")
+
+    raw_exe = _proc_exe(pid)
+    running = disk = None
+    same_inode = False
+    if not raw_exe:
+        problems.append("proc_exe_unreadable")
+    else:
+        deleted = raw_exe.endswith(" (deleted)")
+        exe = raw_exe[:-len(" (deleted)")] if deleted else raw_exe
+        names = {str(item).strip().lower() for item in official_names if str(item).strip()}
+        if os.path.basename(exe).lower() not in names:
+            problems.append("exe_basename_not_official")
+        if deleted:
+            problems.append("running_binary_deleted")
+        if expected_exe:
+            try:
+                if os.path.realpath(exe) != os.path.realpath(expected_exe):
+                    problems.append("exe_path_mismatch")
+            except OSError:
+                problems.append("exe_path_unresolvable")
+        running = sha256_file(f"/proc/{pid}/exe")
+        if running is None:
+            problems.append("running_sha_unreadable")
+        if expected_exe:
+            disk = sha256_file(expected_exe)
+            if disk is None:
+                problems.append("disk_sha_unreadable")
+            try:
+                a = os.stat(f"/proc/{pid}/exe")
+                b = os.stat(expected_exe)
+                same_inode = (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)
+            except OSError:
+                same_inode = False
+            if not same_inode:
+                problems.append("running_binary_not_on_disk")
+    return Identity(name, pid, starttime, raw_exe, expected_exe, running, disk,
+                    same_inode, tuple(problems))
+
+
+# ------------------------------------------------------------------ HTTP over UDS
+
+@dataclass(frozen=True)
+class Response:
+    status: int
+    reason: str
+    headers: Mapping[str, str]
+    body: bytes
+    truncated: bool = False
+
+
+def _dechunk(raw: bytes) -> tuple[bytes, bool]:
+    out = bytearray()
+    index = 0
+    while True:
+        line_end = raw.find(b"\r\n", index)
+        if line_end < 0:
+            return bytes(out), False
+        try:
+            size = int(raw[index:line_end].split(b";", 1)[0], 16)
+        except ValueError:
+            return bytes(out), False
+        index = line_end + 2
+        if size == 0:
+            return bytes(out), True
+        if len(raw) < index + size + 2:
+            return bytes(out), False
+        out += raw[index:index + size]
+        index += size + 2
+
+
+def _read_response(sock: socket.socket, deadline: float, max_body: int) -> Response:
+    buf = bytearray()
+    head_end = -1
+    while head_end < 0:
+        head_end = buf.find(b"\r\n\r\n")
+        if head_end >= 0:
+            break
+        if len(buf) > MAX_HEADER_BYTES:
+            raise ProbeError("headers_too_large")
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise ProbeError("timeout_headers")
+        sock.settimeout(remaining)
+        try:
+            chunk = sock.recv(16384)
+        except socket.timeout as exc:
+            raise ProbeError("timeout_headers") from exc
+        if not chunk:
+            raise ProbeError("no_response")
+        buf += chunk
+
+    head_lines = bytes(buf[:head_end]).decode("latin1", "replace").split("\r\n")
+    match = _STATUS_RE.match(head_lines[0])
+    if not match:
+        raise ProbeError("bad_status_line")
+    status = int(match.group(1))
+    reason = (match.group(2) or "").strip()
+    headers: dict[str, str] = {}
+    for line in head_lines[1:]:
+        if ":" in line:
+            key, value = line.split(":", 1)
+            headers[key.strip().lower()] = value.strip()
+
+    body = bytearray(buf[head_end + 4:])
+    chunked = "chunked" in headers.get("transfer-encoding", "").lower()
+    declared = -1
+    if not chunked and headers.get("content-length"):
+        try:
+            declared = max(int(headers["content-length"]), 0)
+        except ValueError:
+            declared = -1
+
+    truncated = False
+    if chunked:
+        while True:
+            decoded, done = _dechunk(bytes(body))
+            if done:
+                body = bytearray(decoded)
+                break
+            if len(body) >= max_body + 65536:
+                body = bytearray(decoded[:max_body])
+                truncated = True
+                break
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                body = bytearray(decoded[:max_body])
+                truncated = True
+                break
+            sock.settimeout(remaining)
+            try:
+                chunk = sock.recv(16384)
+            except socket.timeout:
+                body = bytearray(decoded[:max_body])
+                truncated = True
+                break
+            if not chunk:
+                body = bytearray(decoded)
+                break
+            body += chunk
+    else:
+        target = max_body if declared < 0 else min(declared, max_body)
+        while len(body) < target:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise ProbeError("timeout_body")
+            sock.settimeout(remaining)
+            try:
+                chunk = sock.recv(16384)
+            except socket.timeout as exc:
+                if declared < 0:
+                    break
+                raise ProbeError("timeout_body") from exc
+            if not chunk:
+                break
+            body += chunk
+        if declared > max_body:
+            truncated = True
+
+    if len(body) > max_body:
+        body = bytearray(body[:max_body])
+        truncated = True
+    return Response(status, reason, headers, bytes(body), truncated)
+
+
+def get(socket_path: str | os.PathLike[str], request_path: str, *,
+        headers: Mapping[str, str] | None = None,
+        timeout: float = PROBE_TIMEOUT,
+        max_body: int = MAX_BODY_BYTES) -> Response:
+    """对 Unix socket 发一个只读 GET。"""
+    if (not isinstance(request_path, str) or not request_path.startswith("/")
+            or "://" in request_path
+            or any(ch in request_path for ch in "\r\n\0")):
+        raise ProbeError("bad_request_path")
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(max(timeout, 0.05))
+    try:
+        sock.connect(str(socket_path))
+    except OSError as exc:
+        sock.close()
+        raise ProbeError(f"connect_failed: {exc}") from exc
+
+    # 与官方前端/http.client 一致用 HTTP/1.1，但要求 Connection: close，
+    # 这样响应体读法简单，也不会留下 keep-alive 连接。
+    lines = [f"GET {request_path} HTTP/1.1",
+             "Host: localhost",
+             "Connection: close",
+             "Accept: application/json",
+             "Accept-Encoding: identity",
+             "User-Agent: fnmedia-ext-compat"]
+    for key, value in (headers or {}).items():
+        lines.append(f"{key}: {value}")
+    request = ("\r\n".join(lines) + "\r\n\r\n").encode("latin1")
+    try:
+        sock.sendall(request)
+        return _read_response(sock, time.monotonic() + max(timeout, 0.05), max_body)
+    finally:
+        try:
+            sock.close()
+        except OSError:
+            pass
+
+
+# ------------------------------------------------------------------ 公开协议
+
+@dataclass(frozen=True)
+class Envelope:
+    parsed: bool
+    code: int | None
+    data: Mapping[str, Any] | None
+
+
+def parse_envelope(body: bytes) -> Envelope:
+    try:
+        payload = json.loads(body.decode("utf-8", "replace"))
+    except (ValueError, UnicodeDecodeError):
+        return Envelope(False, None, None)
+    if not isinstance(payload, dict):
+        return Envelope(False, None, None)
+    code = payload.get("code")
+    data = payload.get("data")
+    return Envelope(True, code if type(code) is int else None,
+                    data if isinstance(data, dict) else None)
+
+
+def _authx(path: str) -> str:
+    """公开协议签名头（无用户令牌）。调用方绝不记录返回值。"""
+    global _MAKE_AUTHX
+    if _MAKE_AUTHX is None:
+        try:
+            from fnmedia_authx import make_authx
+        except ImportError:  # 以脚本方式运行时补齐同目录
+            sys.path.insert(0, str(Path(__file__).resolve().parent))
+            from fnmedia_authx import make_authx
+        _MAKE_AUTHX = make_authx
+    return _MAKE_AUTHX("GET", path)[0]
+
+
+@dataclass(frozen=True)
+class Contract:
+    ok: bool
+    reasons: tuple[str, ...]
+    sys_version: str | None = None
+    mediasrv_version: str | None = None
+    user_code: int | None = None
+
+
+def _nonempty_str(value: Any) -> bool:
+    return isinstance(value, str) and bool(value.strip())
+
+
+def public_contract(socket_path: str | os.PathLike[str], *,
+                    timeout: float = PROBE_TIMEOUT) -> Contract:
+    """只读核对公开协议面。ok=True 只代表“公开协议没变”，不代表登录态兼容。"""
+    reasons: list[str] = []
+    sys_version = mediasrv_version = None
+
+    try:
+        response = get(socket_path, SYS_VERSION_PATH, timeout=timeout)
+    except ProbeError as exc:
+        return Contract(False, (f"sys_version:{exc}",))
+    if response.status != 200:
+        reasons.append(f"sys_version_http_{response.status}")
+    envelope = parse_envelope(response.body)
+    if not envelope.parsed:
+        reasons.append("sys_version_not_json")
+    if envelope.code != 0:
+        reasons.append("sys_version_code")
+    data = envelope.data or {}
+    for key in REQUIRED_VERSION_KEYS:
+        if not _nonempty_str(data.get(key)):
+            reasons.append(f"sys_version_missing_{key}")
+    if _nonempty_str(data.get("version")):
+        sys_version = str(data["version"])
+    if _nonempty_str(data.get("mediasrvVersion")):
+        mediasrv_version = str(data["mediasrvVersion"])
+    if reasons:
+        return Contract(False, tuple(reasons), sys_version, mediasrv_version)
+
+    try:
+        response = get(socket_path, SYS_CONFIG_PATH,
+                       headers={"authx": _authx(SYS_CONFIG_PATH)}, timeout=timeout)
+    except ProbeError as exc:
+        return Contract(False, tuple(reasons) + (f"sys_config:{exc}",),
+                        sys_version, mediasrv_version)
+    if response.status != 200:
+        reasons.append(f"sys_config_http_{response.status}")
+    envelope = parse_envelope(response.body)
+    if not envelope.parsed:
+        reasons.append("sys_config_not_json")
+    if envelope.code != 0:
+        reasons.append("sys_config_code")
+    config = envelope.data or {}
+    for key in REQUIRED_CONFIG_KEYS:
+        if key not in config:
+            reasons.append(f"sys_config_missing_{key}")
+    if reasons:
+        return Contract(False, tuple(reasons), sys_version, mediasrv_version)
+
+    user_code = None
+    try:
+        response = get(socket_path, USER_INFO_PATH,
+                       headers={"authx": _authx(USER_INFO_PATH)}, timeout=timeout)
+    except ProbeError as exc:
+        return Contract(False, tuple(reasons) + (f"user_info:{exc}",),
+                        sys_version, mediasrv_version)
+    if response.status != 200:
+        reasons.append(f"user_info_http_{response.status}")
+    envelope = parse_envelope(response.body)
+    user_code = envelope.code
+    if not envelope.parsed:
+        reasons.append("user_info_not_json")
+    elif envelope.code == 0:
+        # 匿名能拿到用户信息说明鉴权/协议已变，必须拒绝自动接管。
+        reasons.append("user_info_anonymous_accepted")
+    elif envelope.code is None:
+        reasons.append("user_info_code_missing")
+
+    return Contract(not reasons, tuple(reasons), sys_version, mediasrv_version, user_code)
