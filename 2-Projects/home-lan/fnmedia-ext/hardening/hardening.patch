+#!/usr/bin/env python3
+"""per-user 隔离回归：history / marks / user_scope。
+
+只验证隔离与失败关闭语义；**不**替代/断言上层 NAS 会话认证。
+运行：/tmp/fnmedia-ext-review-20261028/venv/bin/python -m unittest discover -s tests -v
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import stat
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "proxy"))
+
+import history as histmod          # noqa: E402
+import marks as marksmod          # noqa: E402
+import user_scope                 # noqa: E402
+from history import History        # noqa: E402
+from marks import Marks            # noqa: E402
+from user_scope import MissingUserScope, current_user_id  # noqa: E402
+
+ALICE = "alice@nas"
+BOB = "bob@nas"
