+class StateDirTest(unittest.TestCase):
+    """每个用例独立 state 根，互不污染。"""
+
+    def setUp(self):
+        self.root = Path(tempfile.mkdtemp(prefix="fnmedia-scope-"))
+        os.environ[user_scope.STATE_ENV] = str(self.root)
+        # 防御：上一个用例若异常退出，清掉残留身份
+        user_scope._current_user.set(None)
+        histmod.history.reset_cache()
+        marksmod.marks.reset_cache()
+
+    def tearDown(self):
+        user_scope._current_user.set(None)
+        histmod.history.reset_cache()
+        marksmod.marks.reset_cache()
+        os.environ.pop(user_scope.STATE_ENV, None)
+        shutil.rmtree(self.root, ignore_errors=True)
+
+    def state_files(self):
+        return sorted(p for p in self.root.rglob("*") if p.is_file())
+
+
+class UserScopeApiTest(StateDirTest):
+    def test_bind_reset_nesting(self):
+        self.assertIsNone(current_user_id())
+        t1 = user_scope.bind_user(ALICE)
+        self.assertEqual(current_user_id(), ALICE)
+        t2 = user_scope.bind_user(BOB)
+        self.assertEqual(current_user_id(), BOB)
+        user_scope.reset_user(t2)
+        self.assertEqual(current_user_id(), ALICE)
+        user_scope.reset_user(t1)
+        self.assertIsNone(current_user_id())
+
+    def test_context_manager_resets_on_exit(self):
+        with user_scope.user_scope(ALICE) as uid:
+            self.assertEqual(uid, ALICE)
+            self.assertEqual(current_user_id(), ALICE)
+        self.assertIsNone(current_user_id())
+
+    def test_invalid_ids_rejected_and_do_not_bind(self):
+        for bad in ("", "  ", " padded", "tab\there", "nul\x00byte", 123, None,
+                    "x" * 257):
+            with self.assertRaises(ValueError, msg=repr(bad)):
+                user_scope.bind_user(bad)
+            self.assertIsNone(current_user_id())
+
+    def test_require_user_id_raises_without_identity(self):
+        with self.assertRaises(MissingUserScope):
+            user_scope.require_user_id()
+        with user_scope.user_scope(ALICE):
+            self.assertEqual(user_scope.require_user_id(), ALICE)
+
+    def test_user_path_is_hashed_and_private(self):
+        with user_scope.user_scope(ALICE):
+            path = user_scope.user_state_path(ALICE, "history.json")
+        digest = hashlib.sha256(ALICE.encode()).hexdigest()
+        self.assertEqual(path.parent.name, digest)
+        self.assertNotIn("alice", str(path).lower())
+        self.assertEqual(stat.S_IMODE(path.parent.stat().st_mode), 0o700)
+        self.assertEqual(stat.S_IMODE(path.parent.parent.stat().st_mode), 0o700)
+
+    def test_alias_api_matches_primary(self):
+        self.assertIs(user_scope.bind, user_scope.bind_user)
+        self.assertIs(user_scope.reset, user_scope.reset_user)
+        self.assertIs(user_scope.current_user, user_scope.current_user_id)
+        self.assertIs(user_scope.scoped_user, user_scope.user_scope)
+        token = user_scope.bind(ALICE)
+        self.assertEqual(user_scope.current_user(), ALICE)
+        user_scope.reset(token)
+        self.assertIsNone(user_scope.current_user())
+
+    def test_asyncio_tasks_do_not_share_identity(self):
+        import asyncio
+
+        async def handle(uid: str, own: str, other: str,
+                         ready: asyncio.Event, go: asyncio.Event):
+            token = user_scope.bind_user(uid)
+            try:
+                ready.set()
+                await go.wait()
+                histmod.history.record({"item_guid": own, "ts": 1})
+                await asyncio.sleep(0)
+                assert histmod.history.get(other) is None
+                assert {r["item_guid"] for r in histmod.history.all()} == {own}
+            finally:
+                user_scope.reset_user(token)
+
+        async def main():
+            r1, r2 = asyncio.Event(), asyncio.Event()
+            go = asyncio.Event()
+            t1 = asyncio.create_task(handle(ALICE, "ga", "gb", r1, go))
+            t2 = asyncio.create_task(handle(BOB, "gb", "ga", r2, go))
+            await r1.wait()
+            await r2.wait()
+            go.set()
+            await asyncio.gather(t1, t2)
+
+        asyncio.run(main())
+        self.assertIsNone(current_user_id())
+        with user_scope.user_scope(ALICE):
+            self.assertEqual({r["item_guid"] for r in histmod.history.all()},
+                             {"ga"})
+        with user_scope.user_scope(BOB):
+            self.assertEqual({r["item_guid"] for r in histmod.history.all()},
+                             {"gb"})
+
+    def test_scope_is_not_set_by_default(self):
+        self.assertIsNone(current_user_id())
+        self.assertEqual(histmod.history.all(), [])
+
