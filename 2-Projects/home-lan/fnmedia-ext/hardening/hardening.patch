+#!/usr/bin/env python3
+"""proxy/safe_http.py 的端到端测试（无外网依赖）。
+
+覆盖点：
+  * 私网/环回/链路本地/组播/保留/未指定/IPv4 映射/怪数字写法 全部拦截；
+  * DNS 返回多条答案时**必须全部**合格，混合私网即整体拒绝；
+  * DNS rebinding：解析一次 → 校验 → 只拨校验过的 IP，二次解析不参与连接；
+  * 重定向逐跳校验（跟随与不跟随都拦），非法 Location 不会产生第二跳请求；
+  * build_request + send(stream=True) + aiter_raw 流式语义不变；
+  * TLS：拨号目标是公网 IP 占位，SNI/证书校验仍用原始域名；错域名必须失败；
+  * verify=False / CERT_NONE / trust_env / proxy / mounts / 自定义 transport 全部拒绝；
+  * 环境变量代理不得生效；UDS 出站一律拒绝；
+  * 同步客户端同源同规则。
+
+本地 fixture 通过“注入 resolver + 注入 dialer”接入：resolver 声明一个公网 IP，
+dialer 实际连 127.0.0.1 的 fixture 端口，并把收到的（已校验）IP 记录下来断言。
+生产工厂函数不暴露这两个参数，模块内也没有任何放行本机的开关/环境变量。
+
+运行方式（无 pytest 也可）：
+    python3 tests/test_safe_http.py
+"""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import http.server
+import os
+import shutil
+import ssl
+import subprocess
+import sys
+import tempfile
+import threading
+import typing
+
+import httpcore
+import httpx
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+PROXY_DIR = os.path.join(os.path.dirname(HERE), "proxy")
+if PROXY_DIR not in sys.path:
+    sys.path.insert(0, PROXY_DIR)
+
+import safe_http  # noqa: E402
+
+# 仅作为“公网单播”占位地址参与策略校验；dialer 不会真的连它。
+PUBLIC_IP = "93.184.216.34"
+PUBLIC_IP6 = "2606:4700:4700::1111"
+BIG_SIZE = 1024 * 1024
+
+
+class SkipTest(Exception):
+    pass
+
+
+@contextlib.contextmanager
+def _raises(exc_type: type[BaseException]):
+    try:
+        yield
+    except exc_type:
+        return
+    except BaseException as other:  # noqa: BLE001
+        raise AssertionError(f"expected {exc_type.__name__}, got {type(other).__name__}: {other}")
+    raise AssertionError(f"expected {exc_type.__name__}, nothing raised")
+
+
+@contextlib.contextmanager
+def _env(values: dict[str, str]):
+    old = {k: os.environ.get(k) for k in values}
+    os.environ.update(values)
+    try:
+        yield
+    finally:
+        for k, v in old.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+# ------------------------------------------------------------- 本地 fixture
+
+
+CERT_DIR: str | None = None
+CERT_FILE = ""
+KEY_FILE = ""
+
+
+def _ensure_cert() -> None:
+    """自签证书（CN/SAN = public.test），供 TLS 断言使用。"""
+    global CERT_DIR, CERT_FILE, KEY_FILE
+    if CERT_DIR is not None:
+        return
+    if not shutil.which("openssl"):
+        raise SkipTest("openssl CLI not available")
+    CERT_DIR = tempfile.mkdtemp(prefix="safe-http-cert-")
+    CERT_FILE = os.path.join(CERT_DIR, "cert.pem")
+    KEY_FILE = os.path.join(CERT_DIR, "key.pem")
+    subprocess.run(
+        ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
+         "-keyout", KEY_FILE, "-out", CERT_FILE, "-days", "2",
+         "-subj", "/CN=public.test",
+         "-addext", "subjectAltName=DNS:public.test",
+         "-addext", "basicConstraints=critical,CA:TRUE"],
+        check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+
+class _Handler(http.server.BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+    fixture: "_Fixture"
+
+    def log_message(self, *args: typing.Any) -> None:  # noqa: D401
+        pass
+
+    def do_GET(self) -> None:  # noqa: N802
+        fx = self.fixture
+        fx.requests.append(self.path)
+        fx.hosts.append(self.headers.get("Host", ""))
+
+        if self.path.startswith("/redir-private"):
+            self.send_response(302)
+            self.send_header("Location", "http://127.0.0.1:1/nope")
+            self.send_header("Content-Length", "0")
+            self.end_headers()
+            return
+        if self.path.startswith("/redir-ok"):
+            self.send_response(302)
+            self.send_header("Location", "/ok")
+            self.send_header("Content-Length", "0")
+            self.end_headers()
+            return
+
+        body = b"x" * BIG_SIZE if self.path.startswith("/big") else b"hello"
+        self.send_response(200)
+        self.send_header("Content-Type", "text/plain")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+
+class _Fixture:
+    def __init__(self, *, tls: bool = False) -> None:
+        self.requests: list[str] = []
+        self.hosts: list[str] = []
+        self.sni: list[str | None] = []
+        handler = type("_BoundHandler", (_Handler,), {"fixture": self})
+        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
+        self.server.daemon_threads = True
+        if tls:
+            _ensure_cert()
+            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+            ctx.load_cert_chain(CERT_FILE, KEY_FILE)
+            ctx.set_servername_callback(
+                lambda _obj, name, _ctx: self.sni.append(name))
+            self.server.socket = ctx.wrap_socket(self.server.socket,
+                                                 server_side=True)
+        self.port: int = self.server.server_address[1]
+        self._thread = threading.Thread(target=self.server.serve_forever,
+                                        daemon=True)
+        self._thread.start()
+
+    def __enter__(self) -> "_Fixture":
+        return self
+
+    def __exit__(self, *exc: typing.Any) -> None:
+        self.server.shutdown()
+        self.server.server_close()
+        self._thread.join(timeout=5)
+
+
+# ------------------------------------------------------- 注入 resolver/dialer
+
+
+def _async_dialer(target_port: int, seen: list[tuple[str, int]],
+                  calls: list[tuple[str, int]] | None = None):
+    async def dial(host: str, port: int, *, timeout: typing.Any = None,
+                   local_address: typing.Any = None,
+                   socket_options: typing.Any = None):
+        seen.append((host, port))
+        if calls is not None:
+            calls.append((host, port))
+        backend = typing.cast(typing.Any, httpcore.AnyIOBackend())
+        return await backend.connect_tcp("127.0.0.1", target_port,
+                                         timeout=timeout,
+                                         local_address=local_address,
+                                         socket_options=socket_options)
+    return dial
+
+
+def _sync_dialer(target_port: int, seen: list[tuple[str, int]]):
+    def dial(host: str, port: int, *, timeout: typing.Any = None,
+             local_address: typing.Any = None,
+             socket_options: typing.Any = None):
+        seen.append((host, port))
+        backend = typing.cast(typing.Any, httpcore.SyncBackend())
+        return backend.connect_tcp("127.0.0.1", target_port, timeout=timeout,
+                                   local_address=local_address,
+                                   socket_options=socket_options)
+    return dial
+
+
+def _counted_resolver(answers: typing.Any, calls: list[tuple[str, int]]):
+    def resolve(host: str, port: int) -> list[str]:
+        calls.append((host, port))
+        if callable(answers):
+            return list(answers(host, port))
+        return list(answers)
+    return resolve
+
+
+def _async_client(fx: _Fixture, *, answers: typing.Any = (PUBLIC_IP,),
+                  seen: list[tuple[str, int]] | None = None,
+                  calls: list[tuple[str, int]] | None = None,
+                  verify: typing.Any = True,
+                  follow_redirects: bool = True) -> safe_http.SafeAsyncClient:
+    seen = [] if seen is None else seen
+    calls = [] if calls is None else calls
+    backend = safe_http.GuardedNetworkBackend(
+        resolver=_counted_resolver(answers, calls),
+        dialer=_async_dialer(fx.port, seen))
+    return safe_http.SafeAsyncClient(verify=verify,
+                                     follow_redirects=follow_redirects,
+                                     network_backend=backend)
+
+
+def _sync_client(fx: _Fixture, *, answers: typing.Any = (PUBLIC_IP,),
+                 seen: list[tuple[str, int]] | None = None) -> safe_http.SafeClient:
+    seen = [] if seen is None else seen
+    backend = safe_http.GuardedSyncNetworkBackend(
+        resolver=_counted_resolver(answers, []),
+        dialer=_sync_dialer(fx.port, seen))
+    return safe_http.SafeClient(network_backend=backend)
+
+
+# -------------------------------------------------------------------- 用例
+
+
+def test_blocks_private_loopback_and_odd_hosts() -> None:
