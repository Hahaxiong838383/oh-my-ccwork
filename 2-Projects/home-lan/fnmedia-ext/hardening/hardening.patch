+    with _raises(safe_http.SSRFConfigError):
+        safe_http.SafeHTTPTransport(verify=False)
+
+    insecure_ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+    insecure_ctx.check_hostname = False
+    insecure_ctx.verify_mode = ssl.CERT_NONE
+    with _raises(safe_http.SSRFConfigError):
+        safe_http.async_client(verify=insecure_ctx)
+    with _raises(safe_http.SSRFConfigError):
+        safe_http.SafeHTTPTransport(verify=insecure_ctx)
+
+    # 不可覆盖的接线参数：传了就报错，避免无意中绕过护栏。
+    with _raises(TypeError):
+        safe_http.SafeAsyncClient(trust_env=True)
+    with _raises(TypeError):
+        safe_http.SafeClient(trust_env=True)
+    with _raises(TypeError):
+        safe_http.async_client(proxy="http://127.0.0.1:1")
+    with _raises(TypeError):
+        safe_http.async_client(mounts={})
+    with _raises(TypeError):
+        safe_http.async_client(transport=httpx.AsyncHTTPTransport(uds="/tmp/x.sock"))
+    with _raises(TypeError):
+        safe_http.async_client(resolver=lambda h, p: [PUBLIC_IP])
+    with _raises(TypeError):
