+  err "卸载中止：未确认官方 socket 还原，单元与现场均未删除（rc=$rc）"
+  exit "$rc"
+fi
+
+if unit_present; then
+  systemctl disable "$UNIT" || warn "systemctl disable $UNIT 失败（单元文件仍会被删除）"
+fi
+if [ -e "$UNIT_FILE" ]; then
+  rm -f "$UNIT_FILE" || { err "无法删除 $UNIT_FILE"; exit 1; }
+fi
