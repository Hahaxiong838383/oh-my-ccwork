+class LegacyQuarantineTest(StateDirTest):
+    def _write_legacy(self):
+        self.root.mkdir(parents=True, exist_ok=True)
+        (self.root / "history.json").write_text(json.dumps(
+            {"records": {"legacy-guid": {"item_guid": "legacy-guid",
+                                         "ts": 500, "duration": 600}}}),
+            encoding="utf-8")
+        (self.root / "marks.json").write_text(json.dumps(
+            {"favorites": {"legacy-guid": {"guid": "legacy-guid", "ts": 1}},
+             "watched": {}}), encoding="utf-8")
+
+    def test_legacy_state_is_quarantined_and_never_assigned(self):
+        self._write_legacy()
+
+        with user_scope.user_scope(ALICE):
+            self.assertEqual(histmod.history.all(), [])
+            self.assertEqual(marksmod.marks.favorite_guids(), set())
+            self.assertIsNone(histmod.history.get("legacy-guid"))
+            # 新用户文件里不能出现旧共享数据
+            for f in (user_scope.user_dir(ALICE, create=True) /
+                      "history.json", user_scope.user_dir(ALICE, create=True) /
+                      "marks.json"):
+                if f.exists():
+                    self.assertNotIn("legacy-guid", f.read_text("utf-8"))
+
+        qdir = self.root / "legacy-quarantine"
+        quarantined = sorted(qdir.glob("*.json"))
+        self.assertEqual(len(quarantined), 2)
+        self.assertFalse((self.root / "history.json").exists())
+        self.assertFalse((self.root / "marks.json").exists())
+        self.assertEqual(stat.S_IMODE(qdir.stat().st_mode), 0o700)
+        blobs = "".join(p.read_text("utf-8") for p in quarantined)
+        self.assertIn("legacy-guid", blobs)            # 原样留档，人工处置
+        for p in quarantined:
+            self.assertEqual(stat.S_IMODE(p.stat().st_mode), 0o600)
+
+        # 第二个用户同样看不到，也不会再次搬动旧文件
+        with user_scope.user_scope(BOB):
+            self.assertEqual(histmod.history.all(), [])
+            self.assertEqual(marksmod.marks.favorite_guids(), set())
+        self.assertEqual(len(list(qdir.glob("*.json"))), 2)
