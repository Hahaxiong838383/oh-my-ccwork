+class ConcurrencyTest(StateDirTest):
+    def test_threads_keep_their_own_identity(self):
+        barrier = threading.Barrier(2)
+        errors: list[BaseException] = []
+
+        def worker(uid: str, guid: str):
+            try:
+                with user_scope.user_scope(uid):
+                    barrier.wait(timeout=5)
+                    histmod.history.record(
+                        {"item_guid": guid, "ts": 5, "duration": 10})
+                    marksmod.marks.add_favorite(guid)
+                    seen = {r["item_guid"] for r in histmod.history.all()}
+                    assert seen == {guid}, f"{uid} saw {seen}"
+            except BaseException as exc:      # noqa: BLE001 - 收集给主线程断言
+                errors.append(exc)
+
+        threads = [threading.Thread(target=worker, args=(ALICE, "g-a")),
+                   threading.Thread(target=worker, args=(BOB, "g-b"))]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(timeout=10)
+        self.assertEqual(errors, [])
+
+        with user_scope.user_scope(ALICE):
+            self.assertEqual({r["item_guid"] for r in histmod.history.all()},
+                             {"g-a"})
+            self.assertEqual(marksmod.marks.favorite_guids(), {"g-a"})
+        with user_scope.user_scope(BOB):
+            self.assertEqual({r["item_guid"] for r in histmod.history.all()},
+                             {"g-b"})
+            self.assertEqual(marksmod.marks.favorite_guids(), {"g-b"})
+
