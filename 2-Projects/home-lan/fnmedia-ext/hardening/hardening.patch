+
+    def test_chart_failure_keeps_old_lists_and_records_error(self):
+        """榜单上游失败：旧榜保留，错误与退避落盘。"""
+        good = {"updated_at": int(time.time()), "provider_ok": 2,
+                "provider_total": 2, "charts": {
+                    c: [{"guid": f"g-{c}-{i}", "title": f"{c}{i}", "cat": c}
