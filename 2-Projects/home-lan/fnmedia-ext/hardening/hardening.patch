+        sup = self.start_supervisor(child_mode="ignore-term")
+        self.wait_takeover(sup)
+        child = self.child_pid()
+        os.kill(sup.pid, signal.SIGKILL)
+        sup.wait(timeout=10)
+        time.sleep(0.5)
+        self.assertTrue(pid_alive(child), "前置条件：遗留子进程必须存活")
+
+        state = self.state()
+        state["child"] = {"pid": child, "starttime": 1}   # 与真实 starttime 不符
+        self.state_file.write_text(json.dumps(state), encoding="utf-8")
