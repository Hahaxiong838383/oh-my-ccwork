+class TestSupervisorReconnect:
+    def setup_method(self):
+        self.box = Sandbox()
+
+    def teardown_method(self):
+        self.box.close()
+
+    def wait_takeover(self, proc: subprocess.Popen) -> None:
+        assert wait_until(lambda: self.box.serving('"ok":true')
+                          and self.box.upstream.exists(), 30), self.box.tail()
+
+    def test_new_version_takes_over_in_probation_and_restores_on_contract_drift(self):
+        self.box.pin_previous_build()
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        official = self.box.start_official()
+        official_inode = inode(self.box.target)
+        sup = self.box.start_supervisor()
+        self.wait_takeover(sup)
+
+        status = self.box.status()
+        assert status["mode"] == "probation" and status["version"] == "2.0"
+        assert inode(self.box.upstream) == official_inode
+
