+except Exception as exc:  # noqa: BLE001 - 任何导入失败都必须显式失败
+    print(f"[fnmedia-verify] 无法加载 recover.py: {exc}")
+    raise SystemExit(5)
+
+
+def fail(message, code=3):
+    print(f"[fnmedia-verify] {message}")
+    raise SystemExit(code)
+
+
+try:
+    paths = recover.paths_from_env()
+    state = recover.read_state(paths)
+    target = recover.socket_facts(paths.target)
+    upstream = recover.socket_facts(paths.upstream)
+except recover.RecoveryError as exc:
+    print(f"[fnmedia-verify] 无法判定现场: {exc}")
+    raise SystemExit(exc.code or 3)
+
+if state is not None:
+    fail(f"接管状态仍在 {paths.state_file}（phase={state.get('phase')}），未完成还原")
+if upstream.get("exists"):
+    fail(f"{paths.upstream} 仍存在（inode {upstream.get('dev')}:{upstream.get('ino')}），"
+         "官方 socket 未还回原位")
+if not target.get("exists"):
+    print("[fnmedia-verify] 官方 socket 当前不存在；本插件未持有任何现场"
+          "（无状态、无 upstream），官方服务启动后会自行重建")
+    raise SystemExit(0)
+if target.get("is_symlink"):
+    try:
+        dest = os.readlink(str(paths.target))
+    except OSError:
+        dest = "?"
+    fail(f"{paths.target} 是符号链接（指向 {dest}），需人工确认")
+if not target.get("is_socket"):
+    fail(f"{paths.target} 不是 socket，需人工确认")
+if not target.get("live"):
+    fail(f"{paths.target} 无监听者（inode {target.get('dev')}:{target.get('ino')}），"
+         "无法证明官方已恢复")
+try:
+    identity = recover.peer_identity(paths.target)
+except recover.RecoveryError as exc:
+    print(f"[fnmedia-verify] 无法读取 {paths.target} 的监听者: {exc}")
+    raise SystemExit(exc.code or 3)
