+            recorded = await client.post("/v/api/v1/play/record", headers=h, json={"item_guid": guid, "ts": 9, "duration": 20})
+            assert recorded.json()["code"] == 0
+            assert len((await client.get("/v/api/v1/play/list", headers=h)).json()["data"]) == 1
+            assert (await client.get("/v/api/v1/play/list", headers={"Authorization": "user-test-session"})).json()["data"] == []
+            def encoded(url): return base64.urlsafe_b64encode(url.encode()).decode().rstrip("=")
+            response = await client.get("/v/media/online/fixture/seg", headers=h, params={"u": encoded("http://fixture.example/seg")})
