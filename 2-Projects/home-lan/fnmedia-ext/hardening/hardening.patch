+class MutualExclusionTest(_Case):
+    def test_manual_and_background_refresh_share_one_run(self):
+        """并发两次 force 刷新只打一次上游，两个调用拿到同一次结果。"""
+        UPSTREAM.delay = 0.05
+
+        async def scenario():
+            return await asyncio.gather(
+                refreshmod.refresh(force=True, reason="manual-a"),
+                refreshmod.refresh(force=True, reason="manual-b"),
+                refreshmod.refresh(force=True, reason="worker"))
+
+        first, second, third = self.run_async(scenario())
+        self.assertEqual(first, second)
+        self.assertEqual(first, third)
+        # 一次刷新只解析一次分类表、只抓一次榜单（并发会翻倍）
+        self.assertEqual(UPSTREAM.class_calls, 1)
+        self.assertEqual(self.collect_calls, 1)
+        self.assertTrue(first["ok"])
+
+    def test_worker_and_manual_do_not_overlap(self):
+        """worker 正在跑时手动刷新等它完成，不会并发第二次抓取。"""
+        UPSTREAM.delay = 0.05
+
+        async def scenario():
+            stop = asyncio.Event()
+            worker = asyncio.create_task(
+                refreshmod.worker_loop(stop, initial_delay=0))
+            # 等 worker 真正开始刷新
+            for _ in range(200):
+                if refreshmod.status()["running"]:
+                    break
+                await asyncio.sleep(0.01)
+            manual = await refreshmod.refresh(force=True, reason="manual")
+            stop.set()
+            await worker
+            return manual
+
+        st = self.run_async(scenario())
+        self.assertTrue(st["ok"], st)
+        self.assertEqual(UPSTREAM.class_calls, 1, "手动不得并发第二次刷新")
+        self.assertEqual(self.collect_calls, 1)
+
+    def test_catalog_refresh_routes_is_single_flight(self):
+        async def scenario():
+            return await asyncio.gather(
+                self.catalog.refresh_routes(list(_SOURCES)),
+                self.catalog.refresh_routes(list(_SOURCES)))
+
+        a, b = self.run_async(scenario())
+        self.assertTrue(a["ok"])
+        self.assertEqual(a["updated_at"], b["updated_at"])
