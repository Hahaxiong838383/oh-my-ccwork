+            self.end_headers()
+            self.wfile.write(content)
+    server = ThreadingHTTPServer(("127.0.0.1", 0), CMS)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    async def dial(host, port, **kwargs):
