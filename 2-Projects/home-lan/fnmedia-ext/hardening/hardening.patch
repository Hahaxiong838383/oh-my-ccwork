+  say "[OK] 已卸载，官方 trim_media.sock 由官方进程接管，影视恢复原样"
+else
+  err "单元已移除，但归属校验未通过：请人工确认 ls -l /var/run/trim_media*.sock"
+  exit 3
 fi
+exit 0
