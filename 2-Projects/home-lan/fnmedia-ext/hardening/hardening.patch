+    who = "pid=%s exe=%s" % (identity.get("pid") if identity else None,
+                             identity.get("exe") if identity else None)
+    fail(f"{paths.target} 的监听者不是官方进程（{who}），拒绝判定为已还原")
+print(f"[fnmedia-verify] 已还原：{paths.target} 由官方进程 pid={identity['pid']} 监听"
