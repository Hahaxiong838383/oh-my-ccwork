+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        assert guard.changed()
+
+    def test_publish_writes_only_non_sensitive_fields(self, monkeypatch):
+        monkeypatch.setenv("FNMEDIA_MAINTENANCE_DIR", str(self.box.mailbox))
+        self.box.pin_previous_build()
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert publish(decision)
+        payload = self.box.status()
+        assert set(payload) == {"mode", "version", "reason", "checked_at", "message"}
+        assert payload["mode"] == "probation"
+        assert payload["version"] == "2.0"
+        assert str(self.box.target) not in json.dumps(payload)
+
+    def test_probation_disabled_refuses_new_version(self):
+        self.box.write_spec(version="1.0",
+                            sha=hashlib.sha256(b"previous-official-build").hexdigest(),
+                            allow_probation=False)
