-    lite_plain = lite_alt = full_pkg = None
-    for a in assets:
-        name = a.get("name") or ""
-        if not name.endswith(".fpk"):
-            continue
-        if re.search(r"-full\.fpk$", name):
-            full_pkg = a
-        elif re.search(r"-(lite|public)\.fpk$", name):
-            lite_alt = a
-        elif re.match(r"^fnmedia-ext-.+\.fpk$", name):
-            lite_plain = a
-    if full:
-        return full_pkg
-    return lite_plain or lite_alt
