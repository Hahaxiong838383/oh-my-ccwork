diff --git a/proxy/compatibility.py b/proxy/compatibility.py
new file mode 100644
index 0000000..72fc33d
--- /dev/null
+++ b/proxy/compatibility.py
@@ -0,0 +1,39 @@
+"""Read-only compatibility guard; never patch the official media application."""
+from __future__ import annotations
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+class CompatibilityGuard:
+    def __init__(self):
+        value = os.environ.get("FNMEDIA_COMPAT_LOCK") or Path(__file__).resolve().parents[1] / "compatibility.json"
+        self.spec = json.loads(Path(value).read_text())
+        self.stamps = None
+
+    def _paths(self):
+        return [Path(self.spec["executable"]), Path(self.spec["manifest"])]
+
+    def _stamp(self):
+        return [(s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+                for s in (p.stat() for p in self._paths())]
+
+    def validate(self):
+        before = self._stamp()
+        executable, manifest = self._paths()
+        with executable.open("rb") as stream:
+            digest = hashlib.file_digest(stream, "sha256").hexdigest()
+        if digest != self.spec["sha256"]:
+            raise RuntimeError("官方影视版本发生变化，插件保持停用，需重新验证兼容性")
+        version = next((line.split("=", 1)[1].strip().strip('"')
+                        for line in manifest.read_text().splitlines() if line.startswith("version=")), "")
+        if version != self.spec["version"] or before != self._stamp():
+            raise RuntimeError("官方影视版本或文件正在变化，插件不接管")
+        self.stamps = before
+
+    def changed(self):
+        try:
+            return self._stamp() != self.stamps
+        except OSError:
+            return True
