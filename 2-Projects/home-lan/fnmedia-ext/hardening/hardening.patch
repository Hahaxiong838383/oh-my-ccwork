+    if [ "${rc}" -ne 0 ]; then
+      echo "[fnmedia-ext] 停止未完成：官方 trim_media.sock 未确认还原（rc=${rc}），详见 ${FNMEDIA_LOG}" >&2
+      exit "${rc}"
+    fi
