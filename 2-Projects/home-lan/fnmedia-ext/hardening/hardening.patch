+#!/usr/bin/env python3
+"""出站 HTTP 安全护栏（SSRF guard）——插件主动访问公网第三方站点的唯一入口。
+
+适用范围（重要）：
+  只管「插件 → 公网资源站/CDN/榜单/订阅/更新」这条出站链路。
+  官方影视后端（trim.media）仍由 app.py 用**原始** httpx.AsyncClient +
+  AsyncHTTPTransport(uds=...) 走 Unix Socket，不经过本模块，行为完全不变；
+  本模块也刻意不提供 uds 参数，防止误把官方后端接进护栏。
+
+三道闸，缺一不可：
+  1) URL 闸：check_url() 只放行 http/https、必须有 host、禁 userinfo、禁非规范数字
+     主机（十进制整数 / 十六进制 / 少段点分 / 尾部点等 libc 宽松写法）、禁非法域名。
+     SafeClient 把它挂在 _send_single_request 上，因此**每一次重定向跳转**都会重新校验
+     （httpx 的每一跳都必然经过 _send_single_request）。
+  2) DNS 闸：GuardedNetworkBackend 自己解析，校验**全部** A/AAAA 答案；只要有一条落在
+     私网/环回/链路本地/组播/保留/未指定/IPv4 映射等范围，整次请求直接拒绝，不做
+     “取第一个能用的”妥协。
+  3) 连接闸：只向上一步校验过的 IP 字面量拨号，绝不把主机名再交给 libc/anyio 二次解析，
+     消除 DNS rebinding 的 TOCTOU 窗口（解析一次 → 校验 → 拨该 IP）。
+     TLS 仍由 httpcore 用**原始主机名**做 SNI 与证书校验（server_hostname 取自 origin），
+     Host 头同样保持原样；可见「拨号目标」与「身份校验对象」被彻底解耦。
+
+其它硬约束：
+  * trust_env 恒为 False，且不接受 proxy / mounts 覆盖 —— 环境变量里的 HTTP(S)_PROXY
+    不会把出站流量（连同内网可达性）转交给代理。
+  * verify=False 视为配置错误直接抛 SSRFConfigError；CERT_NONE / check_hostname=False
+    的 SSLContext 同样拒绝。
+  * 可注入 resolver / dialer 仅用于测试（本地 fixture）：生产工厂函数不暴露这些参数，
+    也没有任何环境变量开关；默认策略对象里不存在“允许本机”的分支。
+
+与 httpx 0.28.1 / httpcore 1.0.9 对齐；流式 send/build_request 语义不变。
+"""
+from __future__ import annotations
+
+import inspect
+import ipaddress
+import re
+import socket
+import ssl
+import time
+import typing
+
+import anyio
+import httpcore
+import httpx
+
+__all__ = [
+    "SSRFBlocked",
+    "SSRFConfigError",
+    "DestinationPolicy",
+    "GuardedNetworkBackend",
+    "GuardedSyncNetworkBackend",
+    "SafeAsyncTransport",
+    "SafeHTTPTransport",
+    "SafeAsyncClient",
+    "SafeClient",
+    "async_client",
+    "client",
+    "check_url",
+]
+
+# 只允许这两种 scheme；ws/wss/ftp/file/data 等一律不做出站。
+_ALLOWED_SCHEMES = frozenset({"http", "https"})
+
+# DNS 名约束（RFC 1035 的宽松实现：允许下划线，标识符实际部署里很常见）。
+_MAX_HOST_LEN = 253
+_MAX_LABEL_LEN = 63
+_LABEL_RE = re.compile(r"^[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?$", re.IGNORECASE)
+_DIGITS_DOTS_RE = re.compile(r"^[0-9.]+$")
+_HEXISH_RE = re.compile(r"^(?:0[xX][0-9a-fA-F]+|[0-9a-fA-F.]*0[xX][0-9a-fA-F.]+)$")
+
+# 明确拒绝的 IPv4 段（在 ipaddress 的 is_* 之外补齐“保留/文档/过渡”语义）。
+_BLOCKED_V4 = tuple(
+    ipaddress.ip_network(n) for n in (
+        "0.0.0.0/8",          # 本网络 / 未指定
+        "10.0.0.0/8",         # 私网
+        "100.64.0.0/10",      # 运营商级 NAT
+        "127.0.0.0/8",        # 环回
+        "169.254.0.0/16",     # 链路本地（含云元数据）
+        "172.16.0.0/12",      # 私网
+        "192.0.0.0/24",       # IETF 协议分配
+        "192.0.2.0/24",       # 文档示例
+        "192.88.99.0/24",     # 6to4 中继
+        "192.168.0.0/16",     # 私网
+        "198.18.0.0/15",      # 基准测试
+        "198.51.100.0/24",    # 文档示例
+        "203.0.113.0/24",     # 文档示例
+        "224.0.0.0/4",        # 组播
+        "240.0.0.0/4",        # 保留 + 广播
+        "255.255.255.255/32",
+    )
+)
+
+# 明确拒绝的 IPv6 段（含过渡/映射/文档/本地）。
+_BLOCKED_V6 = tuple(
+    ipaddress.ip_network(n) for n in (
+        "::/128",
+        "::1/128",
+        "64:ff9b::/96",       # NAT64 well-known
+        "64:ff9b:1::/48",     # NAT64 本地用途
+        "100::/64",           # 丢弃前缀
+        "2001::/32",          # Teredo
+        "2001:2::/48",        # 基准测试
+        "2001:10::/28",       # ORCHID
+        "2001:20::/28",       # ORCHIDv2
+        "2001:db8::/32",      # 文档示例
+        "2002::/16",          # 6to4
+        "3fff::/20",          # 文档示例（2024 分配）
+        "fc00::/7",           # 唯一本地
+        "fe80::/10",          # 链路本地
+        "ff00::/8",           # 组播
+    )
+)
+
+
+# 逐跳校验依赖 httpx 的 _send_single_request（每一次请求/重定向跳转的唯一出口）。
+# httpx 若重构掉这个扩展点，护栏会静默失效 —— 所以宁可启动即失败。
+for _cls_name in ("AsyncClient", "Client"):
+    if not hasattr(getattr(httpx, _cls_name), "_send_single_request"):  # pragma: no cover
+        raise RuntimeError(
+            f"unsupported httpx version ({httpx.__version__}): "
+            f"{_cls_name}._send_single_request is missing; "
+            "safe_http cannot guarantee per-hop validation")
+
+
+class SSRFBlocked(httpx.HTTPError):
+    """目标不被允许（策略拒绝，不是网络故障）。
+
+    刻意继承 httpx.HTTPError 而非 TransportError：调用方现有的
+    `except httpx.TransportError` 重试逻辑不会对策略拒绝做无意义重试，
+    但 `except httpx.HTTPError` 仍能统一兜住。
+    """
+
+
+class SSRFConfigError(ValueError):
+    """护栏配置被削弱（verify=False、trust_env=True、自定义代理/UDS 等）。"""
+
+
+# --------------------------------------------------------------------- 工具
+
+
+def _as_ip(value: typing.Any) -> ipaddress.IPv4Address | ipaddress.IPv6Address:
+    if isinstance(value, (ipaddress.IPv4Address, ipaddress.IPv6Address)):
+        return value
+    return ipaddress.ip_address(str(value))
+
+
+def _reject_odd_numeric_host(host: str) -> None:
+    """拒绝 libc 会“宽容解释”的非规范数字主机写法。
+
+    先由 ipaddress 严格解析（调用方已处理）；走到这里说明不是规范 IP 字面量，
+    此时只要 inet_aton 还能接受、或纯数字/十六进制形态，就必然是 2130706433 /
+    0x7f.0.0.1 / 127.1 / 0177.0.0.1 / 127.0.0.1. 这类绕过写法，一律拒绝。
+    """
+    if _DIGITS_DOTS_RE.fullmatch(host) or _HEXISH_RE.fullmatch(host):
+        raise SSRFBlocked(f"blocked non-canonical numeric host: {host!r}")
+    try:
+        socket.inet_aton(host)
+    except OSError:
+        return
+    raise SSRFBlocked(f"blocked non-canonical numeric host: {host!r}")
+
+
+def _validate_dns_name(host: str) -> None:
+    name = host[:-1] if host.endswith(".") else host
+    if not name or len(name) > _MAX_HOST_LEN:
+        raise SSRFBlocked(f"blocked invalid host: {host!r}")
+    for label in name.split("."):
+        if not label or len(label) > _MAX_LABEL_LEN or not _LABEL_RE.match(label):
+            raise SSRFBlocked(f"blocked invalid host: {host!r}")
+
+
+def _decode_host(url: httpx.URL) -> str:
+    raw = url.raw_host
+    if not raw:
+        raise SSRFBlocked("blocked URL without host")
+    try:
+        return raw.decode("ascii")
+    except UnicodeDecodeError:
+        raise SSRFBlocked("blocked non-ASCII host") from None
+
+
+# ----------------------------------------------------------------- 策略对象
+
+
+class DestinationPolicy:
+    """目标地址策略：只允许“公网可全局路由的单播地址”。
+
+    无任何开关，也没有“允许本机/内网”的分支——生产路径无法放宽。
+    """
+
+    def check_ip(self, value: typing.Any) -> None:
+        ip = _as_ip(value)
+
+        if isinstance(ip, ipaddress.IPv6Address):
+            # IPv4 映射/兼容、6to4、Teredo 都指向另一层地址，直接拒绝，
+            # 避免用外层写法把内层私网地址夹带进来。
+            if ip.ipv4_mapped is not None:
+                raise SSRFBlocked("blocked IPv4-mapped IPv6 destination")
+            if ip.sixtofour is not None or ip.teredo is not None:
+                raise SSRFBlocked("blocked IPv6 transition destination")
+            for net in _BLOCKED_V6:
+                if ip in net:
+                    raise SSRFBlocked(f"blocked IPv6 destination ({net})")
+        else:
+            for net in _BLOCKED_V4:
+                if ip in net:
+                    raise SSRFBlocked(f"blocked IPv4 destination ({net})")
+
+        if (ip.is_loopback or ip.is_private or ip.is_link_local
+                or ip.is_multicast or ip.is_reserved or ip.is_unspecified):
+            raise SSRFBlocked("blocked non-public destination")
+        if not ip.is_global:
+            raise SSRFBlocked("blocked non-global destination")
+
+    def check_host(self, host: str) -> None:
+        """校验主机字符串：字面量直接按 IP 策略判；域名只做语法与本地名拦截。"""
+        if not host:
+            raise SSRFBlocked("blocked URL without host")
+        if "%" in host:
+            # 百分号编码主机（%31%32%37…）与 IPv6 zone id（fe80::1%eth0）都从这里拦。
+            raise SSRFBlocked(f"blocked encoded or scoped host: {host!r}")
+
+        try:
+            literal = ipaddress.ip_address(host)
+        except ValueError:
+            literal = None
+
+        if literal is not None:
+            self.check_ip(literal)
+            return
+
+        _reject_odd_numeric_host(host)
+        _validate_dns_name(host)
+        name = host.rstrip(".").lower()
+        if name == "localhost" or name.endswith(".localhost"):
+            raise SSRFBlocked("blocked localhost hostname")
+
+    def check_answers(self, host: str, answers: typing.Iterable[typing.Any]) -> list[str]:
+        """校验一条主机名的**全部**解析结果；任一不合格即整体拒绝。"""
+        checked: list[str] = []
+        seen: set[str] = set()
+        for answer in answers:
+            try:
+                ip = _as_ip(answer)
+            except ValueError:
+                raise SSRFBlocked(f"blocked unparsable DNS answer for {host!r}") from None
+            self.check_ip(ip)
+            text = str(ip)
+            if text not in seen:
+                seen.add(text)
+                checked.append(text)
+        if not checked:
+            raise httpcore.ConnectError(f"no addresses for {host!r}")
+        return checked
+
+
+_DEFAULT_POLICY = DestinationPolicy()
+
+
+# ------------------------------------------------------------------ URL 校验
+
+
+def check_url(url: str | httpx.URL) -> httpx.URL:
+    """校验一个出站 URL；不合格抛 SSRFBlocked，合格返回规范化后的 URL。
+
+    不做 DNS 解析（解析与校验在连接阶段完成），因此可以被上层低成本调用，
+    例如播放地址入库前先做一次预检。
+    """
+    try:
+        parsed = url if isinstance(url, httpx.URL) else httpx.URL(str(url))
+    except Exception:
+        raise SSRFBlocked(f"blocked invalid URL: {url!r}") from None
+
+    if parsed.scheme not in _ALLOWED_SCHEMES:
+        raise SSRFBlocked(f"blocked scheme: {parsed.scheme!r}")
+    if parsed.userinfo:
+        raise SSRFBlocked("blocked URL with userinfo")
+    if not parsed.raw_host:
+        raise SSRFBlocked("blocked URL without host")
+
+    host = _decode_host(parsed)
+    _DEFAULT_POLICY.check_host(host)
+
+    port = parsed.port
+    if port is not None and not (0 < port < 65536):
+        raise SSRFBlocked(f"blocked invalid port: {port!r}")
+    return parsed
+
+
+def _check_sni_extension(request: httpx.Request) -> None:
+    """禁止用 extension 把 SNI 指到别的主机（会让证书校验对象与目标脱节）。"""
+    sni = request.extensions.get("sni_hostname")
+    if sni is None:
+        return
+    if isinstance(sni, bytes):
+        try:
+            sni = sni.decode("ascii")
+        except UnicodeDecodeError:
+            raise SSRFBlocked("blocked invalid sni_hostname") from None
+    if str(sni).lower() != _decode_host(request.url).lower():
+        raise SSRFBlocked("blocked sni_hostname override")
+
+
+# --------------------------------------------------------------- DNS / 拨号
+
+
+def _system_resolve(host: str, port: int) -> list[str]:
+    """系统解析（同步）：只取 A/AAAA 结果，顺序保持系统返回顺序。"""
+    infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM,
+                               proto=socket.IPPROTO_TCP)
+    out: list[str] = []
+    for family, _type, _proto, _canon, sockaddr in infos:
+        if family in (socket.AF_INET, socket.AF_INET6):
+            out.append(str(sockaddr[0]))
+    return out
+
+
+async def _system_resolve_async(host: str, port: int) -> list[str]:
+    return await anyio.to_thread.run_sync(_system_resolve, host, port)
+
+
+# 注入签名（resolver/dialer）仅测试使用；生产工厂不暴露。
+Resolver = typing.Callable[[str, int], typing.Any]
+AsyncDialer = typing.Callable[..., typing.Any]
+SyncDialer = typing.Callable[..., typing.Any]
+
+
+async def _anyio_dial(host: str, port: int, *, timeout: float | None,
+                      local_address: str | None,
+                      socket_options: typing.Any) -> httpcore.AsyncNetworkStream:
+    backend = typing.cast(typing.Any, httpcore.AnyIOBackend())
+    return await backend.connect_tcp(
+        host, port, timeout=timeout, local_address=local_address,
+        socket_options=socket_options)
+
+
+def _sync_dial(host: str, port: int, *, timeout: float | None,
+               local_address: str | None,
+               socket_options: typing.Any) -> httpcore.NetworkStream:
+    return httpcore.SyncBackend().connect_tcp(
+        host, port, timeout=timeout, local_address=local_address,
+        socket_options=socket_options)
+
+
+class GuardedNetworkBackend(httpcore.AsyncNetworkBackend):
+    """异步 httpcore network backend：解析 → 全量校验 → 只拨校验过的 IP。
+
+    resolver / dialer 是测试注入点（本地 fixture 需要连 127.0.0.1，而策略本身
+    永远拒绝 127.0.0.1；注入方用“声明公网 IP、实际拨本地端口”的 dialer 完成
+    端到端验证）。生产代码不传这两个参数。
+    """
+
+    def __init__(self, policy: DestinationPolicy | None = None, *,
+                 resolver: Resolver | None = None,
+                 dialer: AsyncDialer | None = None) -> None:
+        self._policy = policy or _DEFAULT_POLICY
+        self._resolver = resolver
+        self._dialer = dialer or _anyio_dial
+
+    async def _resolve(self, host: str, port: int) -> list[str]:
+        if self._resolver is None:
+            answers = await _system_resolve_async(host, port)
+        else:
+            answers = self._resolver(host, port)
+            if inspect.isawaitable(answers):
+                answers = await answers
+        return self._policy.check_answers(host, answers)
+
+    async def connect_tcp(
+        self,
+        host: str,
+        port: int,
+        timeout: float | None = None,
+        local_address: str | None = None,
+        socket_options: typing.Iterable[typing.Any] | None = None,
+    ) -> httpcore.AsyncNetworkStream:
+        # 即便调用方绕过 SafeClient（例如直接把本 backend 塞进别的 pool），
+        # 主机语法与地址策略在连接点仍然生效。
+        self._policy.check_host(host)
+        if not isinstance(port, int) or not (0 < port < 65536):
+            raise SSRFBlocked(f"blocked invalid port: {port!r}")
+
+        try:
+            pinned = await self._resolve(host, port)
+        except socket.gaierror as exc:
+            raise httpcore.ConnectError(f"DNS resolution failed for {host!r}") from exc
+
+        last_exc: Exception | None = None
+        for address in pinned:
+            try:
+                # 关键：只把字面量交给底层，杜绝二次解析导致的 rebinding。
+                return await self._dialer(
+                    address, port, timeout=timeout, local_address=local_address,
+                    socket_options=socket_options)
+            except (httpcore.ConnectError, httpcore.ConnectTimeout, OSError) as exc:
+                last_exc = exc
+                continue
+        raise last_exc or httpcore.ConnectError(f"cannot connect to {host!r}")
+
+    async def connect_unix_socket(
+        self,
+        path: str,
+        timeout: float | None = None,
+        socket_options: typing.Iterable[typing.Any] | None = None,
+    ) -> httpcore.AsyncNetworkStream:
+        # 出站公网访问没有 UDS 这一说；官方后端的 UDS 由 app.py 的原始 client 负责。
+        raise SSRFBlocked("blocked unix socket for outbound access")
+
+    async def sleep(self, seconds: float) -> None:
+        await anyio.sleep(seconds)
+
+
+class GuardedSyncNetworkBackend(httpcore.NetworkBackend):
+    """同步版护栏 backend（subfetch / updater 等同步出站客户端使用）。"""
+
+    def __init__(self, policy: DestinationPolicy | None = None, *,
+                 resolver: Resolver | None = None,
+                 dialer: SyncDialer | None = None) -> None:
+        self._policy = policy or _DEFAULT_POLICY
+        self._resolver = resolver or _system_resolve
+        self._dialer = dialer or _sync_dial
+
+    def connect_tcp(
+        self,
+        host: str,
+        port: int,
+        timeout: float | None = None,
+        local_address: str | None = None,
+        socket_options: typing.Iterable[typing.Any] | None = None,
+    ) -> httpcore.NetworkStream:
+        self._policy.check_host(host)
+        if not isinstance(port, int) or not (0 < port < 65536):
+            raise SSRFBlocked(f"blocked invalid port: {port!r}")
+
+        try:
+            answers = self._resolver(host, port)
+        except socket.gaierror as exc:
+            raise httpcore.ConnectError(f"DNS resolution failed for {host!r}") from exc
+        pinned = self._policy.check_answers(host, answers)
+
+        last_exc: Exception | None = None
+        for address in pinned:
+            try:
+                return self._dialer(
+                    address, port, timeout=timeout, local_address=local_address,
+                    socket_options=socket_options)
+            except (httpcore.ConnectError, httpcore.ConnectTimeout, OSError) as exc:
+                last_exc = exc
+                continue
+        raise last_exc or httpcore.ConnectError(f"cannot connect to {host!r}")
+
+    def connect_unix_socket(
+        self,
+        path: str,
+        timeout: float | None = None,
+        socket_options: typing.Iterable[typing.Any] | None = None,
+    ) -> httpcore.NetworkStream:
+        raise SSRFBlocked("blocked unix socket for outbound access")
+
+    def sleep(self, seconds: float) -> None:
+        time.sleep(seconds)
+
+
+# ----------------------------------------------------------------- 传输层
+
+
+def _check_verify(verify: typing.Any) -> typing.Any:
+    """校验 TLS 校验配置并归一化；返回可直接交给 httpx 的 verify 值。"""
+    if verify is None or verify is True:
+        return True
+    if verify is False:
+        raise SSRFConfigError("verify=False is not allowed for outbound access")
+    if isinstance(verify, ssl.SSLContext):
+        if verify.verify_mode == ssl.CERT_NONE or not verify.check_hostname:
+            raise SSRFConfigError(
+                "SSLContext must verify certificates and check hostnames")
+        return verify
+    if isinstance(verify, str):
+        # httpx 仍支持 CA 路径（会发 DeprecationWarning），本身是安全的。
+        return verify
+    raise SSRFConfigError(f"unsupported verify value: {verify!r}")
+
+
+def _pool_limits(limits: httpx.Limits | None) -> httpx.Limits:
+    return limits if limits is not None else httpx.Limits(
+        max_connections=100, max_keepalive_connections=20, keepalive_expiry=5.0)
+
+
+class SafeAsyncTransport(httpx.AsyncHTTPTransport):
+    """httpx 异步 transport：底层 pool 换成带护栏的 network backend。
+
+    其余语义（连接池、流式响应、HTTP/1.1、超时、重试）全部沿用 httpx 实现，
+    因此 build_request/send(stream=True)/aiter_raw 的行为与原生 AsyncHTTPTransport
+    完全一致。不接受 uds / proxy / local_address。
+    """
+
+    def __init__(
+        self,
+        *,
+        verify: typing.Any = True,
+        cert: typing.Any = None,
+        http1: bool = True,
+        http2: bool = False,
+        limits: httpx.Limits | None = None,
+        retries: int = 0,
+        socket_options: typing.Iterable[typing.Any] | None = None,
+        network_backend: httpcore.AsyncNetworkBackend | None = None,
+    ) -> None:
+        verify = _check_verify(verify)
+        limits = _pool_limits(limits)
+        backend = network_backend or GuardedNetworkBackend()
+        if not isinstance(backend, GuardedNetworkBackend):
+            raise SSRFConfigError(
+                "network_backend must be a GuardedNetworkBackend instance")
+
+        # 只建一个 SSLContext：SNI 与证书校验都靠它（trust_env=False，不读
+        # SSL_CERT_FILE/DIR 之类环境变量）。
+        ssl_context = httpx.create_ssl_context(verify=verify, cert=cert,
+                                               trust_env=False)
+        super().__init__(verify=ssl_context, cert=None, trust_env=False,
+                         http1=http1, http2=http2, limits=limits, uds=None,
+                         retries=retries, socket_options=socket_options)
+        # 仅替换 pool：连接/流式/超时/重试语义全部沿用 httpx 实现。
+        self._pool = httpcore.AsyncConnectionPool(
+            ssl_context=ssl_context,
+            max_connections=limits.max_connections,
+            max_keepalive_connections=limits.max_keepalive_connections,
+            keepalive_expiry=limits.keepalive_expiry,
+            http1=http1,
+            http2=http2,
+            retries=retries,
+            socket_options=socket_options,
+            network_backend=backend,
+        )
+
+
+class SafeHTTPTransport(httpx.HTTPTransport):
+    """同步版 transport（语义同上）。"""
+
+    def __init__(
+        self,
+        *,
+        verify: typing.Any = True,
+        cert: typing.Any = None,
+        http1: bool = True,
+        http2: bool = False,
+        limits: httpx.Limits | None = None,
+        retries: int = 0,
+        socket_options: typing.Iterable[typing.Any] | None = None,
+        network_backend: httpcore.NetworkBackend | None = None,
+    ) -> None:
+        verify = _check_verify(verify)
+        limits = _pool_limits(limits)
+        backend = network_backend or GuardedSyncNetworkBackend()
+        if not isinstance(backend, GuardedSyncNetworkBackend):
+            raise SSRFConfigError(
+                "network_backend must be a GuardedSyncNetworkBackend instance")
+
+        ssl_context = httpx.create_ssl_context(verify=verify, cert=cert,
+                                               trust_env=False)
+        super().__init__(verify=ssl_context, cert=None, trust_env=False,
+                         http1=http1, http2=http2, limits=limits, uds=None,
+                         retries=retries, socket_options=socket_options)
+        self._pool = httpcore.ConnectionPool(
+            ssl_context=ssl_context,
+            max_connections=limits.max_connections,
+            max_keepalive_connections=limits.max_keepalive_connections,
+            keepalive_expiry=limits.keepalive_expiry,
+            http1=http1,
+            http2=http2,
+            retries=retries,
+            socket_options=socket_options,
+            network_backend=backend,
+        )
+
+
+# ------------------------------------------------------------------- 客户端
+
+
+def _check_redirect_location(request: httpx.Request,
+                             response: httpx.Response) -> None:
+    """校验重定向 Location；不合格立即抛错（跟不跟随都拦）。"""
+    location = response.headers.get("location")
+    if not location:
+        return
+    try:
+        target = request.url.join(location)
+    except Exception:
+        raise SSRFBlocked("blocked invalid redirect location") from None
+    check_url(target)
+
+
+class SafeAsyncClient(httpx.AsyncClient):
+    """所有出站请求都过护栏的 httpx.AsyncClient。
+
+    - trust_env / proxy / mounts / transport / uds 一律不可覆盖（传了就抛错）；
+    - 每一跳（含重定向）在 _send_single_request 处做 URL 校验；
+    - 连接阶段由 GuardedNetworkBackend 做 DNS + IP 校验与固定拨号。
+    """
+
+    def __init__(
+        self,
+        *,
+        verify: typing.Any = True,
+        http1: bool = True,
+        http2: bool = False,
+        limits: httpx.Limits | None = None,
+        timeout: typing.Any = 30.0,
+        follow_redirects: bool = True,
+        max_redirects: int = 10,
+        headers: typing.Any = None,
+        cookies: typing.Any = None,
+        auth: typing.Any = None,
+        params: typing.Any = None,
+        base_url: typing.Any = "",
+        event_hooks: typing.Any = None,
+        network_backend: httpcore.AsyncNetworkBackend | None = None,
+    ) -> None:
+        verify = _check_verify(verify)
+        limits = _pool_limits(limits)
+        transport = SafeAsyncTransport(verify=verify, http1=http1, http2=http2,
+                                       limits=limits,
+                                       network_backend=network_backend)
+        super().__init__(
+            verify=verify, trust_env=False, http1=http1, http2=http2,
+            limits=limits, timeout=timeout, follow_redirects=follow_redirects,
+            max_redirects=max_redirects, headers=headers, cookies=cookies,
+            auth=auth, params=params, base_url=base_url,
+            event_hooks=event_hooks, transport=transport,
+        )
+
+    async def _send_single_request(self, request: httpx.Request) -> httpx.Response:
+        check_url(request.url)
+        _check_sni_extension(request)
+        response = await super()._send_single_request(request)
+        try:
+            _check_redirect_location(request, response)
+        except BaseException:
+            await response.aclose()
+            raise
+        return response
+
+
+class SafeClient(httpx.Client):
+    """同步版 SafeAsyncClient（语义一致）。"""
+
+    def __init__(
+        self,
+        *,
+        verify: typing.Any = True,
+        http1: bool = True,
+        http2: bool = False,
+        limits: httpx.Limits | None = None,
+        timeout: typing.Any = 30.0,
+        follow_redirects: bool = True,
+        max_redirects: int = 10,
+        headers: typing.Any = None,
+        cookies: typing.Any = None,
+        auth: typing.Any = None,
+        params: typing.Any = None,
+        base_url: typing.Any = "",
+        event_hooks: typing.Any = None,
+        network_backend: httpcore.NetworkBackend | None = None,
+    ) -> None:
+        verify = _check_verify(verify)
+        limits = _pool_limits(limits)
+        transport = SafeHTTPTransport(verify=verify, http1=http1, http2=http2,
+                                      limits=limits,
+                                      network_backend=network_backend)
+        super().__init__(
+            verify=verify, trust_env=False, http1=http1, http2=http2,
+            limits=limits, timeout=timeout, follow_redirects=follow_redirects,
+            max_redirects=max_redirects, headers=headers, cookies=cookies,
+            auth=auth, params=params, base_url=base_url,
+            event_hooks=event_hooks, transport=transport,
+        )
+
+    def _send_single_request(self, request: httpx.Request) -> httpx.Response:
+        check_url(request.url)
+        _check_sni_extension(request)
+        response = super()._send_single_request(request)
+        try:
+            _check_redirect_location(request, response)
+        except BaseException:
+            response.close()
+            raise
+        return response
+
+
+def async_client(*, timeout: typing.Any = 30.0,
+                 follow_redirects: bool = True,
+                 headers: typing.Any = None,
+                 verify: typing.Any = True,
+                 http2: bool = False,
+                 limits: httpx.Limits | None = None,
+                 max_redirects: int = 10,
+                 cookies: typing.Any = None,
+                 auth: typing.Any = None,
+                 params: typing.Any = None,
+                 base_url: typing.Any = "",
+                 event_hooks: typing.Any = None) -> SafeAsyncClient:
