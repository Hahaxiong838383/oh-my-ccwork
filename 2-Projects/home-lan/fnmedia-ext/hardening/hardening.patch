+    [ -n "${d}" ] && paths+=("${d%/}/fnmedia-ext.sock")
+  done
+  [ "${#paths[@]}" -gt 0 ] || return 0
+
+  if [ -n "${FNMEDIA_REPO_DIR}" ] && [ -x "${FNMEDIA_REPO_DIR}/.venv/bin/python" ]; then
+    py="${FNMEDIA_REPO_DIR}/.venv/bin/python"
+  elif command -v python3 >/dev/null 2>&1; then
+    py="$(command -v python3)"
+  fi
+  if [ -z "${py}" ]; then
+    log_line "无可用 python3，跳过网关 socket 收尾（不删除任何文件）"
+    return 0
+  fi
+
+  "${py}" - "${paths[@]}" >> "${FNMEDIA_LOG}" 2>&1 <<'PYCODE'
+import os
+import socket
+import stat
+import sys
+
+for path in sys.argv[1:]:
+    try:
+        info = os.lstat(path)
+    except FileNotFoundError:
+        continue
+    except OSError as exc:
+        print(f"网关 socket 收尾跳过 {path}: {exc}")
+        continue
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISSOCK(info.st_mode):
+        print(f"保留 {path}：不是普通 socket")
+        continue
+    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    probe.settimeout(0.5)
+    try:
+        probe.connect(path)
+    except (ConnectionRefusedError, FileNotFoundError):
+        try:
+            os.unlink(path)
+            print(f"已清理无监听者的网关 socket {path}")
+        except OSError as exc:
+            print(f"清理 {path} 失败: {exc}")
+    except OSError as exc:
+        print(f"保留 {path}：{exc}")
+    else:
+        print(f"保留 {path}：仍有监听者")
+    finally:
+        probe.close()
+PYCODE
+}
