+PYCODE
+}
+
+stop_unit() {
+  if ! unit_present; then
+    say "单元 $UNIT 未加载，无需 systemctl stop"
+    return 0
+  fi
+  say "停止 $UNIT ..."
+  systemctl stop "$UNIT"
+}
+
+# 停止 + 显式恢复 + 归属校验。返回 0 仅当「服务已停 且 官方 socket 已验证还原」。
+restore_and_verify() {
+  local stop_rc=0 rec_rc=0
+
+  stop_unit || stop_rc=$?
