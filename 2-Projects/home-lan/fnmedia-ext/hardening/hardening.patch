+        assert after == before[c], "刷新失败不得清空/替换首页"
+    assert cat.status()["content_updated_at"] == content_ts
+    # 榜单仍健康：旧按钮只刷榜单，如实报成功；榜单挂了才报 502 并保留旧榜
+    hot = (await client.post("/v/api/ext/hot/refresh",
