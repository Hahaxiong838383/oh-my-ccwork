+"""受管理更新 + 内容刷新：网页端只排队、只读真实状态，绝不下载/执行。
+
+覆盖真实消费路径（ASGI 全栈，走中间件的管理员/CSRF 校验与真实 handler）：
+  * 管理员 + CSRF 头 → update/now 只写声明式请求（action=check/update），
+    网页进程不推进状态；普通用户/匿名根本无法排队；
+  * 队列去重：请求未处理前重复点击拿到同一个 request_id，不会堆积；
+  * status 字段直接镜像维护 runner 写的 update-status.json（成功/失败/进度都
+    如实透出，缺心跳时 maintenance_online=False），绝不自己编造成功；
+  * 「立即更新内容」按钮：成功返回真实条数；上游失败返回 502 + 真实原因，
+    且旧首页内容保留（content results 不会被清空）。
+"""
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import sys
+import time
+from pathlib import Path
+
+import httpx
+import pytest
+import pytest_asyncio
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "proxy"))
+import app as module
+import catalog as catalogmod
+import charts as chartmod
+import config as configmod
+import content_refresh as refreshmod
+import maintenance_io as mailbox
+import store as storemod
+import updater
+
+
+ADMIN = "admin-test-session"
+SUPER = "user-test-session"
+ADMIN_HEADERS = {"Authorization": ADMIN, "X-Fnmedia-Admin": "1"}
+
+
+_calls: list[tuple[str, str | None]] = []
+_authority = {ADMIN: {"guid": "admin-fixture", "is_admin": 1},
+              SUPER: {"guid": "user-fixture", "is_admin": 0}}
+
+
+async def _official(request):
+    _calls.append((request.url.path, request.headers.get("authorization")))
+    if request.url.path == "/v/api/v1/user/info":
+        user = _authority.get(request.headers.get("authorization"))
+        return httpx.Response(200, json={"code": 0, "data": user} if user
+                              else {"code": 401, "data": None})
+    return httpx.Response(200, json={"code": 401, "msg": "official-untouched",
+                                     "data": None})
+
+
+@pytest_asyncio.fixture
+async def site(tmp_path, monkeypatch):
+    """临时 state / 队列目录 + 假官方会话；不跑 lifespan（不起后台 worker）。"""
+    monkeypatch.setenv("FNMEDIA_STATE_DIR", str(tmp_path))
+    box = tmp_path / "maintenance"
+    box.mkdir()
+    monkeypatch.setenv("FNMEDIA_MAINTENANCE_DIR", str(box))
+    monkeypatch.setattr(configmod, "_STATE", tmp_path / "config.json")
+    monkeypatch.setattr(storemod, "_STATE", tmp_path / "titles.json")
+    monkeypatch.setattr(module.config, "_cfg", copy.deepcopy(module.config.get()))
+    async with httpx.AsyncClient(transport=httpx.MockTransport(_official),
+                                 trust_env=False) as up:
+        module.app.state.up = up
+        async with module.SafeAsyncClient() as ext:
+            module.app.state.ext = ext
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=module.app),
+                                         base_url="https://nas.example") as client:
+                yield client, box
+
+
+# ------------------------------------------------------------------ 假上游
+_CLASSES = [
+    {"type_id": 1, "type_name": "电影", "type_pid": 0},
+    {"type_id": 11, "type_name": "动作片", "type_pid": 1},
+    {"type_id": 21, "type_name": "国产剧", "type_pid": 1},
+    {"type_id": 31, "type_name": "日本动漫", "type_pid": 1},
+    {"type_id": 41, "type_name": "综艺", "type_pid": 1},
+]
+
+
+class _Resp:
+    def __init__(self, payload, status=200):
+        self._payload, self.status_code = payload, status
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f"HTTP {self.status_code}")
+
+    def json(self):
+        return self._payload
+
+
+class FakeUpstream:
+    def __init__(self):
+        self.fail = False
+        self.class_calls = 0
+        self.detail_calls = 0
+
+    def __call__(self, *args, **kwargs):
+        return self
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        return False
+
+    async def aclose(self):
+        return None
+
+    async def get(self, url, params=None, headers=None, timeout=None):
+        params = params or {}
+        if self.fail:
+            raise RuntimeError("upstream down")
+        if params.get("ac") == "list":
+            self.class_calls += 1
+            return _Resp({"code": 1, "class": [dict(c) for c in _CLASSES]})
+        if params.get("ac") == "detail":
+            self.detail_calls += 1
+            tid, pg = params.get("t"), int(params.get("pg") or 1)
+            rows = [{"vod_id": f"{tid}-{pg}-{i}", "vod_name": f"真实片{tid}-{pg}-{i}",
+                     "type_name": "动作片", "vod_year": "2026",
+                     "vod_remarks": "更新至1集",
+                     "vod_pic": f"https://img.example.com/{tid}-{pg}-{i}.jpg",
+                     "vod_time": "2026-10-29 00:00:00", "vod_play_from": "fixture",
+                     "vod_play_url": f"第1集$https://cdn.example.com/{tid}-{pg}-{i}.m3u8"}
+                    for i in range(20)]
+            return _Resp({"code": 1, "pagecount": 50, "list": rows})
+        return _Resp({"code": 0, "list": []})
+
+
+class _Guard:
+    """任何“网页进程自己执行更新”的路径都必须让它炸掉。"""
+
+    def __init__(self, monkeypatch):
+        import os
+        import subprocess
+        self.hits: list[str] = []
+
+        def boom(name):
+            def _f(*a, **k):
+                self.hits.append(name)
+                raise AssertionError(f"网页进程不得执行命令：{name}")
+            return _f
+
+        for name in ("run", "call", "check_call", "check_output", "Popen"):
+            monkeypatch.setattr(subprocess, name, boom(f"subprocess.{name}"))
+        for name in ("system", "popen", "execv", "execve", "execvp", "spawnv"):
+            if hasattr(os, name):
+                monkeypatch.setattr(os, name, boom(f"os.{name}"))
+
+
+# --------------------------------------------------------------- 排队语义
+@pytest.mark.asyncio
+async def test_admin_queues_update_without_executing_it(site, monkeypatch):
+    client, box = site
+    guard = _Guard(monkeypatch)
+
+    # 缺 CSRF 自定义头（跨站可伪造的简单请求）：中间件拒绝，队列为空
+    r = await client.post("/v/api/ext/update/now",
+                          headers={"Authorization": ADMIN}, json={"confirm": True})
+    assert r.status_code == 403
+    assert not (box / "update-request.json").exists()
+
+    # 有 CSRF 头但没有显式确认：路由层仍拒绝
+    r = await client.post("/v/api/ext/update/now",
+                          headers=ADMIN_HEADERS, json={"confirm": False})
+    assert r.json()["code"] == 403
+    assert not (box / "update-request.json").exists()
+
+    r = await client.post("/v/api/ext/update/now",
+                          headers=ADMIN_HEADERS, json={"confirm": True})
+    body = r.json()
+    assert body["code"] == 0 and "排队" in body["msg"]
+    request = json.loads((box / "update-request.json").read_text())
+    assert request["action"] == "update"
+    assert request["id"] == body["request_id"]
+    assert set(request) == {"id", "action", "requested_at", "current_version"}
+    # 只排队：没有任何命令被执行，也没有下载产物落地
+    assert guard.hits == []
+    assert sorted(p.name for p in box.iterdir()) == ["update-request.json"]
+
+    # 重复点击：同一个 request_id，不重复排队
+    again = (await client.post("/v/api/ext/update/now",
+                               headers=ADMIN_HEADERS, json={"confirm": True})).json()
+    assert again["code"] == 0 and again["request_id"] == request["id"]
+
+    st = (await client.get("/v/api/ext/update/status",
+                           headers=ADMIN_HEADERS)).json()
+    assert st["managed_update"] is True and st["self_update_disabled"] is False
+    assert st["pending"] is True
+    assert st["status"] == "waiting"          # 网页进程不会替维护 runner 推进
+    assert st["maintenance_online"] is False  # 无心跳 = 维护服务未连接
+    assert guard.hits == []
+
+
+@pytest.mark.asyncio
+async def test_check_action_and_unknown_action_whitelist(site):
+    client, box = site
+    r = await client.post("/v/api/ext/update/check", headers=ADMIN_HEADERS, json={})
+    assert r.json()["code"] == 0
+    assert json.loads((box / "update-request.json").read_text())["action"] == "check"
+    assert updater.request_action("shell")["code"] == 400
