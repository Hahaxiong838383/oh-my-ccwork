+#!/usr/bin/env python3
+"""content_refresh / catalog / charts 的后台内容更新回归测试。
+
+覆盖真实消费路径（不是 mock 掉业务逻辑）：
+  * worker_loop → content_refresh.refresh → catalog.refresh_all（路由 + 四类首页）
+    与 charts.refresh，全链路真实执行；只在 HTTP 边界注入假上游与临时 state 目录；
+  * 上游整体失败：旧路由、旧首页、旧榜单都不被清空，且失败/重试计划可见；
+  * 手动刷新与后台刷新互斥：并发调用只打一次上游，后来者等同一次结果；
+  * 内容真的变了（不是“刷了路由就算更新”）：首页窗口换成本次上游的新条目；
+  * 榜单单个库拉空时保留旧榜；全失败时保留旧榜并把错误落盘。
+
+运行（无 pytest 也可）：
+    python3 tests/test_content_refresh.py
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+import tempfile
+import time
+import types
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+PROXY = HERE.parent / "proxy"
+if str(PROXY) not in sys.path:
+    sys.path.insert(0, str(PROXY))
+
+ROOT = HERE.parent
+TMP = Path(tempfile.mkdtemp(prefix="fnmedia-content-", dir="/tmp"))
+
+# ---- 在导入业务模块前装好 config 替身：绝不读写仓库里的 state/config.json ----
+_SOURCES = [{"id": "fake01", "name": "假源", "api": "https://fake.example.com/api.php/provide/vod/at/json",
+             "enabled": True, "standalone": False, "builtin": False}]
+_CFG = {"hot_library_enabled": True, "catalog_library_enabled": True,
+        "hot_refresh_interval": 3600, "catalog_refresh_interval": 86400}
+
+
+class _FakeConfig:
+    def get(self):
+        return dict(_CFG)
+
+    def all_sources(self):
+        return [dict(s) for s in _SOURCES]
+
+    def enabled_sources(self):
+        return [dict(s) for s in _SOURCES if s.get("enabled")]
+
+    def is_junk(self, title, remarks=""):
+        return False
+
+
+_fake_cfg_mod = types.ModuleType("config")
+_fake_cfg_mod.config = _FakeConfig()
+# 说明：不在导入期替换 sys.modules["config"]——同一次 pytest 运行里后面的
+# test_security_integration 需要真实 config 模块（_STATE/config 单例）。
+# 业务模块都是“用时再 import config”，所以只在每个用例执行期间注入替身即可。
+
+import catalog as catalogmod  # noqa: E402
+import charts as chartmod  # noqa: E402
+import content_refresh as refreshmod  # noqa: E402
+import store as storemod  # noqa: E402
+
+# 所有落盘都改到临时目录
+storemod._STATE = TMP / "titles.json"
+catalogmod.STATE = TMP / "catalog.json"
+chartmod.STATE = TMP / "charts.json"
+refreshmod.STATE = TMP / "content_refresh.json"
+
+
+# ------------------------------------------------------------------ 假上游
+_CLASSES = [
+    # 父类：必须被当作非叶子丢掉
+    {"type_id": 1, "type_name": "电影", "type_pid": 0},
+    {"type_id": 11, "type_name": "动作片", "type_pid": 1},
+    {"type_id": 21, "type_name": "国产剧", "type_pid": 1},
+    {"type_id": 31, "type_name": "日本动漫", "type_pid": 1},
+    {"type_id": 41, "type_name": "综艺", "type_pid": 1},
+]
+
+
+class _Resp:
+    def __init__(self, payload, status=200):
+        self._payload = payload
+        self.status_code = status
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f"HTTP {self.status_code}")
+
+    def json(self):
+        return self._payload
+
+
+class FakeUpstream:
+    """按 ac=list / ac=detail 返回苹果 CMS 结构；可整体失败、可放慢、可换代。"""
+
+    def __init__(self):
+        self.fail = False
+        self.delay = 0.0
+        self.generation = 1
+        self.class_calls = 0
+        self.detail_calls = 0
+
+    # httpx.AsyncClient 构造签名兼容（SafeAsyncClient(**kw)）
+    def __call__(self, *args, **kwargs):
+        return self
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        return False
+
+    async def aclose(self):
+        return None
+
+    def _vods(self, type_id, page):
+        out = []
+        for i in range(20):
+            vid = f"{self.generation}-{type_id}-{page}-{i}"
+            out.append({
+                "vod_id": vid,
+                "vod_name": f"测试片{vid}",
+                "type_name": "动作片",
+                "vod_year": "2026",
+                "vod_remarks": "更新至1集",
+                "vod_pic": f"https://img.example.com/{vid}.jpg",
+                "vod_time": "2026-10-29 00:00:00",
+                "vod_play_from": "dytt",
+                "vod_play_url": f"第1集$https://cdn.example.com/{vid}.m3u8",
+            })
+        return out
+
+    async def get(self, url, params=None, headers=None, timeout=None):
+        params = params or {}
+        if self.delay:
+            await asyncio.sleep(self.delay)
+        if self.fail:
+            raise RuntimeError("upstream down")
+        ac = params.get("ac")
+        if ac == "list":
+            self.class_calls += 1
+            return _Resp({"code": 1, "class": [dict(c) for c in _CLASSES]})
+        if ac == "detail":
+            self.detail_calls += 1
+            t = params.get("t")
+            pg = int(params.get("pg") or 1)
+            return _Resp({"code": 1, "pagecount": 50, "list": self._vods(t, pg)})
+        return _Resp({"code": 0, "list": []})
+
+
+UPSTREAM = FakeUpstream()
+
+
+class _Case(unittest.TestCase):
+    def setUp(self):
+        UPSTREAM.fail = False
+        UPSTREAM.delay = 0.0
+        UPSTREAM.generation += 1
+        UPSTREAM.class_calls = 0
+        UPSTREAM.detail_calls = 0
+        # 只在本用例执行期间把 config 换成替身（绝不读写仓库 state/config.json）
+        self._saved_config_module = sys.modules.get("config")
+        sys.modules["config"] = _fake_cfg_mod
+        self.addCleanup(self._restore_config_module)
+        for p in (TMP / "catalog.json", TMP / "charts.json",
+                  TMP / "content_refresh.json"):
+            p.unlink(missing_ok=True)
+        old_client = catalogmod.SafeAsyncClient
+        catalogmod.SafeAsyncClient = UPSTREAM
+        self.addCleanup(setattr, catalogmod, "SafeAsyncClient", old_client)
+        self.catalog = catalogmod.Catalog()
+        self.charts = chartmod.ChartCache()
+        old_catalog, old_charts = refreshmod.catalog, refreshmod.chart_cache
+        refreshmod.catalog = self.catalog
+        refreshmod.chart_cache = self.charts
+        self.addCleanup(setattr, refreshmod, "catalog", old_catalog)
+        self.addCleanup(setattr, refreshmod, "chart_cache", old_charts)
+        # 榜单也走假上游：测试不碰外网
+        self.collect_calls = 0
+        self._orig_collect = chartmod.collect_charts
+        self.addCleanup(setattr, chartmod, "collect_charts", self._orig_collect)
+        chartmod.collect_charts = self.fake_collect
+        refreshmod.reset_state(TMP / "content_refresh.json")
+
+    async def fake_collect(self):
+        self.collect_calls += 1
+        return {"updated_at": int(time.time()), "provider_ok": 2,
+                "provider_total": 2, "charts": {
+                    c: [{"guid": f"g-{c}-{i}", "title": f"{c}{i}", "cat": c}
+                        for i in range(2)] for c, _, _ in chartmod.CHART_CATEGORIES}}
+
+    def run_async(self, coro):
+        return asyncio.run(coro)
+
+    def _restore_config_module(self):
+        if self._saved_config_module is None:
+            sys.modules.pop("config", None)
+        else:
+            sys.modules["config"] = self._saved_config_module
+
+    def collect_home(self, cat="movie", limit=22):
+        return self.run_async(self.catalog.get_window(cat, 0, limit))
+
+
+class WorkerPathTest(_Case):
+    def test_worker_refreshes_routes_and_warms_four_home_pages(self):
+        """worker_loop 真实跑一轮：路由建好 + 四类首页各预热 20 条 + 计划可见。"""
+
+        async def scenario():
+            stop = asyncio.Event()
+            task = asyncio.create_task(refreshmod.worker_loop(stop, initial_delay=0))
+            deadline = time.monotonic() + 20
+            while time.monotonic() < deadline:
+                if refreshmod.status()["last_success"]:
+                    break
+                await asyncio.sleep(0.05)
+            stop.set()
+            await task
+
+        self.run_async(scenario())
+        st = refreshmod.status()
+        self.assertTrue(st["ok"], st)
+        self.assertGreater(st["last_success"], 0)
+        self.assertGreater(st["next_due"], time.time())
+        for cat in ("movie", "tv", "anime", "variety"):
+            self.assertTrue(self.catalog.available(cat), f"{cat} 路由未建立")
+            self.assertEqual(st["catalog"]["home"].get(cat), 20)
+            hit = self.catalog._page_cache[("__agg__", cat, 1)]
+            self.assertEqual(len(hit[1]), 20)
+            self.assertTrue(all(f"测试片{UPSTREAM.generation}-" in b["title"]
+                                for b in hit[1]))
+        # 计划/失败/成功都落盘，重启后仍可见
+        saved = json.loads((TMP / "content_refresh.json").read_text())
+        self.assertGreater(saved["last_success"], 0)
+        self.assertEqual(saved["ok"], True)
+        self.assertEqual(self.catalog.status()["last_error"], "")
+        # 只抓了四类首页（4 个分类探测 + 4 次第 1 页），没有整库爬
+        self.assertEqual(UPSTREAM.detail_calls, 8, "更新一轮只应抓四类首页")
+
+    def test_upstream_failure_keeps_previous_routes_pages_and_status(self):
