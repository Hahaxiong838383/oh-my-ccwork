+        self.assertTrue(pid_alive(child), "PID 复用保护失效：误杀了不是我们的进程")
+        self.assertTrue(self.upstream.exists())
+        self.assertEqual(inode(self.upstream), original)
+        os.kill(child, signal.SIGKILL)
+        self.assertTrue(wait_until(lambda: not pid_alive(child), 10))
