diff --git a/proxy/content_refresh.py b/proxy/content_refresh.py
new file mode 100644
index 0000000..e31ba18
--- /dev/null
+++ b/proxy/content_refresh.py
@@ -0,0 +1,424 @@
+#!/usr/bin/env python3
+"""海量库 / 榜单的“每天真正更新内容”调度层。
+
+背景（为什么要这层）：
+- charts.py 只在自己被调用时刷新，catalog.py 的 refresh_routes 只重建分类路由；
+  路由更新 ≠ 影片更新：页缓存/去重缓冲仍是旧条目，媒体库看起来“刷新了”其实没变。
+- 手动“立即刷新”与后台 worker 之前会并发抓同一批上游，且并发时手动请求会拿到
+  “成功”的假象（没有任何数据被更新）。
+
+本模块只做四件事（不新增爬取范围）：
+1. 定时：按 hot_refresh_interval（榜单）/ catalog_refresh_interval（海量库，默认
+   每天）算出 next_due，失败按指数退避，避免打爆上游；
+2. 单飞：手动与后台共用同一次运行，后来者等待同一次结果，绝不并发、绝不假成功；
+3. 真更新：catalog 重建路由后强制重取四类首页（各 1 页 ≈ 20 条），深页仍按需
+   TTL —— 不整库爬；失败保留旧路由与旧首页；
+4. 可见性：成功/失败/下次计划持久化到 state/content_refresh.json，重启后仍可见；
+5. 按部分刷新：配置变化只需重建海量库时用 only={"catalog"}，不会顺手重抓榜单
+   （反之 only={"charts"} 只刷榜），真正的失败原因与条数直接进状态供管理页展示。
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+import charts as chartmod
+from charts import chart_cache
+from catalog import catalog
+
+STATE = Path(__file__).resolve().parent.parent / "state" / "content_refresh.json"
+
+# worker 的最长等待步长（秒）；实际等待取 min(TICK, next_due-now)
+TICK = 30.0
+MIN_INTERVAL = 1800
+DEFAULT_CHART_INTERVAL = 6 * 3600
+# 海量库默认每天更新一次（用户可在配置里调小到 1 小时）
+DEFAULT_CATALOG_INTERVAL = 86400
+MAX_CATALOG_INTERVAL = 7 * 86400
+CATALOG_WARM_BUDGET = 180.0
+
+_LOCK = threading.RLock()
+_META: dict[str, Any] = {
+    "ok": None,
+    "reason": "",
+    "last_success": 0,
+    "last_attempt": 0,
+    "last_error": "",
+    "fail_count": 0,
+    "parts": {},
+}
+_TASK: asyncio.Future | None = None
+
+
+# --------------------------------------------------------------- 配置 / 状态
+def _settings() -> dict:
+    """运行配置；独立函数便于测试注入，不把 config 变成导入期依赖。"""
+    try:
+        from config import config
+        return config.get()
+    except Exception:
+        return {}
+
+
+def _enabled_sources() -> list[dict]:
+    try:
+        from config import config
+        return config.enabled_sources()
+    except Exception:
+        return []
+
+
+def _load() -> None:
+    try:
+        j = json.loads(STATE.read_text())
+    except Exception:
+        return
+    if not isinstance(j, dict):
+        return
+    with _LOCK:
+        for k in ("ok", "reason", "last_error"):
+            if k in j:
+                _META[k] = j[k]
+        for k in ("last_success", "last_attempt", "fail_count"):
+            try:
+                _META[k] = int(j.get(k) or 0)
+            except (TypeError, ValueError):
+                pass
+        if isinstance(j.get("parts"), dict):
+            _META["parts"] = {str(k): v for k, v in j["parts"].items()
+                              if isinstance(v, dict)}
+
+
+def _persist_locked() -> None:
+    payload = json.loads(json.dumps(_META))
+    try:
+        STATE.parent.mkdir(parents=True, exist_ok=True)
+        tmp = STATE.with_suffix(".tmp")
+        tmp.write_text(json.dumps(payload, ensure_ascii=False,
+                                  separators=(",", ":")))
+        tmp.chmod(0o600)
+        tmp.replace(STATE)
+    except Exception:
+        pass
+
+
+def _interval(name: str, cfg: dict) -> float:
+    if name == "charts":
+        try:
+            v = int(cfg.get("hot_refresh_interval") or DEFAULT_CHART_INTERVAL)
+        except (TypeError, ValueError):
+            v = DEFAULT_CHART_INTERVAL
+        return float(max(MIN_INTERVAL, min(86400, v)))
+    try:
+        v = int(cfg.get("catalog_refresh_interval") or DEFAULT_CATALOG_INTERVAL)
+    except (TypeError, ValueError):
+        v = DEFAULT_CATALOG_INTERVAL
+    return float(max(3600, min(MAX_CATALOG_INTERVAL, v)))
+
+
+def _enabled(name: str, cfg: dict) -> bool:
+    if name == "charts":
+        return bool(cfg.get("hot_library_enabled", False))
+    return bool(cfg.get("catalog_library_enabled", False))
+
+
+def _retry_delay(fail_count: int) -> float:
+    try:
+        n = max(0, int(fail_count))
+    except (TypeError, ValueError):
+        n = 0
+    return float(min(3600, 300 * (2 ** min(max(0, n - 1), 4))))
+
+
+def _success_ts(name: str) -> float:
+    """该部分最近一次“内容真的更新成功”的时间戳（0=从未成功）。"""
+    try:
+        st = chart_cache.status() if name == "charts" else catalog.status()
+    except Exception:
+        return 0.0
+    key = "updated_at" if name == "charts" else "content_updated_at"
+    try:
+        return float(st.get(key) or 0)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def _due(name: str, cfg: dict, now: float | None = None) -> bool:
+    """该部分是否到期需要刷新（含启用开关与失败退避）。"""
+    if not _enabled(name, cfg):
+        return False
+    now = time.time() if now is None else now
+    with _LOCK:
+        part = dict((_META.get("parts") or {}).get(name) or {})
+    fails = int(part.get("fail_count") or 0)
+    attempt = float(part.get("last_attempt") or 0)
+    if fails and attempt:
+        return (now - attempt) >= _retry_delay(fails)
+    ts = _success_ts(name)
+    if not ts:
+        return True
+    return (now - ts) >= _interval(name, cfg)
+
+
+def _next_due(cfg: dict, now: float | None = None) -> float:
+    """下一次计划刷新时间（时间戳，0=未启用任何库）。"""
+    now = time.time() if now is None else now
+    dues: list[float] = []
+    for name in ("charts", "catalog"):
+        if not _enabled(name, cfg):
+            continue
+        with _LOCK:
+            part = dict((_META.get("parts") or {}).get(name) or {})
+        fails = int(part.get("fail_count") or 0)
+        attempt = float(part.get("last_attempt") or 0)
+        ts = _success_ts(name)
+        interval = _interval(name, cfg)
+        # 从未成功过 = 立即到期；否则按上次成功时间 + 间隔
+        cand = (ts + interval) if ts else now
+        if fails and attempt:
+            cand = attempt + _retry_delay(fails)
+        dues.append(max(now, cand))
+    return min(dues) if dues else 0.0
+
+
+def _running() -> bool:
+    task = _TASK
+    return bool(task is not None and not task.done())
+
+
+# --------------------------------------------------------------- 刷新执行
+async def _run_once(*, force: bool, reason: str,
+                    only: set[str] | None = None) -> dict[str, Any]:
+    """跑一轮刷新；only 限定本次只处理哪些部分（None=全部）。
+
+    配置变化只需要重建海量库（路由 + 四类首页）时传 only={"catalog"}，
+    避免因为改一个源就顺手把榜单也重抓一遍。
+    """
+    cfg = _settings()
+    now = time.time()
+    parts: dict[str, dict] = {}
+
+    def _wanted(name: str) -> bool:
+        return (only is None or name in only) and _enabled(name, cfg)
+
+    if _wanted("charts") and (force or _due("charts", cfg, now)):
+        try:
+            data = await asyncio.wait_for(
+                chart_cache.refresh(force=True),
+                timeout=chartmod.REFRESH_TIMEOUT + 10)
+            err = str(data.get("last_error") or "")
+            parts["charts"] = {
+                "ok": not err, "error": err,
+                "counts": {c: len((data.get("charts") or {}).get(c) or [])
+                           for c, _, _ in chartmod.CHART_CATEGORIES},
+            }
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            parts["charts"] = {"ok": False,
+                               "error": f"{type(exc).__name__}: {str(exc)[:120]}"}
+
+    if _wanted("catalog") and (force or _due("catalog", cfg, now)):
+        try:
+            res = await asyncio.wait_for(
+                catalog.refresh_all(_enabled_sources(),
+                                    budget=CATALOG_WARM_BUDGET),
+                timeout=CATALOG_WARM_BUDGET + 60)
+            parts["catalog"] = {"ok": bool(res.get("ok")),
+                                "error": str(res.get("error") or ""),
+                                "home": res.get("home") or {}}
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            parts["catalog"] = {"ok": False,
+                                "error": f"{type(exc).__name__}: {str(exc)[:120]}"}
+
+    now = time.time()
+    with _LOCK:
+        for name, p in parts.items():
+            cur = (_META.setdefault("parts", {})).setdefault(name, {})
+            cur["last_attempt"] = int(now)
+            cur["last_error"] = p.get("error") or ""
+            cur["fail_count"] = 0 if p.get("ok") else int(cur.get("fail_count") or 0) + 1
+            cur["ok"] = bool(p.get("ok"))
+            if p.get("home"):
+                cur["home"] = p["home"]
+            if p.get("counts"):
+                # 真实条数落进状态，管理页/接口直接展示，不用自己编
+                cur["counts"] = p["counts"]
+        state = _META.get("parts") or {}
+        enabled = [n for n in ("charts", "catalog") if _enabled(n, cfg)]
+        seen = [state[n] for n in enabled if state.get(n)]
+        ok = all(bool(p.get("ok")) for p in seen) if seen else True
+        if parts:
+            _META["last_attempt"] = int(now)
+            _META["reason"] = reason
+            if ok:
+                _META["last_success"] = int(now)
+                _META["fail_count"] = 0
+            else:
+                _META["fail_count"] = int(_META.get("fail_count") or 0) + 1
+        _META["ok"] = ok if seen else None
+        # 聚合“仍未恢复”的部分错误：别的库坏了也要在管理页看得见
+        _META["last_error"] = "; ".join(
+            f"{n}: {p.get('last_error')}" for n, p in state.items()
+            if p.get("last_error"))
+        _META["skipped"] = not parts
+        _persist_locked()
+    return status()
+
+
+async def refresh(force: bool = True, reason: str = "manual",
+                  only: set[str] | None = None) -> dict[str, Any]:
+    """刷新入口（手动按钮与 worker 共用；单飞，绝不并发）。"""
+    global _TASK
+    with _LOCK:
+        loop = asyncio.get_running_loop()
+        task = _TASK
+        if task is not None and not task.done():
+            try:
+                if task.get_loop() is not loop:
+                    task = None
+            except Exception:
+                task = None
+        owner = task is None or task.done()
+        if owner:
+            task = loop.create_future()
+            _TASK = task
+    if not owner:
+        if task is None:
+            return status()
+        # 已经有刷新在跑：等它（手动/后台互斥），不重复打上游
+        return await asyncio.shield(task)
+
+    result: dict[str, Any] = {}
+    try:
+        result = await _run_once(force=force, reason=reason, only=only)
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        with _LOCK:
+            _META["ok"] = False
+            _META["last_attempt"] = int(time.time())
+            _META["last_error"] = f"{type(exc).__name__}: {str(exc)[:120]}"
+            _META["fail_count"] = int(_META.get("fail_count") or 0) + 1
+            _persist_locked()
+        result = status()
+    finally:
+        if task is not None and not task.done():
+            task.set_result(result if result else status())
+    return result
+
+
+def request_refresh(reason: str = "event", force: bool = True,
+                    only: set[str] | None = None) -> bool:
+    """事件触发（启用海量库/改源）：后台跑一次，不阻塞请求。
+
+    配置变化用 only={"catalog"}（只重建海量库，不顺手重抓榜单）；
+    手动/定时入口用默认 None（按各自到期规则处理）。
+    """
+    if _running():
+        return False
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        return False
+    loop.create_task(refresh(force=force, reason=reason, only=only))
+    return True
+
+
+def status() -> dict[str, Any]:
+    """给管理页/接口看的状态：成功、失败、下次计划一目了然。"""
+    cfg = _settings()
+    now = time.time()
+    with _LOCK:
+        meta = json.loads(json.dumps(_META))
+    running = _running()
+    parts = meta.get("parts") or {}
+    ok = meta.get("ok")
+    if ok is None and parts:
+        ok = all(bool(p.get("ok")) for p in parts.values())
+    next_due = _next_due(cfg, now)
+    return {
+        "ok": ok,
+        "running": running,
+        "reason": meta.get("reason", ""),
+        "skipped": bool(meta.get("skipped")),
+        "last_success": int(meta.get("last_success") or 0),
+        "last_success_text": _fmt(meta.get("last_success")),
+        "last_attempt": int(meta.get("last_attempt") or 0),
+        "last_attempt_text": _fmt(meta.get("last_attempt")),
+        "last_error": meta.get("last_error", ""),
+        "fail_count": int(meta.get("fail_count") or 0),
+        "next_due": int(next_due),
+        "next_due_text": _fmt(next_due),
+        "intervals": {n: int(_interval(n, cfg)) for n in ("charts", "catalog")},
+        "enabled": {n: _enabled(n, cfg) for n in ("charts", "catalog")},
+        "parts": parts,
+        "charts": chart_cache.status(),
+        "catalog": catalog.status(),
+    }
+
+
+def _fmt(ts) -> str:
+    try:
+        ts = int(ts or 0)
+    except (TypeError, ValueError):
+        return ""
+    if not ts:
+        return ""
+    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts))
+
+
+def reset_state(path: Path | None = None) -> None:
+    """测试/排障用：清空内存里的调度状态（不动缓存本身）。"""
+    global _TASK
+    with _LOCK:
+        _META.clear()
+        _META.update({"ok": None, "reason": "", "last_success": 0,
+                      "last_attempt": 0, "last_error": "", "fail_count": 0,
+                      "parts": {}})
+        _TASK = None
+    if path is not None:
+        globals()["STATE"] = Path(path)
+
+
+async def worker_loop(stop_event: asyncio.Event | None = None,
+                      initial_delay: float = 4.0) -> None:
+    """后台循环：到期才刷（各库独立判断），无到期就睡到 next_due。"""
+    if initial_delay:
+        try:
+            if stop_event is None:
+                await asyncio.sleep(initial_delay)
+            else:
+                await asyncio.wait_for(stop_event.wait(), timeout=initial_delay)
+                return
+        except asyncio.TimeoutError:
+            pass
+    while not (stop_event is not None and stop_event.is_set()):
+        cfg = _settings()
+        try:
+            if _due("charts", cfg) or _due("catalog", cfg):
+                await refresh(force=False, reason="auto")
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            pass
+        cfg = _settings()
+        next_due = _next_due(cfg, time.time())
+        wait = max(1.0, min(TICK, next_due - time.time())) if next_due else 60.0
+        if stop_event is None:
+            await asyncio.sleep(wait)
+            continue
+        try:
+            await asyncio.wait_for(stop_event.wait(), timeout=wait)
+            return
+        except asyncio.TimeoutError:
+            continue
+
+
+_load()
