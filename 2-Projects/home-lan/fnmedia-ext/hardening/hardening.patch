+        self.box.write_scenario(sys_version="2.0.1")
+        rc = sup.wait(timeout=30)
+        assert rc != 0, self.box.tail()
+        assert inode(self.box.target) == official_inode
+        assert not self.box.upstream.exists()
+        drift = self.box.status()
+        assert drift["mode"] == "refused"
+        assert drift["reason"] == "upstream_sys_version_changed"
+        assert official.poll() is None, "官方进程不应被扩展杀掉"
+
+    def test_refused_version_keeps_official_entry_and_exits_nonzero(self):
+        self.box.pin_previous_build()
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.write_scenario(config_keys=["initialized"])   # 缺公开协议字段
+        self.box.start_official()
+        official_inode = inode(self.box.target)
+        sup = self.box.start_supervisor()
+        rc = sup.wait(timeout=30)
+        assert rc != 0, self.box.tail()
+        assert inode(self.box.target) == official_inode
+        assert not self.box.upstream.exists()
+        status = self.box.status()
+        assert status["mode"] == "refused"
+        assert status["reason"].startswith("public_contract:")
+
+    def test_pinned_version_takes_over_without_contract_probe(self):
+        self.box.write_scenario(config_keys=[], user_code=0)   # 公开协议完全坏掉
+        self.box.start_official()
+        sup = self.box.start_supervisor()
+        self.wait_takeover(sup)
+        assert self.box.status()["mode"] == "full"
+        sup.send_signal(signal.SIGTERM)
+        assert sup.wait(timeout=20) == 0, self.box.tail()
+
+    def test_target_inode_replacement_exits_nonzero(self):
+        self.box.start_official()
+        sup = self.box.start_supervisor()
+        self.wait_takeover(sup)
