 [Unit]
 Description=fnmedia-ext 在线资源扩展（trim_media.sock 可逆接管）
+# 只做网络就绪排序。官方服务的单元名未核实（trim-media / trim_media / 其他），
+# 因此不写 After=/Requires=/BindsTo= 依赖任何具体官方单元；socket 就绪由
+# supervise.py 按事实轮询等待（FNMEDIA_OFFICIAL_WAIT，默认 60s）。
 After=network.target
-After=trim-media.service
+# 官方升级/重启后要能反复自动复连，因此不设重启频率上限：
+# 每次尝试都会先恢复官方入口、再只读复探；正常 systemctl stop 仍然保持停止
+# （Restart=on-failure + SIGTERM 干净退出 0）。
+StartLimitIntervalSec=0
 
 [Service]
 Type=simple
 User=root
 WorkingDirectory=@ROOT@/proxy
+Environment=PYTHONUNBUFFERED=1
+Environment=FNMEDIA_UPSTREAM_SOCK=/var/run/trim_media_upstream.sock
+# 启动前先做一次带归属校验的恢复：清掉 SIGKILL/OOM 留下的半接管现场。
+# 恢复判断为「归属不明」时返回非 0 → 本单元拒绝启动，绝不半接管。
+ExecStartPre=@ROOT@/.venv/bin/python @ROOT@/proxy/recover.py --role pre-start
 ExecStart=@ROOT@/.venv/bin/python supervise.py
+# systemd 在主进程被 SIGKILL / 超时杀死后仍会执行 ExecStopPost：用同源恢复把
+# 官方 socket 还回原位。显式 systemctl stop 也走这里（幂等）。
+# 这里刻意*不加* "-" 前缀：恢复失败（归属不明 / 无法把官方 socket 还回）时
+# 必须让 systemctl stop 返回非 0、单元状态变 failed，否则停止阶段会静默成功，
+# 官方影视入口长时间缺位却无人告警。调用方（deploy/install.sh、
+# deploy/uninstall.sh、应用中心 cmd/main）都会按归属校验复核现场，并在失败时
+# 保留现场等人工处理；ExecStartPre 同样会拒绝在脏现场上启动。
+ExecStopPost=@ROOT@/.venv/bin/python @ROOT@/proxy/recover.py --role exec-stop-post
+# 仅在异常退出（子进程崩溃、启动失败、官方文件变化、信号杀死）时重启；
+# SIGTERM 干净退出码 0 → 不重启，显式 stop 不会被拉起。
+# 15 秒给官方重启留出窗口，同时让扩展在官方恢复后尽快复连；
+# 重试次数不设上限，由 StartLimitIntervalSec=0 取消频率限制。
+Restart=on-failure
+RestartSec=15
+KillSignal=SIGTERM
 KillMode=mixed
 TimeoutStopSec=25
-Restart=no
-UMask=0022
-Environment=PYTHONUNBUFFERED=1
-Environment=FNMEDIA_UPSTREAM_SOCK=/var/run/trim_media_upstream.sock
+UMask=0077
+NoNewPrivileges=true
+# 真机验证：capability 全空时 /proc/<official-pid>/exe 返回 PermissionError。
+# 仅监督/恢复进程保留进程身份读取所需能力；HTTP/桌面子进程在 exec 前
+# capset 清空 effective/permitted/inheritable 并启用 no_new_privs。
+CapabilityBoundingSet=CAP_SYS_PTRACE
+RestrictSUIDSGID=true
+ReadOnlyPaths=-/var/apps/trim.media -/usr/trim -/usr/local/apps/@appdata/trim.media
+ProtectSystem=full
+ProtectHome=true
+PrivateTmp=true
+RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
+Environment=FNMEDIA_COMPAT_LOCK=@ROOT@/compatibility.json
+# 与维护 runner 共享的非敏感兼容状态（mode/version/reason/checked_at）。
+Environment=FNMEDIA_MAINTENANCE_DIR=/var/lib/fnmedia-ext-maintenance
 
 [Install]
 WantedBy=multi-user.target
