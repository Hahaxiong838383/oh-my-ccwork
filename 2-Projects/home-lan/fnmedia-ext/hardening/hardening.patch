@@ -0,0 +1,610 @@
+#!/usr/bin/env python3
+"""兼容判定与自动复连测试：全部使用真实 Unix domain socket 与真实进程。
+
+覆盖：
+  * 已钉版本直连（不依赖公开协议探针）；
+  * 官方新版本 -> probation（公开协议探针通过），签名 sys/config 确实被发送；
+  * 同版本摘要变化 / 部分升级（manifest 新、二进制旧）/ 公开协议漂移 -> 拒绝；
+  * 运行摘要 != 磁盘摘要（升级只写了一半或被替换） -> 拒绝；
+  * supervise.py 在恢复之后才判定；拒绝时不接管且官方入口不变；
+  * 接管期间每 reprobe 秒复探 upstream，漂移/入口 inode 被替换 -> 非 0 退出并还原；
+  * compatibility-status.json 由 maintenance_io.write 落盘，只含非敏感字段。
+
+“官方”监听者通过复制解释器为 trim-media 得到真实 /proc/<pid>/exe 路径；
+socket 由该进程自己绑定并服务，peer pid 也就是它。
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import socket
+import subprocess
+import sys
+import sysconfig
+import tempfile
+import threading
+import time
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+PROXY = ROOT / "proxy"
+sys.path.insert(0, str(PROXY))
+
+import compatibility_runtime as runtime  # noqa: E402
+from compatibility import STATUS_NAME, CompatibilityGuard, publish  # noqa: E402
+
+PY = Path(sys.executable)
+REAL_PY = Path(os.path.realpath(sys.executable))
+# 复制解释器后必须告诉它 stdlib 在哪（build-tree /install 前缀不可用）。
+INTERP_HOME = str(Path(sysconfig.get_path("stdlib")).parent.parent)
+OFFICIAL = "trim-media"
+
+DEFAULT_SCENARIO = {
+    "sys_version": "2.0.0",
+    "mediasrv_version": "2.0.0",
+    "config_keys": ["initialized", "nas_oauth", "supported_languages"],
+    "user_code": -2,
+}
+
+OFFICIAL_SRC = r'''
+import json, os, signal, socket, sys
+target, scenario = sys.argv[1], sys.argv[2]
+def bye(*_a):
+    os._exit(0)
+signal.signal(signal.SIGTERM, bye)
+try:
+    os.unlink(target)
+except FileNotFoundError:
+    pass
+srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+srv.bind(target)
+srv.listen(32)
+os.chmod(target, 0o666)
+print("READY", flush=True)
+
+def load():
+    with open(scenario, encoding="utf-8") as stream:
+        return json.load(stream)
+
+def reply(conn, status, payload):
+    body = json.dumps(payload).encode("utf-8")
+    head = ("HTTP/1.0 %d OK\r\nContent-Type: application/json\r\n"
+            "Content-Length: %d\r\nConnection: close\r\n\r\n" % (status, len(body)))
+    conn.sendall(head.encode("latin1") + body)
+
+while True:
+    try:
+        conn, _ = srv.accept()
+    except OSError:
+        continue
+    try:
+        conn.settimeout(2)
+        raw = b""
+        while b"\r\n\r\n" not in raw:
+            chunk = conn.recv(4096)
+            if not chunk:
+                break
+            raw += chunk
+        lines = raw.split(b"\r\n\r\n", 1)[0].decode("latin1").split("\r\n")
+        method, path = lines[0].split(" ")[:2]
+        headers = {}
+        for line in lines[1:]:
+            if ":" in line:
+                key, value = line.split(":", 1)
+                headers[key.strip().lower()] = value.strip()
+        cfg = load()
+        clean = path.split("?", 1)[0]
+        if clean == "/v/api/v1/sys/version":
+            reply(conn, 200, {"code": 0, "data": {
+                "version": cfg["sys_version"],
+                "mediasrvVersion": cfg["mediasrv_version"]}})
+        elif clean == "/v/api/v1/sys/config":
+            if not headers.get("authx"):
+                reply(conn, 200, {"code": -1, "msg": "missing authx"})
+            else:
+                data = {key: True for key in cfg["config_keys"]}
+                reply(conn, 200, {"code": 0, "data": data})
+        elif clean == "/v/api/v1/user/info":
+            code = int(cfg["user_code"])
+            reply(conn, 200, {"code": code,
+                              "data": {"guid": "0" * 32} if code == 0 else None})
+        else:
+            reply(conn, 404, {"code": 404})
+    except Exception:
+        pass
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+'''
+
+PROXY_CHILD_SRC = r'''
+import os, signal, socket, sys
+path = sys.argv[1]
+def bye(*_a):
+    os._exit(0)
+signal.signal(signal.SIGTERM, bye)
+try:
+    os.unlink(path)
+except FileNotFoundError:
+    pass
+srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+srv.bind(path)
+srv.listen(32)
+os.chmod(path, 0o666)
+print("READY", flush=True)
+while True:
+    try:
+        conn, _ = srv.accept()
+    except OSError:
+        continue
+    try:
+        conn.settimeout(2)
+        conn.recv(8192)
+        body = b'{"ok":true}'
+        conn.sendall(b"HTTP/1.0 200 OK\r\nContent-Type: application/json\r\n"
+                     b"Content-Length: %d\r\n\r\n%s" % (len(body), body))
+    except Exception:
+        pass
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+'''
+
+INTRUDER_SRC = r'''
+import os, socket, sys
+path = sys.argv[1]
+try:
+    os.unlink(path)
+except FileNotFoundError:
+    pass
+srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+srv.bind(path)
+srv.listen(8)
+print("READY", flush=True)
+while True:
+    try:
+        conn, _ = srv.accept()
+    except OSError:
+        continue
+    conn.close()
+'''
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def wait_until(predicate, timeout=20.0, interval=0.05) -> bool:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        time.sleep(interval)
+    return False
+
+
+def http_get(sock: Path, timeout=2.0) -> bytes:
+    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    client.settimeout(timeout)
+    try:
+        client.connect(str(sock))
+        client.sendall(b"GET /_ext/healthz HTTP/1.0\r\nHost: x\r\n\r\n")
+        data = b""
+        while True:
+            chunk = client.recv(4096)
+            if not chunk:
+                break
+            data += chunk
+        return data
+    finally:
+        client.close()
+
+
+def inode(path: Path) -> tuple[int, int]:
+    st = os.lstat(path)
+    return st.st_dev, st.st_ino
+
+
+class Sandbox:
+    """真实官方监听者 + 可热切换的公开协议响应。"""
+
+    def __init__(self):
+        self.dir = Path(tempfile.mkdtemp(prefix="fnx-compat-", dir="/tmp"))
+        self.run_dir = self.dir / "run"
+        self.run_dir.mkdir()
+        self.state_dir = self.dir / "state"
+        self.mailbox = self.dir / "mailbox"
+        self.mailbox.mkdir()
+        self.target = self.run_dir / "trim_media.sock"
+        self.upstream = self.run_dir / "trim_media_upstream.sock"
+        self.binary = self.dir / OFFICIAL
+        shutil.copy2(REAL_PY, self.binary)
+        os.chmod(self.binary, 0o755)
+        self.manifest = self.dir / "manifest"
+        self.manifest.write_text('version="1.0"\n', encoding="utf-8")
+        self.scenario = self.dir / "scenario.json"
+        self.write_scenario()
+        self.spec_path = self.dir / "compatibility.json"
+        self.write_spec()
+        self.procs: list[subprocess.Popen] = []
+        self._logs: list = []
+        self.official_script = self.dir / "official.py"
+        self.official_script.write_text(OFFICIAL_SRC, encoding="utf-8")
+        self.proxy_child = self.dir / "proxy_child.py"
+        self.proxy_child.write_text(PROXY_CHILD_SRC, encoding="utf-8")
+        self.intruder_script = self.dir / "intruder.py"
+        self.intruder_script.write_text(INTRUDER_SRC, encoding="utf-8")
+
+    def close(self):
+        for proc in reversed(self.procs):
+            if proc.poll() is None:
+                try:
+                    proc.kill()
+                except OSError:
+                    pass
+        for proc in self.procs:
+            try:
+                proc.wait(timeout=5)
+            except Exception:
+                pass
+        for handle in self._logs:
+            try:
+                handle.close()
+            except OSError:
+                pass
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    # -------------------------------------------------------------- 配置
+
+    def write_scenario(self, **changes):
+        scenario = dict(DEFAULT_SCENARIO)
+        scenario.update(changes)
+        self.scenario.write_text(json.dumps(scenario), encoding="utf-8")
+
+    def write_spec(self, *, version="1.0", sha=None, allow_probation=True, **extra):
+        spec = {
+            "version": version,
+            "executable": str(self.binary),
+            "manifest": str(self.manifest),
+            "sha256": sha or sha256(self.binary),
+            "official_names": [OFFICIAL],
+        }
+        if allow_probation:
+            spec["policy"] = {"allow_probation": True, "reprobe_seconds": 30,
+                              "probe_timeout": 1}
+        spec.update(extra)
+        self.spec_path.write_text(json.dumps(spec), encoding="utf-8")
+
+    def pin_previous_build(self, version="1.0"):
+        """钉住一个“上一版”摘要：磁盘/运行中的二进制才是真升级后的新版本。"""
+        self.write_spec(version=version,
+                        sha=hashlib.sha256(b"previous-official-build").hexdigest())
+
+    def env(self, **extra) -> dict[str, str]:
+        env = os.environ.copy()
+        env.update({
+            "FNMEDIA_TARGET_SOCK": str(self.target),
+            "FNMEDIA_UPSTREAM_SOCK": str(self.upstream),
+            "FNMEDIA_STATE_DIR": str(self.state_dir),
+            "FNMEDIA_COMPAT_LOCK": str(self.spec_path),
+            "FNMEDIA_OFFICIAL_EXE": OFFICIAL,
+            "FNMEDIA_MAINTENANCE_DIR": str(self.mailbox),
+            "FNMEDIA_GATEWAY": "off",
+            "FNMEDIA_OFFICIAL_WAIT": "8",
+            "FNMEDIA_HEALTH_TIMEOUT": "6",
+            "FNMEDIA_KILL_TIMEOUT": "4",
+            "FNMEDIA_CHILD_CMD": json.dumps(
+                [str(PY), str(self.proxy_child), "{staged}"]),
+            "FNMEDIA_COMPAT_REPROBE": "2",
+            "FNMEDIA_COMPAT_TIMEOUT": "1",
+            "PYTHONUNBUFFERED": "1",
+        })
+        env.update(extra)
+        return env
+
+    # -------------------------------------------------------------- 进程
+
+    def spawn(self, argv, *, env=None, log: str = "out.log",
+              cwd: Path | None = None) -> subprocess.Popen:
+        handle = open(self.dir / log, "ab")
+        self._logs.append(handle)
+        proc = subprocess.Popen(argv, stdout=handle, stderr=subprocess.STDOUT,
+                                env=env or self.env(), cwd=str(cwd or self.dir))
+        self.procs.append(proc)
+        return proc
+
+    def start_official(self) -> subprocess.Popen:
+        env = os.environ.copy()
+        env.update({"PYTHONHOME": INTERP_HOME, "PYTHONUNBUFFERED": "1"})
+        proc = self.spawn([str(self.binary), str(self.official_script),
+                           str(self.target), str(self.scenario)],
+                          env=env, log="official.log")
+        assert wait_until(lambda: self.alive(self.target), 15), self.tail("official.log")
+        return proc
+
+    def start_supervisor(self) -> subprocess.Popen:
+        return self.spawn([str(PY), str(PROXY / "supervise.py")],
+                          log="supervise.log", cwd=PROXY)
+
+    def start_intruder(self, path: Path) -> subprocess.Popen:
+        proc = self.spawn([str(PY), str(self.intruder_script), str(path)],
+                          log="intruder.log")
+        assert wait_until(lambda: self.alive(path), 10), self.tail("intruder.log")
+        return proc
+
+    def alive(self, path: Path) -> bool:
+        if not path.exists():
+            return False
+        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        client.settimeout(0.5)
+        try:
+            client.connect(str(path))
+            return True
+        except OSError:
+            return False
+        finally:
+            client.close()
+
+    def serving(self, marker: str) -> bool:
+        try:
+            return marker.encode() in http_get(self.target, timeout=1.0)
+        except OSError:
+            return False
+
+    def tail(self, name: str = "supervise.log", limit: int = 40) -> str:
+        path = self.dir / name
+        if not path.exists():
+            return ""
+        return "\n".join(path.read_text(encoding="utf-8", errors="replace")
+                         .splitlines()[-limit:])
+
+    def status(self) -> dict:
+        path = self.mailbox / STATUS_NAME
+        assert path.exists(), "兼容状态文件未写入"
+        return json.loads(path.read_text(encoding="utf-8"))
+
+    def guard(self, **overrides) -> CompatibilityGuard:
+        if overrides:
+            self.write_spec(**overrides)
+        return CompatibilityGuard(self.spec_path)
+
+
+# ------------------------------------------------------------------ 传输层
+
+class TestRuntimeHttp:
+    def test_chunked_json_response_is_decoded(self, tmp_path):
+        path = tmp_path / "chunked.sock"
+        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        server.bind(str(path))
+        server.listen(4)
+        body = b'{"code":0,"data":{"ok":true}}'
+
+        def serve():
+            try:
+                conn, _ = server.accept()
+                conn.recv(8192)
+                frames = b""
+                for start in range(0, len(body), 7):
+                    piece = body[start:start + 7]
+                    frames += b"%x\r\n%s\r\n" % (len(piece), piece)
+                frames += b"0\r\n\r\n"
+                conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
+                             b"Transfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
+                             + frames)
+                conn.close()
+            finally:
+                server.close()
+
+        worker = threading.Thread(target=serve, daemon=True)
+        worker.start()
+        response = runtime.get(path, "/v/api/v1/sys/version", timeout=3)
+        worker.join(5)
+        assert response.status == 200
+        assert json.loads(response.body) == {"code": 0, "data": {"ok": True}}
+
+
+# ------------------------------------------------------------------ 判定
+
+class TestDecision:
+    def setup_method(self):
+        self.box = Sandbox()
+
+    def teardown_method(self):
+        self.box.close()
+
+    def test_pinned_version_is_direct_even_if_public_contract_is_broken(self):
+        self.box.write_scenario(config_keys=["initialized"], user_code=0)
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "full" and decision.allowed
+        assert decision.reason == "pinned" and decision.version == "1.0"
+
+    def test_new_version_with_public_contract_enters_probation(self):
+        self.box.pin_previous_build()
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "probation" and decision.allowed, decision.reason
+        assert decision.version == "2.0"
+        assert decision.sys_version == "2.0.0"
+        assert decision.mediasrv_version == "2.0.0"
+        assert decision.reason == "probation_public_contract"
+
+    def test_probation_requires_signed_config_route(self):
+        # 缺 supported_languages 才能让公开协议失败：证明签名请求确实得到了 code 0。
+        self.box.pin_previous_build()
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.write_scenario(config_keys=["initialized", "nas_oauth"])
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "refused"
+        assert "sys_config_missing_supported_languages" in decision.reason
+
+    def test_same_version_content_changed_is_refused(self):
+        self.box.write_spec(sha="0" * 64)   # 运行/磁盘一致，但与钉住摘要不同
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "refused"
+        assert decision.reason == "same_version_content_changed"
+
+    def test_partial_upgrade_manifest_new_binary_old_is_refused(self):
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "refused"
+        assert decision.reason == "partial_upgrade_binary_not_replaced"
+
+    def test_public_contract_drift_is_refused(self):
+        self.box.pin_previous_build()
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.write_scenario(user_code=0)   # 匿名能拿到 user/info
+        self.box.start_official()
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "refused"
+        assert decision.reason == "public_contract:user_info_anonymous_accepted"
