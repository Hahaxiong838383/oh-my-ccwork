+    def test_replaced_binary_on_disk_is_refused(self):
+        # 升级把磁盘文件原子替换掉：运行中的旧二进制变成 (deleted)，
+        # 运行摘要与磁盘摘要必然不同，此时绝不接受接管。
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
+        self.box.start_official()
+        replacement = self.box.dir / "replacement"
+        replacement.write_bytes(b"not-the-running-binary")
+        os.replace(replacement, self.box.binary)
+        decision = self.box.guard().assess(self.box.target)
+        assert decision.mode == "refused" and not decision.allowed
+        assert decision.reason == "listener_not_official"
+        assert "running_binary_deleted" in decision.checks
+
+    def test_foreign_listener_is_refused(self):
+        self.box.manifest.write_text('version="2.0"\n', encoding="utf-8")
