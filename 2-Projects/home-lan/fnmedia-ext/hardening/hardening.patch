+设计要点
+--------
+* 身份只经 ContextVar 传递：由入口中间件在**验证会话之后**调用
+  ``bind_user(user_id)``，并在请求结束时 ``reset_user(token)``。
+  本模块不读 Cookie / Header，也不做任何认证判断——它只承载已经验证过的
+  用户 ID；未绑定身份时 ``current_user_id()`` 为 ``None``。
+* 失败关闭：业务模块（history / marks）在无身份时一律返回“无数据/未写入”，
+  绝不回退到共享 bucket，也不产生任何文件。
+* 落盘路径 = ``state/users/<sha256(user_id)>/{history,marks}.json``：
+  目录 0700、文件 0600、同目录临时文件 + ``os.replace`` 原子替换。
+  路径只用摘要，既避免路径穿越，也不在磁盘上暴露原始用户 ID。
+* 旧版共享文件（state/history.json、state/marks.json）不自动归属任何用户，
+  首次访问时移入 ``state/legacy-quarantine/`` 隔离留档。
+
+集成 API（供 app.py 中间件使用）
+--------------------------------
+    import user_scope
+
+    token = user_scope.bind_user(verified_user_id)   # 验证成功后
+    try:
+        ...
+    finally:
+        user_scope.reset_user(token)                 # 请求结束
+
+也可用上下文管理器::
+
+    with user_scope.user_scope(verified_user_id):
+        ...
+
+只读查询::
+
+    user_scope.current_user_id()      # str | None
+    user_scope.require_user_id()      # str，缺失抛 MissingUserScope
+"""
+from __future__ import annotations
+
+import contextlib
+import contextvars
+import hashlib
+import json
+import logging
+import os
+import threading
+import time
+import uuid
+from pathlib import Path
+from typing import Any, Callable, Iterator
+
+_log = logging.getLogger("fnmedia.user_scope")
+
+#: 仅用于测试/私有部署重定位 state 根目录；默认仍是 <repo>/state。
+STATE_ENV = "FNMEDIA_STATE_DIR"
+DEFAULT_STATE_ROOT = Path(__file__).resolve().parent.parent / "state"
+USERS_DIRNAME = "users"
+QUARANTINE_DIRNAME = "legacy-quarantine"
+_MAX_USER_ID_LEN = 256
+
+_DIR_MODE = 0o700
+_FILE_MODE = 0o600
+
+
+class MissingUserScope(RuntimeError):
+    """当前上下文没有已验证用户身份；调用方必须按“无数据”失败关闭。"""
+
+
+# --------------------------------------------------------------------------
+# 身份 ContextVar
+# --------------------------------------------------------------------------
+_current_user: contextvars.ContextVar[str | None] = contextvars.ContextVar(
+    "fnmedia_verified_user_id", default=None)
+
+
+def _validate_user_id(user_id: str) -> str:
+    if not isinstance(user_id, str):
+        raise ValueError("user_id must be str")
+    if not user_id or user_id != user_id.strip():
+        raise ValueError("user_id must be non-empty without surrounding space")
+    if len(user_id) > _MAX_USER_ID_LEN:
+        raise ValueError("user_id too long")
+    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in user_id):
+        raise ValueError("user_id contains control characters")
+    return user_id
+
+
+def bind_user(user_id: str) -> contextvars.Token:
+    """绑定已验证用户 ID 到当前上下文，返回用于 reset 的 token。"""
+    return _current_user.set(_validate_user_id(user_id))
+
+
+def reset_user(token: contextvars.Token) -> None:
+    """恢复 bind_user 之前的身份（必须配对调用）。"""
+    _current_user.reset(token)
+
+
+@contextlib.contextmanager
+def user_scope(user_id: str) -> Iterator[str]:
+    token = bind_user(user_id)
+    try:
+        yield user_id
+    finally:
+        reset_user(token)
+
+
+#: 兼容别名，语义与 user_scope / bind_user 完全一致。
+scoped_user = user_scope
+
+
+def current_user_id() -> str | None:
+    return _current_user.get()
+
+
+def require_user_id() -> str:
+    uid = _current_user.get()
+    if uid is None:
+        raise MissingUserScope("verified user identity is not bound")
+    return uid
+
+
+#: 简短别名，便于中间件书写。
+bind = bind_user
+reset = reset_user
+current_user = current_user_id
+
+
+# --------------------------------------------------------------------------
+# 路径与文件（私有权限 + 原子里写）
+# --------------------------------------------------------------------------
+def state_root() -> Path:
+    raw = os.environ.get(STATE_ENV, "").strip()
+    return Path(raw).expanduser() if raw else DEFAULT_STATE_ROOT
+
+
+def user_key(user_id: str) -> str:
+    """用户 ID 的单向摘要，仅用作目录名。"""
+    return hashlib.sha256(_validate_user_id(user_id).encode("utf-8")).hexdigest()
+
+
+def ensure_private_dir(path: Path) -> Path:
+    path = Path(path)
+    path.mkdir(parents=True, exist_ok=True)
+    with contextlib.suppress(OSError):
+        os.chmod(path, _DIR_MODE)
+    return path
+
+
+def user_dir(user_id: str, *, create: bool = False) -> Path:
+    base = state_root() / USERS_DIRNAME
+    if create:
+        base = ensure_private_dir(base)
+    path = base / user_key(user_id)
+    return ensure_private_dir(path) if create else path
+
+
+def user_state_path(user_id: str, filename: str) -> Path:
+    return user_dir(user_id, create=True) / filename
+
+
+def _fsync_dir(path: Path) -> None:
+    with contextlib.suppress(OSError):
+        fd = os.open(path, os.O_RDONLY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+
+
+def atomic_write_json(path: Path, payload: Any) -> None:
+    """写 JSON：同目录临时文件（0600）→ fsync → os.replace，目标 0600。"""
+    path = Path(path)
+    ensure_private_dir(path.parent)
+    blob = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+    tmp = path.parent / (
+        f".{path.name}.{os.getpid()}.{threading.get_ident()}."
+        f"{uuid.uuid4().hex}.tmp")
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, _FILE_MODE)
+    try:
+        with os.fdopen(fd, "wb") as fh:
+            fh.write(blob)
+            fh.flush()
+            os.fsync(fh.fileno())
+        with contextlib.suppress(OSError):
+            os.chmod(tmp, _FILE_MODE)
+        os.replace(tmp, path)
+        with contextlib.suppress(OSError):
+            os.chmod(path, _FILE_MODE)
+        _fsync_dir(path.parent)
+    except BaseException:
+        with contextlib.suppress(OSError):
+            tmp.unlink()
+        raise
+
+
+def load_json_file(path: Path, default: Any) -> Any:
+    """只读加载；失败返回 default（不抛异常、不创建文件）。"""
+    try:
+        with open(path, "rb") as fh:
+            return json.loads(fh.read().decode("utf-8"))
+    except (OSError, ValueError, UnicodeDecodeError):
+        return default
+
+
+# --------------------------------------------------------------------------
+# 旧版共享状态：隔离，绝不自动归属
+# --------------------------------------------------------------------------
+def quarantine_legacy(src: Path) -> Path | None:
+    """把旧共享文件移入 legacy-quarantine/，返回新路径（不存在则 None）。
+
+    仅移动、不读取、不导入、不分配给任何用户；内容原样留档供人工处置。
+    """
+    src = Path(src)
+    if not src.is_symlink() and not src.exists():
+        return None
+    qdir = ensure_private_dir(state_root() / QUARANTINE_DIRNAME)
+    stamp = time.strftime("%Y%m%d-%H%M%S")
+    suffix = src.suffix or ".json"
+    dst = qdir / f"{src.stem}.{stamp}{suffix}"
+    n = 1
+    while dst.exists():
+        dst = qdir / f"{src.stem}.{stamp}.{n}{suffix}"
+        n += 1
+    try:
+        os.replace(src, dst)
+        with contextlib.suppress(OSError):
+            os.chmod(dst, _FILE_MODE)
+    except OSError as exc:  # 隔离失败也不能回退成共享读取
+        _log.warning("legacy state quarantine failed for %s: %s", src, exc)
+        return None
+    _log.warning("legacy shared state quarantined (not assigned to any user): "
+                 "%s -> %s", src, dst)
+    return dst
+
+
+_prepared_lock = threading.Lock()
+_prepared: set[tuple[str, tuple[str, ...]]] = set()
+
+
+def prepare_state_root(*legacy_names: str) -> Path:
+    """每个 state 根目录只做一次旧文件隔离（按文件名集合幂等）。"""
+    root = state_root()
+    key = (str(root), tuple(sorted(legacy_names)))
+    with _prepared_lock:
+        if key in _prepared:
+            return root
+        for name in legacy_names:
+            with contextlib.suppress(Exception):
+                quarantine_legacy(root / name)
+        _prepared.add(key)
+    return root
+
+
+# --------------------------------------------------------------------------
+# 每用户存储注册表
+# --------------------------------------------------------------------------
+class StoreRegistry:
+    """按 (state 根, 用户摘要) 复用同一份内存 store，串行化 flush。"""
+
+    def __init__(self, factory: Callable[[str], Any]):
+        self._factory = factory
+        self._lock = threading.RLock()
+        self._stores: dict[tuple[str, str], Any] = {}
+
+    def get(self, user_id: str) -> Any:
+        user_id = _validate_user_id(user_id)
+        key = (str(state_root()), user_key(user_id))
+        with self._lock:
+            store = self._stores.get(key)
+            if store is None:
+                store = self._factory(user_id)
+                self._stores[key] = store
+            return store
+
+    def all(self) -> list[Any]:
+        with self._lock:
+            return list(self._stores.values())
+
+    def flush_all(self) -> None:
+        for store in self.all():
+            try:
+                store.flush()
+            except Exception:  # 单个用户落盘失败不影响其他用户/关停
+                _log.warning("per-user store flush failed", exc_info=True)
+
+    def clear(self) -> None:
+        """丢弃内存缓存（模拟进程重启；下次访问从磁盘重载）。"""
+        with self._lock:
+            self._stores.clear()
+
+    def __len__(self) -> int:
+        with self._lock:
+            return len(self._stores)
