+"""官方影视兼容判定：已钉版直连；官方新版进入试用；其余拒绝。
+
+判定（全部满足才算通过）
+------------------------
+``full``       运行中的官方二进制摘要 == ``compatibility.json`` 钉住的 sha256，
+               manifest 版本 == 钉住版本，完整 exe 路径/监听者身份一致，
+               运行摘要 == 磁盘摘要。
+``probation``  manifest 版本已变（真升级）且运行摘要 != 钉住摘要（不是半写入），
+               完整 exe 路径/监听者身份一致、运行摘要 == 磁盘摘要，
+               且公开协议探针（未登录 ``sys/version`` + 签名 ``sys/config`` +
+               签名 ``user/info`` 仍要求登录）全部通过。**这只是试用**，
+               不代表登录态接口兼容；接管后需定期复探 upstream。
+``refused``    其余情况（同版本摘要变了、只升级了一半、公开协议漂移、
+               监听者不是官方进程等）。调用方必须保持官方入口不动。
+
+检查顺序约束
+------------
+兼容检查必须发生在 ``recover.py`` 的归属恢复 **之后**：恢复前 target 可能还是
+上次 SIGKILL 留下的本代理 socket，此时看到的监听者根本不是官方进程。
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import compatibility_runtime as runtime  # noqa: E402  (同目录模块)
+
+STATUS_NAME = "compatibility-status.json"
+DEFAULT_REPROBE_SECONDS = 60.0
+DEFAULT_PROBE_TIMEOUT = 3.0
+
+MODES = ("full", "probation", "refused")
+
+
+def log(message: str) -> None:
+    print(f"[fnmedia-compat] {message}", flush=True)
+
+
+@dataclass(frozen=True)
+class Decision:
+    mode: str
+    allowed: bool
+    version: str | None
+    reason: str
+    checks: tuple[str, ...] = ()
+    identity: runtime.Identity | None = None
+    sha256: str | None = None
+    sys_version: str | None = None
+    mediasrv_version: str | None = None
+
+    @property
+    def message(self) -> str:
+        if self.mode == "full":
+            return f"已接管（官方 {self.version}，版本已钉住）"
+        if self.mode == "probation":
+            return (f"试用接管（官方 {self.version} 为新版本，公开协议通过；"
+                    "登录态接口尚未验证）")
+        return f"保持官方入口（{self.reason}）"
+
+    def payload(self) -> dict[str, Any]:
+        """写进维护邮箱的非敏感状态：mode/version/reason/checked_at + 展示文案。"""
+        return {
+            "mode": self.mode,
+            "version": self.version or "",
+            "reason": self.reason,
+            "checked_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+            "message": self.message,
+        }
+
+
+class CompatibilityGuard:
+    """读取 ``compatibility.json``，对 target/upstream 做一次或多次只读判定。"""
+
+    def __init__(self, lock_path: str | os.PathLike[str] | None = None):
+        value = lock_path or os.environ.get("FNMEDIA_COMPAT_LOCK") \
+            or Path(__file__).resolve().parents[1] / "compatibility.json"
+        self.path = Path(value)
+        self.spec = json.loads(self.path.read_text(encoding="utf-8"))
+        if not isinstance(self.spec, dict):
+            raise ValueError(f"{self.path} 不是 JSON 对象")
+        self.stamps: list[tuple[int, int, int, int, int]] | None = None
+
+    # -------------------------------------------------------------- 配置
+
+    def _paths(self) -> list[Path]:
+        return [Path(str(self.spec["executable"])), Path(str(self.spec["manifest"]))]
+
+    def _stamp(self) -> list[tuple[int, int, int, int, int]] | None:
+        stamps = []
+        for path in self._paths():
+            stamp = runtime.file_stamp(path)
+            if stamp is None:
+                return None
+            stamps.append(stamp)
+        return stamps
+
+    def changed(self) -> bool:
+        """自上次 assess 以来官方文件是否被动过（stat 级，含 inode/ctime）。"""
+        if self.stamps is None:
+            return True
+        try:
+            return self._stamp() != self.stamps
+        except OSError:
+            return True
+
+    @property
+    def official_names(self) -> tuple[str, ...]:
+        raw = self.spec.get("official_names")
+        if isinstance(raw, list) and raw:
+            return tuple(str(item) for item in raw if str(item).strip())
+        executable = str(self.spec.get("executable") or "")
+        name = os.path.basename(executable)
+        return (name,) if name else runtime.DEFAULT_OFFICIAL_NAMES
+
+    def _policy(self) -> dict[str, Any]:
+        raw = self.spec.get("policy")
+        return raw if isinstance(raw, dict) else {}
+
+    @property
+    def allow_probation(self) -> bool:
+        return bool(self._policy().get("allow_probation", False))
+
+    @property
+    def reprobe_seconds(self) -> float:
+        raw: Any = os.environ.get("FNMEDIA_COMPAT_REPROBE")
+        if raw is None or not str(raw).strip():
+            raw = self._policy().get("reprobe_seconds", DEFAULT_REPROBE_SECONDS)
+        try:
+            value = float(raw)
+        except (TypeError, ValueError):
+            value = DEFAULT_REPROBE_SECONDS
+        return max(1.0, value)
+
+    @property
+    def probe_timeout(self) -> float:
+        raw: Any = os.environ.get("FNMEDIA_COMPAT_TIMEOUT")
+        if raw is None or not str(raw).strip():
+            raw = self._policy().get("probe_timeout", DEFAULT_PROBE_TIMEOUT)
+        try:
+            value = float(raw)
+        except (TypeError, ValueError):
+            value = DEFAULT_PROBE_TIMEOUT
+        return min(max(value, 0.2), 30.0)
+
+    # -------------------------------------------------------------- 判定
+
+    def _refuse(self, reason: str, version: str | None = None, *,
+                checks: tuple[str, ...] = (),
+                identity: runtime.Identity | None = None,
+                sha256: str | None = None) -> Decision:
+        return Decision("refused", False, version, reason, checks, identity, sha256)
+
+    def assess(self, socket_path: str | os.PathLike[str]) -> Decision:
+        """对 target 的官方监听者做一次完整判定（只读、无写入副作用）。"""
+        spec = self.spec
+        try:
+            executable = str(spec["executable"])
+            manifest = str(spec["manifest"])
+            pinned_version = spec.get("version")
+        except KeyError as exc:
+            return self._refuse(f"spec_missing:{exc}")
+        if not isinstance(pinned_version, str) or not pinned_version.strip():
+            return self._refuse("spec_version_invalid")
+        pinned_sha = runtime.valid_sha256(spec.get("sha256"))
+        if pinned_sha is None:
+            return self._refuse("spec_sha256_invalid")
+
+        before = self._stamp()
+        if before is None:
+            return self._refuse("spec_files_unreadable")
+
+        identity = runtime.identify(socket_path, expected_exe=executable,
+                                    official_names=self.official_names)
+        self.stamps = before
+        if not identity.is_official:
+            return self._refuse("listener_not_official", pinned_version,
+                                checks=identity.problems, identity=identity)
+        running = (identity.running_sha256 or "").lower()
+        if not running or running != (identity.disk_sha256 or "").lower() \
+                or not identity.same_inode:
+            # 官方正在升级/被原子替换：旧进程还在服务，不能据此接受。
+            return self._refuse("running_binary_differs_from_disk", pinned_version,
+                                checks=("running_sha_ne_disk_sha",), identity=identity,
+                                sha256=running or None)
+
+        version = runtime.manifest_version(manifest)
+        if not version:
+            return self._refuse("manifest_version_unreadable", pinned_version,
+                                identity=identity, sha256=running)
+        if self._stamp() != before:
+            return self._refuse("official_files_changed_during_probe", version,
+                                identity=identity, sha256=running)
+
+        if version == pinned_version:
+            if running != pinned_sha:
+                # 同版本但二进制变了：半写入、被替换或篡改，绝不放行。
+                return self._refuse("same_version_content_changed", version,
+                                    identity=identity, sha256=running)
+            return Decision("full", True, version, "pinned",
+                            ("digest_pinned", "listener_official"), identity,
+                            running)
+
+        if running == pinned_sha:
+            # manifest 已是新版本，但运行/磁盘还是旧二进制：典型的部分升级。
+            return self._refuse("partial_upgrade_binary_not_replaced", version,
+                                identity=identity, sha256=running)
+
+        if not self.allow_probation:
+            return self._refuse("probation_disabled", version,
+                                identity=identity, sha256=running)
+
+        contract = runtime.public_contract(socket_path, timeout=self.probe_timeout)
+        if not contract.ok:
+            reason = contract.reasons[0] if contract.reasons else "public_contract_failed"
+            return self._refuse(f"public_contract:{reason}", version,
+                                checks=contract.reasons, identity=identity,
+                                sha256=running)
+
+        current = runtime.identify(socket_path, expected_exe=executable,
+                                   official_names=self.official_names)
+        if (current.pid != identity.pid or current.starttime != identity.starttime
+                or (current.running_sha256 or "").lower() != running
+                or current.problems):
+            return self._refuse("listener_changed_during_probe", version,
+                                checks=current.problems, identity=current,
+                                sha256=running)
+        if self._stamp() != before:
+            return self._refuse("official_files_changed_during_probe", version,
+                                identity=current, sha256=running)
+        return Decision("probation", True, version, "probation_public_contract",
+                        tuple(f"public_contract:{item}" for item in contract.reasons)
+                        or ("public_contract_ok",),
+                        current, running, contract.sys_version,
+                        contract.mediasrv_version)
+
+    def recheck(self, socket_path: str | os.PathLike[str],
+                accepted: Decision) -> Decision | None:
+        """接管期间的定期复探；返回 None 表示无漂移。"""
+        if self.changed() or accepted.identity is None:
+            return self._refuse("official_files_changed", accepted.version,
+                                identity=accepted.identity, sha256=accepted.sha256)
+        identity = runtime.identify(socket_path,
+                                    expected_exe=str(self.spec.get("executable") or ""),
+                                    official_names=self.official_names)
+        if not identity.is_official:
+            return self._refuse("upstream_listener_not_official", accepted.version,
+                                checks=identity.problems, identity=identity,
+                                sha256=accepted.sha256)
+        if (identity.pid != accepted.identity.pid
+                or identity.starttime != accepted.identity.starttime):
+            return self._refuse("upstream_listener_replaced", accepted.version,
+                                identity=identity, sha256=accepted.sha256)
+        running = (identity.running_sha256 or "").lower()
+        if not running or running != (accepted.sha256 or "") \
+                or running != (identity.disk_sha256 or "").lower() \
+                or not identity.same_inode:
+            return self._refuse("upstream_binary_changed", accepted.version,
+                                identity=identity, sha256=running or None)
+        version = runtime.manifest_version(str(self.spec.get("manifest") or ""))
+        if version != accepted.version:
+            return self._refuse("manifest_version_changed", version,
+                                identity=identity, sha256=running)
+
+        if accepted.mode == "probation":
+            contract = runtime.public_contract(socket_path, timeout=self.probe_timeout)
+            if not contract.ok:
+                reason = contract.reasons[0] if contract.reasons else "public_contract_failed"
+                return self._refuse(f"upstream_public_contract:{reason}",
+                                    accepted.version, checks=contract.reasons,
+                                    identity=identity, sha256=running)
+            if (contract.sys_version != accepted.sys_version
+                    or contract.mediasrv_version != accepted.mediasrv_version):
+                return self._refuse("upstream_sys_version_changed", accepted.version,
+                                    identity=identity, sha256=running)
+        return None
+
+
+def publish(decision: Decision) -> bool:
+    """把复连状态写进维护邮箱（非敏感）。失败只返回 False，绝不影响接管。"""
+    payload = decision.payload()
+    try:
+        try:
+            import maintenance_io
+        except ImportError:
+            sys.path.insert(0, str(Path(__file__).resolve().parent))
+            import maintenance_io
+        maintenance_io.write(STATUS_NAME, payload)
+        return True
+    except (OSError, ValueError) as exc:
+        log(f"兼容状态写入失败（不影响接管）: {type(exc).__name__}: {exc}")
+        return False
