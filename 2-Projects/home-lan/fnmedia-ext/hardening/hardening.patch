+#!/usr/bin/env python3
+"""fnmedia-ext 接管恢复测试：全部使用真实 Unix domain socket 与真实进程终止。
+
+覆盖的核心故障场景（v0.2.17 遗留缺陷）：
+  * supervisor 被 SIGKILL / OOM 后的半接管现场（target=我们或空，upstream=官方）
+  * 子进程随 supervisor 崩溃 / 子进程不响应 SIGTERM（需 SIGKILL）
+  * 换名前后任意阶段被 SIGTERM（暂存阶段、健康检查阶段）
+  * 官方 socket 被第三方/官方自己重新绑定 → 绝不能 unlink 存活替换者
+  * 无状态记录的陈旧 upstream、target 是符号链接、状态目录权限
+  * 恢复幂等（ExecStartPre / ExecStopPost 会重复调用）
+
+不使用 mock：官方监听者、接管子进程、第三方监听者都是真实独立进程，
+"官方"身份通过复制解释器为 trim-media 得到真实 /proc/<pid>/exe 路径。
+
+运行：
+  /tmp/fnmedia-ext-review-20261028/venv/bin/python -m unittest discover -s tests -v
+"""
+from __future__ import annotations
+
+import json
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import signal
+import socket
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+PROXY = ROOT / "proxy"
+PY = Path(sys.executable)
+REAL_PY = Path(os.path.realpath(sys.executable))
+OFFICIAL = "trim-media"
+
+
+# ------------------------------------------------------------------ 辅助进程源码
+
+OFFICIAL_SRC = r'''
+import os, signal, socket, sys
+path = sys.argv[1]
+try:
+    os.unlink(path)
+except FileNotFoundError:
+    pass
+srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+srv.bind(path)
+srv.listen(32)
+def bye(*_a):
+    os._exit(0)
+signal.signal(signal.SIGTERM, bye)
+print("READY", flush=True)
+while True:
+    try:
+        conn, _ = srv.accept()
+    except OSError:
+        continue
+    try:
+        conn.settimeout(2)
+        conn.recv(8192)
+        conn.sendall(b"HTTP/1.0 200 OK\r\n\r\nofficial")
+    except Exception:
+        pass
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+'''
+
+PROXY_CHILD_SRC = r'''
+import os, signal, socket, sys, time
+path = sys.argv[1]
+mode = sys.argv[2] if len(sys.argv) > 2 else "healthy"
+if "ignore-term" in mode:
+    signal.signal(signal.SIGTERM, signal.SIG_IGN)
+else:
+    def bye(*_a):
+        os._exit(0)
+    signal.signal(signal.SIGTERM, bye)
+try:
+    os.unlink(path)
+except FileNotFoundError:
+    pass
+srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+srv.bind(path)
+srv.listen(32)
+os.chmod(path, 0o666)
+print("READY", flush=True)
+if mode.startswith("silent"):   # 绑定但永不响应健康检查
+    time.sleep(600)
+    raise SystemExit(0)
+while True:
+    try:
+        conn, _ = srv.accept()
+    except OSError:
+        continue
+    try:
+        conn.settimeout(2)
+        conn.recv(8192)
+        conn.sendall(b"HTTP/1.0 200 OK\r\n\r\nproxy {\"ok\":true}")
+    except Exception:
+        pass
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+'''
+
+INTRUDER_SRC = r'''
+import os, signal, socket, sys
+path = sys.argv[1]
+try:
+    os.unlink(path)
+except FileNotFoundError:
+    pass
+srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+srv.bind(path)
+srv.listen(32)
+print("READY", flush=True)
+while True:
+    try:
+        conn, _ = srv.accept()
+    except OSError:
+        continue
+    try:
+        conn.settimeout(2)
+        conn.recv(8192)
+        conn.sendall(b"HTTP/1.0 200 OK\r\n\r\nintruder")
+    except Exception:
+        pass
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+'''
+
+
+def wait_until(predicate, timeout=20.0, interval=0.05):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return True
+        time.sleep(interval)
+    return False
+
+
+def http_get(path: Path, timeout=2.0) -> bytes:
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    try:
+        sock.connect(str(path))
+        sock.sendall(b"GET /_ext/healthz HTTP/1.0\r\nHost: x\r\n\r\n")
+        data = b""
+        while True:
+            chunk = sock.recv(4096)
+            if not chunk:
+                break
+            data += chunk
+        return data
+    finally:
+        sock.close()
+
+
+def recovery_peer_live(path: Path) -> bool:
+    """路径上是否有活监听者（connect 成功即认为有）。"""
+    if not path.exists():
+        return False
+    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    sock.settimeout(1.0)
+    try:
+        sock.connect(str(path))
+        return True
+    except OSError:
+        return False
+    finally:
+        sock.close()
+
+
+def inode(path: Path):
+    st = os.lstat(path)
+    return st.st_dev, st.st_ino
+
+
+def pid_alive(pid: int) -> bool:
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as fh:
+            data = fh.read()
+    except OSError:
+        return False
+    return data[data.rfind(b")") + 2:].split()[0] != b"Z"
+
+
+class Base(unittest.TestCase):
+    def setUp(self) -> None:
+        self.dir = Path(tempfile.mkdtemp(prefix="fnx-", dir="/tmp"))
+        self.run_dir = self.dir / "run"
+        self.run_dir.mkdir()
+        self.state_dir = self.dir / "state"
+        self.target = self.run_dir / "trim_media.sock"
+        self.upstream = self.run_dir / "trim_media_upstream.sock"
+        self.staged = self.state_dir / "listen.sock"
+        self.state_file = self.state_dir / "takeover.json"
+        self.procs: list[subprocess.Popen] = []
+        self.extra_pids: list[int] = []
+        self._logfhs: list = []
+        self.log_path = self.dir / "supervise.log"
+
+        self.official_bin = self.dir / OFFICIAL
+        shutil.copy2(REAL_PY, self.official_bin)   # 真实 /proc/<pid>/exe 名 = trim-media
+        os.chmod(self.official_bin, 0o755)
+        manifest = self.dir / "manifest"
+        manifest.write_text('version="fixture"\n')
+        self.compat_lock = self.dir / "compatibility.json"
+        self.compat_lock.write_text(json.dumps({"executable": str(self.official_bin),
+            "manifest": str(manifest), "version": "fixture",
+            "sha256": hashlib.sha256(self.official_bin.read_bytes()).hexdigest()}))
+        self._write_scripts()
+
+    def tearDown(self) -> None:
+        for proc in reversed(self.procs):
+            if proc.poll() is None:
+                try:
+                    proc.kill()
+                except OSError:
+                    pass
+        for proc in self.procs:
+            try:
+                proc.wait(timeout=5)
+            except Exception:
+                pass
+        for pid in self.extra_pids:
+            if pid_alive(pid):
+                try:
+                    os.kill(pid, signal.SIGKILL)
+                except OSError:
+                    pass
+        for fh in self._logfhs:
+            try:
+                fh.close()
+            except OSError:
+                pass
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    # -------------------------------------------------------------- 环境
+
+    def _write_scripts(self) -> None:
+        for name, src in (("official.py", OFFICIAL_SRC),
+                          ("proxy_child.py", PROXY_CHILD_SRC),
+                          ("intruder.py", INTRUDER_SRC)):
+            path = self.dir / name
+            path.write_text(src, encoding="utf-8")
+
+    def env(self, **extra: str) -> dict[str, str]:
+        mode = extra.pop("child_mode", "healthy")
+        child_cmd = [str(PY), str(self.dir / "proxy_child.py"), "{staged}"]
+        if mode != "healthy":
+            child_cmd.append(mode)
+        env = os.environ.copy()
+        env.update({
+            "FNMEDIA_TARGET_SOCK": str(self.target),
+            "FNMEDIA_UPSTREAM_SOCK": str(self.upstream),
+            "FNMEDIA_STATE_DIR": str(self.state_dir),
+            "FNMEDIA_COMPAT_LOCK": str(self.compat_lock),
+            "FNMEDIA_OFFICIAL_EXE": OFFICIAL,
+            "FNMEDIA_OFFICIAL_WAIT": "10",
+            "FNMEDIA_HEALTH_TIMEOUT": "8",
+            "FNMEDIA_KILL_TIMEOUT": "4",
+            "FNMEDIA_GATEWAY": "off",
+            "FNMEDIA_CHILD_CMD": json.dumps(child_cmd),
+            "PYTHONUNBUFFERED": "1",
+        })
+        env.update(extra)
+        return env
+
+    # -------------------------------------------------------------- 进程
+
+    def spawn(self, argv, env=None, log=None):
+        out = open(log, "ab") if log else subprocess.DEVNULL
+        if log:
+            self._logfhs.append(out)
+        proc = subprocess.Popen(argv, stdout=out, stderr=subprocess.STDOUT,
+                                env=env or self.env(), cwd=str(PROXY))
+        self.procs.append(proc)
+        return proc
+
+    def start_official(self) -> subprocess.Popen:
+        proc = self.spawn([str(self.official_bin), str(self.dir / "official.py"),
+                           str(self.target)], log=self.dir / "official.log")
+        self.assertTrue(wait_until(lambda: self.is_up("official"), 15),
+                        f"官方监听者未就绪\n{self.log_tail('official.log')}")
+        return proc
+
+    def start_supervisor(self, **env_extra) -> subprocess.Popen:
+        if not self.log_path.exists():
+            self.log_path.write_text("", encoding="utf-8")
+        return self.spawn([str(PY), str(PROXY / "supervise.py")],
+                          env=self.env(**env_extra), log=self.log_path)
+
+    def start_intruder(self, path: Path) -> subprocess.Popen:
+        proc = self.spawn([str(PY), str(self.dir / "intruder.py"), str(path)],
+                          log=self.dir / "intruder.log")
+        self.assertTrue(wait_until(lambda: self.is_up("intruder", path), 15),
+                        f"第三方监听者未就绪\n{self.log_tail('intruder.log')}")
+        return proc
+
+    def run_recover(self, role: str = "manual", **env_extra) -> subprocess.CompletedProcess:
+        return subprocess.run([str(PY), str(PROXY / "recover.py"), "--role", role],
+                              env=self.env(**env_extra), cwd=str(PROXY),
+                              capture_output=True, text=True, timeout=90)
+
+    def state(self) -> dict:
+        return json.loads(self.state_file.read_text(encoding="utf-8"))
+
+    def child_pid(self) -> int:
+        pid = int(self.state()["child"]["pid"])
+        self.extra_pids.append(pid)
+        return pid
+
+    # -------------------------------------------------------------- 断言辅助
+
+    def is_up(self, marker: str, path: Path | None = None) -> bool:
+        path = path or self.target
+        if not path.exists():
+            return False
+        try:
+            return marker.encode() in http_get(path, timeout=1.0)
+        except OSError:
+            return False
+
+    def log_tail(self, name: str = "supervise.log", limit: int = 60) -> str:
+        path = self.dir / name
+        if not path.exists():
+            return ""
+        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
+        return "\n".join(lines[-limit:])
+
+    def wait_takeover(self, proc: subprocess.Popen) -> None:
+        ok = wait_until(lambda: self.is_up("proxy") and self.upstream.exists(), 30)
+        self.assertTrue(ok, f"接管未完成 rc={proc.poll()}\n{self.log_tail()}")
+
+    def assert_official_restored(self, original_inode) -> None:
+        self.assertTrue(self.target.exists(), f"target 丢失\n{self.log_tail()}")
+        self.assertEqual(stat.S_ISSOCK(os.lstat(self.target).st_mode), True)
+        self.assertEqual(inode(self.target), original_inode, "target 不是原来的官方 inode")
+        self.assertFalse(self.upstream.exists(), "upstream 未清理")
+        self.assertTrue(self.is_up("official"), "官方 socket 不可用")
+        self.assertFalse(self.state_file.exists(), "接管状态未清理")
+
+
+# ------------------------------------------------------------------ 用例
+
+class TakeoverLifecycle(Base):
+    def test_sigterm_restores_official_and_cleans_state(self):
+        self.start_official()
+        original = inode(self.target)
+        sup = self.start_supervisor()
+        self.wait_takeover(sup)
+
+        # 接管期间：upstream 持有官方 inode，target 是我们自己的 socket
+        self.assertEqual(inode(self.upstream), original)
+        self.assertNotEqual(inode(self.target), original)
+        self.assertTrue(self.is_up("proxy"))
+
+        sup.send_signal(signal.SIGTERM)
+        self.assertEqual(sup.wait(timeout=25), 0, f"SIGTERM 未干净退出\n{self.log_tail()}")
+        self.assert_official_restored(original)
+
+    def test_child_crash_rolls_back_and_exits_nonzero(self):
+        self.start_official()
+        original = inode(self.target)
+        sup = self.start_supervisor()
+        self.wait_takeover(sup)
+
+        child = self.child_pid()
+        os.kill(child, signal.SIGKILL)   # 模拟子进程崩溃
+        rc = sup.wait(timeout=25)
+        self.assertNotEqual(rc, 0, "子进程崩溃后应非 0 退出（交给 systemd 重启）")
+        self.assert_official_restored(original)
+
+    def test_official_target_socket_mode_is_world_accessible(self):
+        self.start_official()
+        sup = self.start_supervisor()
+        self.wait_takeover(sup)
+        mode = stat.S_IMODE(os.lstat(self.target).st_mode)
+        self.assertEqual(mode, 0o666)
+        sup.send_signal(signal.SIGTERM)
+        sup.wait(timeout=25)
+
+
+class SigkillRecovery(Base):
+    """覆盖 v0.2.17 的核心事故：supervisor 被 SIGKILL / OOM 打断。"""
+
+    def _sigkill_after_takeover(self):
+        self.start_official()
+        original = inode(self.target)
+        sup = self.start_supervisor()
+        self.wait_takeover(sup)
+        self.assertTrue(self.state_file.exists())
+        child = self.child_pid()
+        os.kill(sup.pid, signal.SIGKILL)
+        sup.wait(timeout=10)
+        return original, child
+
+    def test_execstop_recovery_restores_official_socket(self):
+        original, child = self._sigkill_after_takeover()
+        # 子进程随 supervisor 死亡（PR_SET_PDEATHSIG），target 上只剩死 socket
+        self.assertTrue(wait_until(lambda: not pid_alive(child), 10),
+                        "子进程未随 supervisor 退出")
+
+        result = self.run_recover("exec-stop-post")
+        self.assertEqual(result.returncode, 0, f"恢复失败: {result.stdout}{result.stderr}")
+        self.assert_official_restored(original)
+        # 官方进程本身从未被杀：还是同一个 pid/inode
+        self.assertIn("已把官方 socket 恢复到", result.stdout)
+
+    def test_surviving_child_ignoring_sigterm_is_killed_before_restore(self):
+        self.start_official()
+        original = inode(self.target)
+        sup = self.start_supervisor(child_mode="ignore-term")
+        self.wait_takeover(sup)
+        child = self.child_pid()
+        os.kill(sup.pid, signal.SIGKILL)
+        sup.wait(timeout=10)
+        time.sleep(0.5)
+        self.assertTrue(pid_alive(child), "前置条件：子进程忽略了 PDEATHSIG 的 SIGTERM")
+        self.assertTrue(self.is_up("proxy"), "前置条件：遗留子进程仍在服务")
+
+        result = self.run_recover("pre-start")
+        self.assertEqual(result.returncode, 0, f"恢复失败: {result.stdout}{result.stderr}")
+        self.assertTrue(wait_until(lambda: not pid_alive(child), 10), "遗留子进程未被清理")
+        self.assert_official_restored(original)
+
+    def test_recovery_is_idempotent(self):
+        original, _child = self._sigkill_after_takeover()
+        first = self.run_recover()
+        self.assertEqual(first.returncode, 0, first.stdout + first.stderr)
+        second = self.run_recover("pre-start")
+        self.assertEqual(second.returncode, 0, second.stdout + second.stderr)
+        self.assertEqual(inode(self.target), original)
+        self.assertIn("无需恢复", second.stdout)
+
+    def test_staging_phase_sigkill_leaves_official_untouched(self):
+        """健康检查永远不通过时 SIGKILL：target 还是官方，恢复只清状态。"""
+        self.start_official()
+        original = inode(self.target)
+        sup = self.start_supervisor(child_mode="silent")
