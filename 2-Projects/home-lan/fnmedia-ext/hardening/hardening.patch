@@ -0,0 +1,34 @@
+"""Small non-secret mailbox shared with the administrator's maintenance runner."""
+from pathlib import Path
+import json
+import os
+import tempfile
+
+
+def directory():
+    return Path(os.environ.get('FNMEDIA_MAINTENANCE_DIR', '/var/lib/fnmedia-ext-maintenance'))
+
+
+def read(name, default=None):
+    try:
+        path = directory() / name
+        if path.stat().st_size > 262144:
+            return default
+        value = json.loads(path.read_text())
+        return value if isinstance(value, dict) else default
+    except (OSError, ValueError):
+        return default
+
+
+def write(name, value):
+    parent = directory()
+    fd, temporary = tempfile.mkstemp(prefix='.fnmedia-', dir=parent)
+    try:
+        with os.fdopen(fd, 'w') as stream:
+            json.dump(value, stream, ensure_ascii=False)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.chmod(temporary, 0o660)
+        os.replace(temporary, parent / name)
+    finally:
+        if os.path.exists(temporary): os.unlink(temporary)
