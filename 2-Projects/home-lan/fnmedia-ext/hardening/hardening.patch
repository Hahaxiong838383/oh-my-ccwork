+"""Authorize extensions against the official media session, without changing it."""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from http.cookies import SimpleCookie, CookieError
+from urllib.parse import urlsplit
+
+import httpx
+from starlette.requests import Request
+from starlette.responses import HTMLResponse, JSONResponse
+
+import user_scope
+from fnmedia_authx import make_authx
+
+USER_INFO = "/v/api/v1/user/info"
+SAFE_METHODS = {"GET", "HEAD", "OPTIONS"}
+
+
+@dataclass(frozen=True)
+class Principal:
+    uid: str
+    admin: bool
+
+
+class AuthUnavailable(RuntimeError):
+    pass
+
+
+def session_token(headers) -> str:
+    # A supplied invalid header must never fall back to a different cookie.
+    supplied = headers.get("authorization")
+    if supplied is not None:
+        token = supplied[7:] if supplied.lower().startswith("bearer ") else supplied
+    else:
+        values = []
+        for header in headers.getlist("cookie"):
+            for part in header.split(";"):
+                key, separator, value = part.strip().partition("=")
+                if key == "Trim-MC-token" and separator:
+                    cookie = SimpleCookie()
+                    try:
+                        cookie.load(part.strip())
+                        values.append(cookie[key].value)
+                    except (CookieError, KeyError):
+                        return ""
+        if len(set(values)) > 1:
+            return ""
+        token = values[0] if values else ""
+    if not token or len(token) > 8192 or any(ord(c) < 33 or ord(c) > 126 for c in token):
+        return ""
+    return token
+
+
+async def authenticate(client: httpx.AsyncClient, token: str) -> Principal | None:
+    if not token:
+        return None
+    signature, _ = make_authx("GET", USER_INFO)
+    try:
+        response = await client.get("http://localhost" + USER_INFO,
+            headers={"Authorization": token, "authx": signature},
+            timeout=5, follow_redirects=False)
+        if response.status_code >= 500:
+            raise AuthUnavailable("official session service unavailable")
+        if response.status_code != 200 or len(response.content) > 65536:
+            return None
+        payload = response.json()
+        if type(payload.get("code")) is not int or payload["code"] != 0:
+            return None
+        data = payload.get("data")
+        if not isinstance(data, dict) or data.get("is_banned") not in (None, False, 0):
+            return None
+        uid = data.get("guid")
+        if not isinstance(uid, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", uid):
+            return None
+        admin = data.get("is_admin")
+        return Principal(uid, (type(admin) is bool and admin) or (type(admin) is int and admin == 1))
+    except httpx.HTTPError as exc:
+        raise AuthUnavailable("official session service unavailable") from exc
+    except (ValueError, TypeError, AttributeError):
+        return None
+
+
+def is_extension(path: str) -> bool:
+    return (path == "/v/online-admin" or path.startswith("/v/api/ext/")
+            or path.startswith("/v/media/online/") or path.startswith("/online/")
+            or path.startswith("/v/api/v1/sys/img/online/"))
+
+
+def is_management(path: str) -> bool:
+    return path == "/v/online-admin" or path.startswith("/v/api/ext/")
+
+
+def csrf_allowed(request: Request) -> bool:
+    site = request.headers.get("sec-fetch-site", "")
+    if site in {"cross-site", "same-site"}:
+        return False
+    origin = request.headers.get("origin")
+    if origin:
+        try:
+            parsed = urlsplit(origin)
+            host = urlsplit("//" + request.headers.get("host", ""))
+            # Official nginx passes $host (without port). Modern browsers prove
+            # the complete origin through the forbidden-to-JS Fetch Metadata
+            # header; older clients must match the full authority and scheme.
+            valid = (parsed.scheme in {"http", "https"} and not parsed.username
+                     and not parsed.password and not parsed.path and not parsed.query
+                     and not parsed.fragment and parsed.hostname == host.hostname)
+            if site != "same-origin":
+                valid = valid and parsed.netloc.lower() == host.netloc.lower() and parsed.scheme == request.url.scheme
+        except ValueError:
+            return False
+        if not valid:
+            return False
+    return request.headers.get("x-fnmedia-admin") == "1"
+
+
+class SessionMiddleware:
+    """Pure ASGI wrapper keeps identity alive for the entire streamed response."""
+    def __init__(self, app, api_app, forward):
+        self.app, self.api_app, self.forward = app, api_app, forward
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http":
+            return await self.app(scope, receive, send)
+        request = Request(scope, receive)
+        path = scope["path"]
+        extension = is_extension(path)
+        # Login/static/ordinary media endpoints preserve the official behavior.
+        intercepted = extension or path.startswith("/v/api/v1/")
+        if not intercepted:
+            return await self.app(scope, receive, send)
+        token = session_token(request.headers)
+        try:
+            principal = await authenticate(self.api_app.state.up, token)
+        except AuthUnavailable:
+            response = JSONResponse({"code": 503, "msg": "影视会话服务暂时不可用，请稍后重试"}, status_code=503)
+            response.headers["Cache-Control"] = "no-store"
+            return await response(scope, receive, send)
+        if principal is None:
+            if not extension:
+                response = await self.forward(request)
+            elif path == "/v/online-admin":
+                response = HTMLResponse('<!doctype html><meta charset="utf-8"><title>登录飞牛影视</title>'
+                    '<p>请先使用管理员账号登录飞牛影视，再打开扩展管理。</p><a href="/v/" target="_top">打开飞牛影视</a>',
+                    status_code=401)
+            else:
+                response = JSONResponse({"code": 401, "msg": "请先登录飞牛影视"}, status_code=401)
+            response.headers["Cache-Control"] = "no-store"
+            return await response(scope, receive, send)
+        if is_management(path) and not principal.admin:
+            response = JSONResponse({"code": 403, "msg": "需要影视管理员权限"}, status_code=403)
+            return await response(scope, receive, send)
+        if is_management(path) and request.method not in SAFE_METHODS and not csrf_allowed(request):
+            response = JSONResponse({"code": 403, "msg": "管理请求来源校验失败"}, status_code=403)
+            return await response(scope, receive, send)
+        scope.setdefault("state", {})["verified_user"] = principal
+        marker = user_scope.bind_user(principal.uid)
+        try:
+            async def guarded_send(message):
+                if message["type"] == "http.response.start" and is_management(path):
+                    headers = [(k, v) for k, v in message.get("headers", [])
+                               if k.lower() not in {b"cache-control", b"access-control-allow-origin"}]
+                    headers += [(b"cache-control", b"no-store"), (b"x-content-type-options", b"nosniff")]
+                    message = {**message, "headers": headers}
+                await send(message)
+            await self.app(scope, receive, guarded_send)
+        finally:
+            user_scope.reset_user(marker)
