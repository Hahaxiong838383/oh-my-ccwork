{
  "name": "server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS=--experimental-sqlite NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= ALL_PROXY= tsx --env-file=.env.local src/index.ts",
    "start:debug": "DEBUG_ASR=1 NODE_OPTIONS=--experimental-sqlite NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= ALL_PROXY= tsx --env-file=.env.local src/index.ts",
    "probe:xfyun": "node --env-file=.env.local scripts/xfyun-tts-probe.mjs",
    "probe:gemini": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= node --env-file=.env.local scripts/gemini-probe.mjs",
    "probe:volc-asr": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= node --env-file=.env.local scripts/volc-asr-probe.mjs",
    "probe:volc-tts": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= node --env-file=.env.local scripts/volc-tts-probe.mjs",
    "test:expr": "tsx scripts/expression-filter.test.ts",
    "test:exit": "tsx scripts/exit-intent.test.ts",
    "test:onboarding": "tsx scripts/onboarding-extractor.test.ts",
    "test:sms": "NODE_OPTIONS=--experimental-sqlite tsx scripts/sms-auth.test.ts",
    "test:ota": "NODE_OPTIONS=--experimental-sqlite tsx scripts/ota.test.ts",
    "test:device-config": "NODE_OPTIONS=--experimental-sqlite tsx scripts/device-config.test.ts",
    "test:pairing": "NODE_OPTIONS=--experimental-sqlite tsx scripts/pairing.test.ts",
    "test:interests": "NODE_OPTIONS=--experimental-sqlite tsx scripts/interests.test.ts",
    "test:telemetry": "NODE_OPTIONS=--experimental-sqlite tsx scripts/telemetry.test.ts",
    "test:persona": "NODE_OPTIONS=--experimental-sqlite tsx scripts/persona-state.test.ts",
    "test:local-audio": "NODE_OPTIONS=--experimental-sqlite tsx scripts/local-audio.test.ts",
    "test:memory-extract": "NODE_OPTIONS=--experimental-sqlite tsx scripts/memory-extract.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@volcengine/openapi": "^1.36.2",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
