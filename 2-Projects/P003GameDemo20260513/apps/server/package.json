{
  "name": "server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= ALL_PROXY= tsx --env-file=.env.local src/index.ts",
    "start:debug": "DEBUG_ASR=1 NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= ALL_PROXY= tsx --env-file=.env.local src/index.ts",
    "probe:xfyun": "node --env-file=.env.local scripts/xfyun-tts-probe.mjs",
    "probe:gemini": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= node --env-file=.env.local scripts/gemini-probe.mjs",
    "probe:volc-asr": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= node --env-file=.env.local scripts/volc-asr-probe.mjs",
    "probe:volc-tts": "NO_PROXY=* HTTPS_PROXY= HTTP_PROXY= node --env-file=.env.local scripts/volc-tts-probe.mjs",
    "test:expr": "tsx scripts/expression-filter.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "hono": "^4.12.18",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
