# 复制本文件到 .env.local 后填入真实凭据
# .env.local 已被 .gitignore 忽略，永远不会进库

# ====== ASR（火山语音识别）======
# 火山 ASR 应用 ID（用于鉴权和路由）
VOLC_ASR_APP_ID=
# 火山 ASR 访问令牌（用于 WebSocket 鉴权）
VOLC_ASR_ACCESS_TOKEN=
# 火山 ASR 资源 ID（指定识别资源配置）
VOLC_ASR_RESOURCE_ID=
# 火山 ASR WebSocket 地址（实时识别连接入口）
VOLC_ASR_WS_URL=

# ====== LLM（Gemini）======
# Gemini 代理服务地址（服务端转发入口）
GEMINI_PROXY_URL=
# Gemini API Key（调用模型鉴权）
GEMINI_API_KEY=
# Gemini 默认模型名（未显式指定时使用）
GEMINI_DEFAULT_MODEL=

# ====== TTS（火山语音合成）======
# 火山 API Key（TTS 调用鉴权）
VOLC_API_KEY=
# 火山 TTS 资源 ID（指定合成资源配置）
VOLC_TTS_RESOURCE_ID=
# 火山 TTS 音色类型（指定发音人）
VOLC_TTS_VOICE_TYPE=
# 火山 TTS WebSocket 地址（实时合成连接入口）
VOLC_TTS_WS_URL=

# ====== 服务器 ======
# 服务监听端口
PORT=3001
# 运行环境标识（development/production）
NODE_ENV=development

# ====== 反馈落库 ======
# SQLite 文件路径（默认 ./data/feedback.db）
FEEDBACK_DB_PATH=./data/feedback.db
# IP 哈希盐（建议显式配置；缺省时每次重启随机）
FEEDBACK_IP_SALT=
