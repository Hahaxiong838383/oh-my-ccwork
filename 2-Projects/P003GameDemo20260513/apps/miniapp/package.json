{
  "name": "xiaoke-miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "TARO_APP_DATA_MODE=live taro build --type h5 --watch",
    "dev:h5:demo": "TARO_APP_DATA_MODE=demo taro build --type h5 --watch",
    "build:h5": "TARO_APP_DATA_MODE=live taro build --type h5",
    "build:h5:demo": "TARO_APP_DATA_MODE=demo taro build --type h5",
    "dev:weapp": "TARO_APP_DATA_MODE=live taro build --type weapp --watch",
    "dev:weapp:demo": "TARO_APP_DATA_MODE=demo taro build --type weapp --watch",
    "build:weapp": "TARO_APP_DATA_MODE=live taro build --type weapp",
    "build:weapp:demo": "TARO_APP_DATA_MODE=demo taro build --type weapp",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "npm run build:server && node dist/server/index.js",
    "start:mock-cc": "npm run build:server && node dist/server/mock-cc.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build:server && npm run build:h5 && npm run build:weapp",
    "preview:h5": "vite preview --host 127.0.0.1 --port 4173 --outDir dist/h5"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/router": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/plugin-transform-class-properties": "7.27.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "4.5.14",
    "vitest": "0.34.6"
  }
}
