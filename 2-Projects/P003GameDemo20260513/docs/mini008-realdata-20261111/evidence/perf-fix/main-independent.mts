import assert from 'node:assert/strict';
import {mkdtempSync,writeFileSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join,resolve} from 'node:path';
import {pathToFileURL} from 'node:url';
import {createRequire} from 'node:module';
const root=resolve(process.env.SERVER_UNDER_TEST!);assert.ok(root.includes('mini008'));
const req=createRequire(join(root,'package.json'));
const tmp=mkdtempSync(join(tmpdir(),'mini008-main-audit-'));
for(const key of ['TELEMETRY','DEVICES','ACCOUNTS','PROFILE','ARK','CONFIG','PAIRING','SMS'])process.env[key+'_DB_PATH']=join(tmp,key.toLowerCase()+'.db');
process.env.AUTH_JWT_SECRET='isolated-mini008-main-fixture-only';
const SN='BJP00326060100999991';process.env.ARK_CONTEXT_SN_ALLOW=SN;
delete process.env.TELEMETRY_SN_ALLOWLIST;delete process.env.TELEMETRY_ACCEPTANCE_OVERRIDE;
process.chdir(tmp);
const moduleFrom=async(p:string)=>import(pathToFileURL(join(root,p)).href);
const {Hono}=await import(pathToFileURL(req.resolve('hono')).href);
const {serve}=await import(pathToFileURL(req.resolve('@hono/node-server')).href);
const {SignJWT}=await import(pathToFileURL(req.resolve('jose')).href);
const {deviceTelemetryRoute,parentTelemetryRoute}=await moduleFrom('src/routes/telemetry.ts');
const {deviceRegistryStore:registry}=await moduleFrom('src/device-registry-store.ts');
const {accountStore}=await moduleFrom('src/account-store.ts');
const {arkStore,arkService}=await moduleFrom('src/ark/service.ts');
const {arkRoute}=await moduleFrom('src/routes/ark.ts');
registry.add(SN,'isolated mini008 fixture');registry.setAccountId(SN,accountStore.createDeviceAccount(SN,'test').id);registry.setParentAccountId(SN,'fixture-parent-A');
const pub=registry.get(SN).public_id;const now=Date.now();arkStore().authorize(arkService().identity(SN),now-100000);
const secret=new TextEncoder().encode(process.env.AUTH_JWT_SECRET);
const device=await new SignJWT({kind:'p003-device',sub:SN}).setProtectedHeader({alg:'HS256'}).setIssuedAt().setExpirationTime('10m').sign(secret);
const token=async(id:string)=>new SignJWT({accountId:id,role:'parent'}).setProtectedHeader({alg:'HS256'}).setIssuer('p003').setAudience('kidshub').setIssuedAt().setExpirationTime('10m').sign(secret);
const A=await token('fixture-parent-A'),B=await token('fixture-parent-B');
const app=new Hono();app.route('/v1/device/telemetry',deviceTelemetryRoute);app.route('/v1/parent/devices',parentTelemetryRoute);app.route('/v1/device/ark',arkRoute);
const server=serve({fetch:app.fetch,hostname:'127.0.0.1',port:0});await new Promise(r=>server.listening?r(null):server.once('listening',r));const base='http://127.0.0.1:'+server.address().port;
let count=0;const check=(name:string,fn:()=>void)=>{fn();count++;console.log('PASS '+name);};
const call=async(path:string,t:string,body?:unknown)=>{const r=await fetch(base+path,{method:body?'POST':'GET',headers:{authorization:'Bearer '+t,'content-type':'application/json'},...(body?{body:JSON.stringify(body)}:{})});return {status:r.status,json:await r.json()};};
const dash=()=>call('/v1/parent/devices/'+pub+'/dashboard?timezone=Asia/Shanghai',A);
const batch=(id:string,events:unknown[],snapshot?:unknown)=>({schema_version:1,batch_id:id,device_ts_ms:Date.now(),events,...(snapshot?{snapshot}:{})});
try {
 let d=await dash();check('empty usage is unavailable/null',()=>{assert.equal(d.status,200);assert.equal(d.json.data.usage.today.available,false);assert.equal(d.json.data.usage.today.focus_minutes,null);assert.equal(d.json.data.usage.daily.length,7);assert.equal(d.json.data.today.focus_minutes,0);});
 const b=await call('/v1/parent/devices/'+pub+'/dashboard',B);check('other owner 404',()=>assert.equal(b.status,404));
 const midnight=Date.parse(new Date(now+8*3600000).toISOString().slice(0,10)+'T00:00:00+08:00');
 const seg={event_id:'main-cross-midnight',type:'focus_segment',occurred_at_ms:midnight+40000,data:{start_ms:midnight-20000,end_ms:midnight+40000}};
 let r=await call('/v1/device/telemetry',device,batch('main-cross',[seg]));check('events-only accepted and snapshot:null',()=>{assert.equal(r.status,200);assert.equal(r.json.data.snapshot,null);assert.deepEqual(r.json.data.acked_event_ids,['main-cross-midnight']);});
 d=await dash();const days=d.json.data.usage.daily;const firstTime=days[6].updated_at_ms;check('CST cross-day 20s/40s and real rounded zero',()=>{assert.deepEqual(days.slice(-2).map((x:any)=>[x.available,x.focus_minutes]),[[true,0],[true,1]]);assert.equal(days[0].focus_minutes,null);});
 await new Promise(r=>setTimeout(r,15));r=await call('/v1/device/telemetry',device,batch('main-dup',[seg]));d=await dash();check('dup retains initial receive timestamp and total',()=>{assert.deepEqual(r.json.data.duplicated_event_ids,['main-cross-midnight']);assert.equal(d.json.data.usage.today.updated_at_ms,firstTime);assert.equal(d.json.data.usage.today.focus_minutes,1);});
 r=await call('/v1/device/telemetry',device,batch('main-conflict',[{...seg,data:{...seg.data,end_ms:midnight+50000}}]));check('same ID changed payload individually rejected',()=>assert.equal(r.json.data.rejected[0].reason,'event_id_payload_conflict'));
 r=await call('/v1/device/telemetry',device,batch('main-malformed',[{event_id:'bad-string',type:'focus_segment',occurred_at_ms:now-1000,data:{start_ms:String(now-2000),end_ms:now-1000}},{event_id:'main-presence',type:'presence_transition',occurred_at_ms:now-1000,data:{present:false}}]));check('bad focus cannot poison valid mixed batch',()=>{assert.equal(r.status,200);assert.ok(r.json.data.rejected.some((x:any)=>x.event_id==='bad-string'));assert.ok(r.json.data.acked_event_ids.includes('main-presence'));});
 await call('/v1/device/telemetry',device,batch('main-snapshot',[],{snapshot_id:'main-new-state',captured_at_ms:now,brightness_level:2}));d=await dash();check('snapshot time never refreshes usage time',()=>assert.equal(d.json.data.usage.today.updated_at_ms,firstTime));
 const snap={schema_version:1,snapshot_id:'main-ark-1',boot_id:'main-boot',boot_started_at_ms:now-10000,sequence:1,captured_at_ms:now,logical_day:new Date(now+8*3600000).toISOString().slice(0,10),config_revision:'test-1',content_version:'test-1',source_mode:'normal',wallets:{family_coin:0,stardust:null},inventory:{'M-CARD-001':2},progress:{timer_state:'unknown',next_reward:{status:'unknown',kind:'unknown',item_id:null,stage_id:null,remaining_seconds:null},claimable_count:null}};
 r=await call('/v1/device/ark/state',device,snap);check('normal Ark business ACK accepted',()=>{assert.equal(r.status,200);assert.equal(r.json.status,'accepted');});
 d=await dash();check('normal assets preserve zero/null and inventory',()=>{assert.equal(d.json.data.ark.available,true);assert.equal(d.json.data.ark.wallets.family_coin,0);assert.equal(d.json.data.ark.wallets.stardust,null);assert.equal(d.json.data.ark.inventory['M-CARD-001'],2);});
 r=await call('/v1/device/ark/state',device,{...snap,snapshot_id:'main-ark-2',sequence:2,source_mode:'unknown',wallets:{family_coin:null,stardust:null},inventory:{'M-CARD-001':null}});check('authorized unknown accepted, not 403',()=>{assert.equal(r.status,200);assert.equal(r.json.status,'accepted');});
 d=await dash();check('unknown current removes previous normal display',()=>{assert.equal(d.json.data.ark.available,false);assert.equal(d.json.data.ark.wallets.family_coin,null);assert.equal(d.json.data.ark.inventory['M-CARD-001'],null);});
 registry.setParentAccountId(SN,'fixture-parent-B');let old=await dash();let fresh=await call('/v1/parent/devices/'+pub+'/dashboard',B);check('ownership change rejects A; stale grant not exposed to B',()=>{assert.equal(old.status,404);assert.equal(fresh.status,200);assert.equal(fresh.json.data.ark.available,false);});
 writeFileSync(join(tmp,'RESULT.json'),JSON.stringify({pass:count,fail:0,fixture_only:true,server:root}));console.log(JSON.stringify({pass:count,fail:0,tmp}));
}finally{server.closeAllConnections();await new Promise(r=>server.close(r));}
