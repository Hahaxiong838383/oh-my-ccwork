+// Inspect the persisted representation before serde defaults or migration can
+// erase evidence of an unavailable wallet. A valid sparse map is authoritative
+// for a known save; a missing map or provenance is not a zero balance.
+pub(crate) fn ark_wallet_is_known(raw: &Value) -> bool {
+    raw.get("schema_version").and_then(Value::as_u64)
+        == Some(crate::g1::model::G1_FORMAL_STATE_SCHEMA_VERSION as u64)
+        && matches!(raw.get("ark_source_mode").and_then(Value::as_str), Some("normal" | "gm"))
+        && raw.get("wallet").and_then(Value::as_object).is_some_and(|wallet| {
+            wallet.values().all(|value| value.as_u64().is_some_and(|n| n <= 1_000_000_000))
+        })
+        && serde_json::from_value::<G1FormalState>(raw.clone()).is_ok()
+}
+
+fn wallet_amount(formal: &G1FormalState, known: bool, item: &str) -> Option<i64> {
+    let amount = formal.wallet.get(item).copied().unwrap_or(0);
+    (known && (0..=1_000_000_000).contains(&amount)).then_some(amount)
+}
