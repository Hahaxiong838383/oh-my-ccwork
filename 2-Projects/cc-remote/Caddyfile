:19443 {
	# ============ cc-remote 终端（需要 Basic Auth）============
	basic_auth /claude/* {
		admin HASH_PLACEHOLDER
	}
	basic_auth /codex/* {
		admin HASH_PLACEHOLDER
	}
	basic_auth /gemini/* {
		admin HASH_PLACEHOLDER
	}
	basic_auth /api/* {
		admin HASH_PLACEHOLDER
	}
	basic_auth / {
		admin HASH_PLACEHOLDER
	}
	basic_auth /panel/* {
		admin HASH_PLACEHOLDER
	}

	# 管理面板
	handle / {
		root * /Users/rayman.chen/mycc/2-Projects/cc-remote/panel
		file_server
	}
	handle /panel/* {
		root * /Users/rayman.chen/mycc/2-Projects/cc-remote/panel
		file_server
	}

	# 按键注入 API
	handle /api/* {
		reverse_proxy localhost:19100
	}

	# ttyd 实例反代（WebSocket 长连接，禁用超时）
	handle /claude/* {
		reverse_proxy localhost:19001 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle /codex/* {
		reverse_proxy localhost:19002 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle /gemini/* {
		reverse_proxy localhost:19003 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}
