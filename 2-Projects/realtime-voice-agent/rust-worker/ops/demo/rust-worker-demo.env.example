# 语音体验 demo 专用池（agent_name=rust-worker-demo，川哥网页 demo 用），装到 64.90:/root/rust-worker-demo/rust-worker-demo.env（600）
# unit 里 EnvironmentFile 顺序：.env → poc-eou.env → rust-worker.env → 本文件（后者覆盖前者）；不含任何密钥
AGENT_NAME=rust-worker-demo
WORKER_MAX_JOBS=1
EOT_SOCK=/tmp/rust-worker-demo-eot.sock
# 大脑：直连 DeepSeek（LLM_API_KEY 取 .env），不走小可大脑，不带设备 token 查询串
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=disabled
LLM_URL_QUERY=
# 人设：unit 用 UnsetEnvironment=AGENT_INSTRUCTIONS 抹掉小可人设 → 用代码内置的通用语音助手人设；要自定义就在这里写 AGENT_INSTRUCTIONS=…（一行）
# 网页 demo 开场问候（文案取 .env 的 AGENT_GREETING）
AGENT_GREETING_ENABLED=1
# 小可设备专属功能全部关闭
P003_DEVICE_COMMANDS_ENABLED=0
P003_DEVICE_INTENT_EXECUTE=0
CANARY_SAY_ENABLED=0
SESSION_EXIT_SIGNAL_ENABLED=0
VOLC_ASR_NONSTREAM_ENABLED=0
