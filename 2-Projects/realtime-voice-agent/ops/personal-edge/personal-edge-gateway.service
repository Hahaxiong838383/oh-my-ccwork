[Unit]
Description=Personal voice HTTPS and WebSocket gateway
After=network.target personal-edge-ticket.service personal-edge-livekit.service
Wants=personal-edge-ticket.service personal-edge-livekit.service

[Service]
DynamicUser=yes
RuntimeDirectory=personal-edge-gateway
RuntimeDirectoryMode=0700
LoadCredential=server.key:/opt/personal-edge/private/server.key
ExecStart=/usr/sbin/nginx -c /opt/personal-edge/nginx.conf -g "daemon off;"
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
