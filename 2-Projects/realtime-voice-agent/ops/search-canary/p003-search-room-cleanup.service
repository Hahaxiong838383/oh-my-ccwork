[Unit]
Description=P003 candidate durable room cleanup
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/p003-search-canary-20261021
EnvironmentFile=/opt/p003-search-canary-20261021/canary.env
ExecStart=/usr/bin/python3 /opt/p003-search-canary-20261021/reconcile_rooms.py --queue /opt/p003-search-canary-20261021/room-cleanup --window /opt/p003-search-canary-20261021/window.json --status /opt/p003-search-canary-20261021/cleanup-status.json
TimeoutStartSec=60
MemoryMax=96M
CPUQuota=20%
TasksMax=16
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/p003-search-canary-20261021/room-cleanup /opt/p003-search-canary-20261021
PrivateTmp=true
