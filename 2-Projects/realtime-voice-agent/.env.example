# realtime-voice-agent 配置模板
# 复制为 .env 并填真值。.env 已在 .gitignore,真值绝不入库。
# 骨架阶段(架构骨架)无需任何真值即可 import + 跑测试;以下为 M0 接线时所需。

# ---- 体验引擎选择 ----
# tier_a_cascade(★MVP) | tier_b_realtime | tier_c_duplex
VOICE_ENGINE=tier_a_cascade

# ---- Tier A: RTC 传输(LiveKit) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Tier A: STT(M0 本地 sherpa-onnx,零成本/数据不出端) ----
STT_PROVIDER=sherpa
STT_MODEL_DIR=~/models/sherpa-para
STT_API_KEY=

# ---- Tier A: LLM(热路径回包,首 token TTFT 是延迟关键;M0 走 OpenAI 兼容端点) ----
# provider=openai|gemini 均走 livekit-plugins-openai,指向 LLM_BASE_URL
LLM_PROVIDER=gemini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Tier A: TTS(M0 本地 VoxCPM2 MLX 8bit,48kHz/steps=5) ----
TTS_PROVIDER=voxcpm
TTS_MODEL_DIR=~/models/VoxCPM2-8bit
TTS_API_KEY=
TTS_VOICE=

# ---- Agent 行为 ----
AGENT_INSTRUCTIONS=你是一个简洁、自然、可被打断的中文实时语音助手。
AGENT_GREETING=你好，我在。你可以直接打断我。

# ---- Tier B: 托管 Realtime(豆包 Seeduplex / OpenAI Realtime) ----
REALTIME_PROVIDER=
REALTIME_API_KEY=

# ---- 记忆内核存储 ----
# Event Log = 单一真相源(append-only);投影/向量均可从它 replay 重建
EVENT_LOG_PATH=./data/events
VECTOR_INDEX_PATH=./data/vector.db

# ---- 抽取置信度门(冷路径,STT drift 防污染) ----
# 低于此置信度的事实进 low-confidence state,不进真值
EXTRACTION_CONFIDENCE_FLOOR=0.6
