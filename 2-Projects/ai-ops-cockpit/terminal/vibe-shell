#!/usr/bin/env bash
set -euo pipefail
mkdir -p /var/log/ops-terminal /workspace/brain
log_file="/var/log/ops-terminal/session-$(date +%Y%m%d-%H%M%S)-$$.log"
echo "正在启动 AI Ops ${AI_OPS_OMP_MODEL_LABEL:-DeepSeek V4 Pro} OMP Terminal..."
cd /workspace/brain
session_pid=""
cleanup() {
  trap - EXIT HUP INT TERM
  if [ -n "$session_pid" ] && kill -0 -- "-$session_pid" 2>/dev/null; then
    kill -TERM -- "-$session_pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "$session_pid" 2>/dev/null || break
      sleep 0.2
    done
    kill -KILL -- "-$session_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT HUP INT TERM
setsid /usr/bin/script -q -f -a "$log_file" -c /usr/local/bin/vibe-omp &
session_pid=$!
set +e
wait "$session_pid"
status=$?
set -e
cleanup
exit "$status"
