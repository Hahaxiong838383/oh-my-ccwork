#!/usr/bin/env bash
set -euo pipefail
model="${AI_OPS_OMP_MODEL:-volcengine-coding/deepseek-v4-pro}"
model_label="${AI_OPS_OMP_MODEL_LABEL:-DeepSeek V4 Pro}"
agent_dir="${AI_OPS_BRAIN_AGENT_DIR:-/home/ops/.omp/brain-agent}"
brain_cwd="${AI_OPS_BRAIN_CWD:-/workspace/brain/session}"
mkdir -p "$brain_cwd"
chmod 700 "$brain_cwd"
cd "$brain_cwd"
mkdir -p "$agent_dir"
chmod 700 "$agent_dir"
if [ ! -f "$agent_dir/models.yml" ]; then
  cp /etc/aiops-models.yml "$agent_dir/models.yml"
  chmod 600 "$agent_dir/models.yml"
fi
if [ ! -f "$agent_dir/config.yml" ]; then
  cat > "$agent_dir/config.yml" <<'YAML'
setupVersion: 1
startup:
  setupWizard: false
YAML
  chmod 600 "$agent_dir/config.yml"
fi
export PI_CODING_AGENT_DIR="$agent_dir"

run_readonly_omp() {
  AI_OPS_BRAIN_TASK_ID="interactive-$(date +%Y%m%d-%H%M%S)" \
    omp-aiops --model "$model" --cwd "$brain_cwd" \
      --no-tools --no-rules --no-skills --no-lsp --no-pty --no-title \
      --extension /opt/aiops/extensions/readonly-safe.ts \
      --approval-mode yolo "$@"
}
cat <<BANNER
╭────────────────────────────────────────────╮
│ AI Ops OMP Terminal                        │
│ 自动启动: Harness + ${model_label}          │
│ 模式: readonly_safe（无直连生产权限）      │
│ 退出 OMP 后会回到普通 bash                 │
╰────────────────────────────────────────────╯

BANNER
if ! command -v omp-aiops >/dev/null 2>&1; then
  echo "未找到 omp，回落到 bash。"
  exec /bin/bash
fi
if [ ! -r /run/secrets/volcengine_coding_api_key ]; then
  echo "⚠️  方舟 Coding Plan 密钥未挂载，已进入普通 bash。"
  echo "请检查 Docker secret volcengine_coding_api_key 后重新打开 /terminal/。"
  exec /bin/bash
fi
if ! omp-aiops models find "$model" --json 2>/dev/null | grep -q 'deepseek-v4-pro'; then
  echo "⚠️  OMP 未识别模型 $model，已进入普通 bash。"
  echo "请检查 $agent_dir/models.yml 后重新打开 /terminal/。"
  echo "Harness prompt 可查看：curl -fsS http://ops-inspector:8080/vibe/harness-prompt"
  exec /bin/bash
fi
if command -v curl >/dev/null 2>&1; then
  harness_prompt="$(curl -fsS --max-time 5 http://ops-inspector:8080/vibe/harness-prompt || true)"
fi
if [ -n "${harness_prompt:-}" ]; then
  mkdir -p /tmp/aiops
  printf '%s\n' "$harness_prompt" > /tmp/aiops/harness-prompt.md
  cat <<'READY'
Harness 已加载到 /tmp/aiops/harness-prompt.md。
现在启动常驻 OMP 交互模式；请把任务直接输入到 OMP 中。
如果需要查看完整 Harness，可在 OMP 里让它读取该文件。

READY
  run_readonly_omp || true
else
  echo "未能读取 Harness prompt，使用普通 OMP 启动。"
  run_readonly_omp || true
fi
echo
echo "OMP 已退出，已回到普通 bash。重新启动可运行："
echo "  /usr/local/bin/vibe-omp"
exec /bin/bash
