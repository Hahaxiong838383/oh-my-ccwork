# AI Ops Brain terminal. No Docker socket, production SSH, writable project mount, or sudo.
omp() {
  command /usr/local/bin/omp-aiops "$@"
}

aiops_guard_command() {
  local cmd="$BASH_COMMAND"
  case "$cmd" in
    *"rm -rf"*|*"sudo "*|*"docker "*|*"ssh "*|*"scp "*|*"rsync "*|*"curl "*|*"wget "*|*"chmod 777"*|*"chown 777"*|*"git push"*|*"git commit"*)
      echo
      echo "⛔ AI Ops Brain 护栏：当前终端只允许模型交互和临时草稿，不允许生产命令。"
      echo "请通过网页受控动作入口执行已登记操作。"
      return 1
      ;;
  esac
}
trap 'aiops_guard_command' DEBUG
