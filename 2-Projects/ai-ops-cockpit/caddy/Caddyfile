{
  admin off
  email admin@hahaxiong.top
}

ops.hahaxiong.top, :80 {
  encode gzip

  @needsAuth {
    not path /api/push/*
    not path /ops-health/*
    not header Cookie *ops_auth=REDACTED_OPS_AUTH_COOKIE_VALUE*
  }
  basic_auth @needsAuth {
    chuan REDACTED_BCRYPT_HASH
  }

  @setAuthCookie {
    not path /api/push/*
    not path /ops-health/*
    header Authorization *
  }
  header @setAuthCookie Set-Cookie "ops_auth=REDACTED_OPS_AUTH_COOKIE_VALUE; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"


  handle /favicon.ico {
    respond 204
  }

  handle /ops-health/* {
    reverse_proxy ops-inspector:8080
  }

  # Dockge is also a root-mounted SPA. When the browser is on /dockge/,
  # its root assets/socket endpoints must be routed to Dockge, not Kuma.
  @dockgeAssets {
    path /assets/* /socket.io/* /manifest.json /icon.svg /apple-touch-icon.png
    header Referer *://ops.hahaxiong.top/dockge/*
  }
  handle @dockgeAssets {
    reverse_proxy dockge:5001
  }

  # Uptime Kuma is a root-mounted SPA. Keep Homepage /api/* intact,
  # but send Kuma pages/assets/socket endpoints to Kuma.
  handle_path /kuma* {
    reverse_proxy uptime-kuma:3001
  }
  handle /dashboard* {
    reverse_proxy uptime-kuma:3001
  }
  handle /setup* {
    reverse_proxy uptime-kuma:3001
  }
  handle /status* {
    reverse_proxy uptime-kuma:3001
  }
  handle /manage-status-page* {
    reverse_proxy uptime-kuma:3001
  }
  handle /maintenance* {
    reverse_proxy uptime-kuma:3001
  }
  handle /assets/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /socket.io/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /upload/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /api/push/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /api/entry-page* {
    reverse_proxy uptime-kuma:3001
  }
  handle /api/status-page/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /manifest.json {
    reverse_proxy uptime-kuma:3001
  }
  handle /icon.svg {
    reverse_proxy uptime-kuma:3001
  }

  handle /ai* {
    reverse_proxy ops-inspector:8080
  }

  handle /n8n/rest/login {
    reverse_proxy ops-auth:8080 {
      rewrite /n8n-login
    }
  }

  handle_path /n8n* {
    reverse_proxy n8n:5678
  }

  handle_path /netdata* {
    reverse_proxy netdata:19999
  }

  handle /dockge/socket.io* {
    uri strip_prefix /dockge
    reverse_proxy dockge:5001
  }

  handle_path /dockge* {
    reverse_proxy dockge:5001
  }

  handle {
    reverse_proxy homepage:3000
  }
}
