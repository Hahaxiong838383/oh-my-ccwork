{
  admin off
  email admin@hahaxiong.top
}

ops.hahaxiong.top, :80 {
  encode gzip

  @protected {
    not path /api/push/*
    not path /ops-health/*
  }
  forward_auth @protected ops-auth:8080 {
    uri /auth
    copy_headers Set-Cookie
  }

  handle /favicon.ico {
    respond 204
  }

  handle /ops-health/* {
    reverse_proxy ops-inspector:8080
  }

  handle /ops-dashboard* {
    reverse_proxy ops-inspector:8080
  }

  handle /ops-home* {
    reverse_proxy ops-inspector:8080
  }

  handle /vibe* {
    reverse_proxy ops-inspector:8080
  }

  @terminal {
    path /terminal*
  }
  handle @terminal {
    reverse_proxy ops-terminal:7681
  }

  handle /homepage* {
    uri strip_prefix /homepage
    reverse_proxy homepage:3000
  }

  @dockgeAssets {
    path /assets/* /socket.io/* /manifest.json /icon.svg /apple-touch-icon.png
    header Referer *://ops.hahaxiong.top/dockge/*
  }
  handle @dockgeAssets {
    reverse_proxy dockge:5001
  }

  handle_path /kuma* {
    reverse_proxy uptime-kuma:3001
  }
  handle /dashboard* {
    reverse_proxy uptime-kuma:3001
  }
  handle /setup* {
    reverse_proxy uptime-kuma:3001
  }
  handle /status* {
    reverse_proxy uptime-kuma:3001
  }
  handle /manage-status-page* {
    reverse_proxy uptime-kuma:3001
  }
  handle /maintenance* {
    reverse_proxy uptime-kuma:3001
  }
  handle /assets/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /socket.io/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /upload/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /api/push/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /api/entry-page* {
    reverse_proxy uptime-kuma:3001
  }
  handle /api/status-page/* {
    reverse_proxy uptime-kuma:3001
  }
  handle /manifest.json {
    reverse_proxy uptime-kuma:3001
  }
  handle /icon.svg {
    reverse_proxy uptime-kuma:3001
  }

  handle /ai* {
    reverse_proxy ops-inspector:8080
  }

  handle /n8n/rest/login {
    reverse_proxy ops-auth:8080 {
      rewrite /n8n-login
    }
  }

  handle_path /n8n* {
    reverse_proxy n8n:5678
  }

  handle_path /netdata* {
    reverse_proxy netdata:19999
  }

  handle /dockge/socket.io* {
    uri strip_prefix /dockge
    reverse_proxy dockge:5001
  }

  handle_path /dockge* {
    reverse_proxy dockge:5001
  }

  handle {
    reverse_proxy ops-inspector:8080
  }
}
