+func runSkillProposalsList(cmd *cobra.Command, _ []string) error {
+	client, err := newAPIClient(cmd)
+	if err != nil {
+		return err
+	}
+
+	status, _ := cmd.Flags().GetString("status")
+	path := "/api/skills/proposals"
+	if status != "" {
+		q := url.Values{}
+		q.Set("status", status)
+		path += "?" + q.Encode()
+	}
+
+	ctx, cancel := cli.APIContext(context.Background())
+	defer cancel()
+
+	var proposals []map[string]any
+	if err := client.GetJSON(ctx, path, &proposals); err != nil {
+		return fmt.Errorf("list skill proposals: %w", err)
+	}
+
+	output, _ := cmd.Flags().GetString("output")
+	if output == "json" {
+		return cli.PrintJSON(os.Stdout, proposals)
+	}
+
+	headers := []string{"ID", "STATUS", "NAME", "TARGET_SKILL_ID", "UPDATED_AT"}
+	rows := make([][]string, 0, len(proposals))
+	for _, p := range proposals {
+		rows = append(rows, []string{
+			strVal(p, "id"),
+			strVal(p, "status"),
+			strVal(p, "name"),
+			strVal(p, "target_skill_id"),
+			strVal(p, "updated_at"),
+		})
+	}
+	cli.PrintTable(os.Stdout, headers, rows)
+	return nil
+}
+
+func runSkillProposalsCreate(cmd *cobra.Command, _ []string) error {
+	client, err := newAPIClient(cmd)
+	if err != nil {
+		return err
+	}
+
+	name, _ := cmd.Flags().GetString("name")
+	if name == "" {
+		return fmt.Errorf("--name is required")
+	}
+
+	body := map[string]any{"name": name}
+	if v, _ := cmd.Flags().GetString("target-skill-id"); v != "" {
+		body["target_skill_id"] = v
+	}
+	if v, _ := cmd.Flags().GetString("description"); v != "" {
+		body["description"] = v
+	}
+	content, hasContent, err := resolveSkillContentFlag(cmd)
+	if err != nil {
+		return err
+	}
+	if hasContent {
+		body["content"] = content
+	}
+	if cmd.Flags().Changed("config") {
+		config, err := parseJSONFlag(cmd, "config")
+		if err != nil {
+			return err
+		}
+		body["config"] = config
+	}
+	if cmd.Flags().Changed("files-json") {
+		files, err := parseJSONFlag(cmd, "files-json")
+		if err != nil {
+			return err
+		}
+		body["files"] = files
+	}
+	if cmd.Flags().Changed("source") {
+		source, err := parseJSONFlag(cmd, "source")
+		if err != nil {
+			return err
+		}
+		body["source"] = source
+	}
+	if cmd.Flags().Changed("validation") {
+		validation, err := parseJSONFlag(cmd, "validation")
+		if err != nil {
+			return err
+		}
+		body["validation"] = validation
+	}
+	if v, _ := cmd.Flags().GetString("status"); v != "" {
+		body["status"] = v
+	}
+
+	ctx, cancel := cli.APIContext(context.Background())
+	defer cancel()
+
+	var result map[string]any
+	if err := client.PostJSON(ctx, "/api/skills/proposals", body, &result); err != nil {
+		return fmt.Errorf("create skill proposal: %w", err)
+	}
+
+	output, _ := cmd.Flags().GetString("output")
+	if output == "json" {
+		return cli.PrintJSON(os.Stdout, result)
+	}
+
+	fmt.Printf("Skill proposal created: %s (%s)\n", strVal(result, "name"), strVal(result, "id"))
+	return nil
+}
