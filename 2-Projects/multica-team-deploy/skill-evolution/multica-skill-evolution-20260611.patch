@@ -0,0 +1,25 @@
+-- Skill proposals are draft/evaluation records produced by humans or
+-- automation before a workspace skill is created or updated.
+
+CREATE TABLE skill_proposal (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    workspace_id UUID NOT NULL REFERENCES workspace(id) ON DELETE CASCADE,
+    target_skill_id UUID REFERENCES skill(id) ON DELETE SET NULL,
+    name TEXT NOT NULL,
+    description TEXT NOT NULL DEFAULT '',
+    content TEXT NOT NULL DEFAULT '',
+    config JSONB NOT NULL DEFAULT '{}',
+    files JSONB NOT NULL DEFAULT '[]',
+    source JSONB NOT NULL DEFAULT '{}',
+    validation JSONB NOT NULL DEFAULT '{}',
+    status TEXT NOT NULL DEFAULT 'draft' CHECK (status IN ('draft', 'validated', 'rejected', 'published')),
+    created_by UUID REFERENCES "user"(id),
+    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+    published_at TIMESTAMPTZ,
+    published_skill_id UUID REFERENCES skill(id) ON DELETE SET NULL
+);
+
+CREATE INDEX idx_skill_proposal_workspace ON skill_proposal(workspace_id, updated_at DESC);
+CREATE INDEX idx_skill_proposal_target ON skill_proposal(target_skill_id);
+CREATE INDEX idx_skill_proposal_status ON skill_proposal(workspace_id, status);
