+func parseJSONFlag(cmd *cobra.Command, name string) (any, error) {
+	raw, _ := cmd.Flags().GetString(name)
+	var value any
+	if err := json.Unmarshal([]byte(raw), &value); err != nil {
+		return nil, fmt.Errorf("--%s must be valid JSON: %w", name, err)
+	}
+	return value, nil
+}
