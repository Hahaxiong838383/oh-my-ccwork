# safety-arena —— 「真实生成」(LLM SUT + LLM-as-classifier)所需环境变量模板。
# 用法:cp .env.example .env(.env 已 gitignore)→ 填真值 → `set -a; . ./.env; set +a; bash scripts/serve-live.sh`
#
# ⚠️ 只跑 mock 重放 / 规则评分器 / Web 可视化时【不需要任何 key】,本文件可忽略。
# ⚠️ 凭据只走环境变量,.env 绝不提交(已在 .gitignore)。

# OpenAI 兼容网关地址(启用真实生成时必填)。示例:https://your-gateway.example.com/v1
GEMINI_PROXY_URL=

# 网关 API Key(启用真实生成时必填)。绝不提交到仓库。
GEMINI_API_KEY=

# 生成模型(可选,默认 gemini-2.5-flash)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# LLM-as-classifier 模型(可选,默认 gemini-2.5-flash-lite —— 无 thinking,判定更快)
SAFETY_ARENA_CLF_MODEL=gemini-2.5-flash-lite

# 服务端口(可选,默认 8800)
PORT=8800
