# jidinghe-armbian 的 EasyTier TCP 数据面 watchdog 参数；不含凭据。
ET_EXPECT_PEERS="hk-relay mini studio dev198 linux-lan fnos2 home-studio maxtkf-server"
ET_MUST_P2P="dev198 mini"
ET_RELAY_IP="10.10.10.1"
ET_UNIT="easytier-mesh.service"

ET_SELFHEAL="1"
ET_FAIL_THRESHOLD="3"
ET_RESTART_COOLDOWN="3600"
ET_DEGRADE_THRESHOLD="6"

ET_WATCH_LOG="/var/log/easytier-watch.log"
ET_WATCH_STATE="/var/lib/easytier-watch.state"
