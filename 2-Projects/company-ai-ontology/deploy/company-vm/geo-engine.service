[Unit]
Description=GEO Engine API
Wants=network-online.target
After=network-online.target
Before=geo-dashboard-tunnel.service

[Service]
Type=simple
User=futurus
Group=futurus
WorkingDirectory=/home/futurus/.geo-engine/current/services/geo-engine
EnvironmentFile=/home/futurus/.config/geo-engine/geo-engine.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/home/futurus/.geo-engine/current-venv/bin/geo-engine serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/futurus/.geo-engine

[Install]
WantedBy=multi-user.target
