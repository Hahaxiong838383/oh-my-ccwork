{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurus.internal/schemas/strategic-intelligence-shadow-day-evidence-v1.json",
  "title": "Strategic Intelligence Shadow Day Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceVersion",
    "requestKey",
    "localDate",
    "timezone",
    "requestedAt",
    "recordedAt",
    "policyVersion",
    "policyHash",
    "simulated",
    "publish",
    "status",
    "startedAt",
    "completedAt",
    "durationSeconds",
    "exitCode",
    "timeoutCount",
    "sourceAttemptCount",
    "sourceSuccessCount",
    "rawSnapshotCount",
    "normalizedItemCount",
    "duplicateCount",
    "freshnessP95Seconds",
    "rawSnapshotBytes",
    "networkBytes",
    "peakCpuPermille",
    "peakMemoryBytes",
    "reportCostsUsd",
    "domainArtifacts",
    "security",
    "sideEffects",
    "runtime",
    "coverage"
  ],
  "properties": {
    "evidenceVersion": { "const": "1.0.0" },
    "requestKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{4,120}$" },
    "localDate": { "type": "string", "format": "date" },
    "timezone": { "const": "Asia/Shanghai" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "policyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "simulated": { "const": false },
    "publish": { "const": false },
    "status": { "enum": ["succeeded", "failed", "timed_out"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationSeconds": { "type": "integer", "minimum": 0 },
    "exitCode": { "type": "integer", "minimum": 0 },
    "timeoutCount": { "type": "integer", "minimum": 0 },
    "sourceAttemptCount": { "type": "integer", "minimum": 0 },
    "sourceSuccessCount": { "type": "integer", "minimum": 0 },
    "rawSnapshotCount": { "type": "integer", "minimum": 0 },
    "normalizedItemCount": { "type": "integer", "minimum": 0 },
    "duplicateCount": { "type": "integer", "minimum": 0 },
    "freshnessP95Seconds": { "type": "integer", "minimum": 0 },
    "rawSnapshotBytes": { "type": "integer", "minimum": 0 },
    "networkBytes": { "type": "integer", "minimum": 0 },
    "peakCpuPermille": { "type": "integer", "minimum": 0 },
    "peakMemoryBytes": { "type": "integer", "minimum": 0 },
    "reportCostsUsd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily", "weekly"],
      "properties": {
        "daily": { "type": "number", "minimum": 0 },
        "weekly": { "type": "number", "minimum": 0 }
      }
    },
    "domainArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistenceState", "rawSnapshotCount", "observationCount", "signalCount", "evidenceCount", "impactAssessmentCount", "reportRunCount", "reportDraftCount"],
      "properties": {
        "persistenceState": { "enum": ["postgres_committed", "not_persisted"] },
        "rawSnapshotCount": { "type": "integer", "minimum": 0 },
        "observationCount": { "type": "integer", "minimum": 0 },
        "signalCount": { "type": "integer", "minimum": 0 },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "impactAssessmentCount": { "type": "integer", "minimum": 0 },
        "reportRunCount": { "type": "integer", "minimum": 0 },
        "reportDraftCount": { "type": "integer", "minimum": 0 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unredactedSensitiveOutputCount", "sourceRevocationEffectiveSeconds", "postRevocationNetworkRequestCount", "lastGoodPreserved"],
      "properties": {
        "unredactedSensitiveOutputCount": { "type": "integer", "minimum": 0 },
        "sourceRevocationEffectiveSeconds": { "type": "integer", "minimum": 0 },
        "postRevocationNetworkRequestCount": { "type": "integer", "minimum": 0 },
        "lastGoodPreserved": { "const": true }
      }
    },
    "sideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formalP2Count", "employeeDeliveryCount", "erpWritebackCount", "socialWritebackCount", "causalActivationCount"],
      "properties": {
        "formalP2Count": { "const": 0 },
        "employeeDeliveryCount": { "const": 0 },
        "erpWritebackCount": { "const": 0 },
        "socialWritebackCount": { "const": 0 },
        "causalActivationCount": { "const": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectorImage", "sourceCommit", "containerRestartCount", "newHostPortCount"],
      "properties": {
        "collectorImage": { "type": "string", "pattern": "(^sha256:[0-9a-f]{64}$)|(@sha256:[0-9a-f]{64}$)" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "containerRestartCount": { "const": 0 },
        "newHostPortCount": { "const": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "collectorMetricsCollected",
        "resourceMetricsCollected",
        "sensitiveOutputAuditCompleted",
        "sourceRevocationAuditCompleted",
        "businessSideEffectAuditCompleted",
        "domainCompilationCompleted",
        "domainPersistenceCompleted"
      ],
      "properties": {
        "collectorMetricsCollected": { "type": "boolean" },
        "resourceMetricsCollected": { "type": "boolean" },
        "sensitiveOutputAuditCompleted": { "type": "boolean" },
        "sourceRevocationAuditCompleted": { "type": "boolean" },
        "businessSideEffectAuditCompleted": { "type": "boolean" },
        "domainCompilationCompleted": { "type": "boolean" },
        "domainPersistenceCompleted": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
