{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurus.local/schemas/reviewer-role-access-acceptance.schema.json",
  "title": "P1-SI Reviewer Role Access Acceptance",
  "type": "object",
  "required": [
    "evidenceVersion",
    "workbenchKey",
    "status",
    "memberExperienceVerified",
    "securityOwnerAccepted",
    "acceptedAt",
    "securityOwner",
    "ownerAcceptanceRef",
    "evidenceRefs",
    "categoryFieldType",
    "allFiltersValid",
    "legacyBroadRoleMemberCount",
    "publicOutputContainsSensitiveData",
    "roleTests"
  ],
  "properties": {
    "evidenceVersion": { "const": "1.0.0" },
    "workbenchKey": { "const": "P1-SI-HUMAN-REVIEW" },
    "status": { "enum": ["pending", "complete"] },
    "memberExperienceVerified": { "type": "boolean" },
    "securityOwnerAccepted": { "type": "boolean" },
    "acceptedAt": { "type": ["string", "null"], "format": "date-time" },
    "securityOwner": { "type": ["object", "null"] },
    "ownerAcceptanceRef": { "type": "string" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "categoryFieldType": { "const": "SingleSelect" },
    "allFiltersValid": { "type": "boolean" },
    "legacyBroadRoleMemberCount": { "type": "integer", "minimum": 0 },
    "publicOutputContainsSensitiveData": { "type": "boolean" },
    "roleTests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "object" }
    }
  },
  "additionalProperties": false
}
