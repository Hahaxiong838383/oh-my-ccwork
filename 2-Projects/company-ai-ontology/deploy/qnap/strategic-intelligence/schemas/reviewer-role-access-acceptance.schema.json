{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurus.local/schemas/reviewer-role-access-acceptance.schema.json",
  "title": "P1-SI Compiler-Derived Reviewer Role Access Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceVersion", "evidenceType", "workbenchKey", "status", "memberExperienceVerified", "securityOwnerAccepted", "acceptedAt", "securityOwner", "ownerAcceptanceRef", "evidenceRefs", "categoryFieldType", "allFiltersValid", "legacyBroadRoleMemberCount", "publicOutputContainsSensitiveData", "roleTests", "rawEvidenceFiles"],
  "properties": {
    "evidenceVersion": { "const": "2.0.0" },
    "evidenceType": { "const": "reviewer-role-access-acceptance" },
    "workbenchKey": { "const": "P1-SI-HUMAN-REVIEW" },
    "status": { "const": "complete" },
    "memberExperienceVerified": { "const": true },
    "securityOwnerAccepted": { "const": true },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "securityOwner": { "type": "object" },
    "ownerAcceptanceRef": { "type": "string" },
    "evidenceRefs": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "categoryFieldType": { "const": "SingleSelect" },
    "allFiltersValid": { "const": true },
    "legacyBroadRoleMemberCount": { "const": 0 },
    "publicOutputContainsSensitiveData": { "const": false },
    "roleTests": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object" } },
    "rawEvidenceFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_user", "ai_rd", "brand", "toc_offline_channel", "owner"],
      "properties": {
        "product_user": { "$ref": "#/$defs/fileHash" },
        "ai_rd": { "$ref": "#/$defs/fileHash" },
        "brand": { "$ref": "#/$defs/fileHash" },
        "toc_offline_channel": { "$ref": "#/$defs/fileHash" },
        "owner": { "$ref": "#/$defs/fileHash" }
      }
    }
  },
  "$defs": {
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^reviewer-role-[a-z0-9-]+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
