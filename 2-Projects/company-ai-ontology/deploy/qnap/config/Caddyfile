{
  admin off
  auto_https off
}
:8080 {
  bind 0.0.0.0
  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Cache-Control no-store
  }

  @health path /healthz
  respond @health `{"status":"ok","component":"qnap-foundation","exposure":"lan-only"}` 200

  @ready path /readyz
  respond @ready `{"status":"foundation-ready","next":"h-lite-and-agent-core"}` 200

  @agentCore path /ontology/status/agent-core
  handle @agentCore {
    rewrite * /readyz
    reverse_proxy agent-core:8080
  }

  @hLite path /ontology/status/h-lite
  handle @hLite {
    rewrite * /readyz
    reverse_proxy h-lite:8081
  }

  @knowledge path /ontology/status/knowledge
  handle @knowledge {
    rewrite * /healthz
    reverse_proxy knowledge-connector:8083
  }

  @action path /ontology/status/action
  handle @action {
    rewrite * /readyz
    reverse_proxy action-gateway:8082
  }

  @registry path /ontology/status/registry
  handle @registry {
    rewrite * /readyz
    reverse_proxy ontology-registry:8084
  }

  @workProtocol path /ontology/status/work-protocol
  handle @workProtocol {
    rewrite * /status/work-protocol
    reverse_proxy agent-core:8080
  }

  @practiceProtocol path /ontology/status/practice-protocol
  handle @practiceProtocol {
    rewrite * /status/practice-protocol
    reverse_proxy agent-core:8080
  }

  respond `{"status":"not-found"}` 404
}
