  "functionTypes": [
    {
      "qualifiedName": "core.epistemic.assessEvidence",
      "description": "Deterministically assess evidence completeness and contradiction",
      "deterministic": true,
      "inputs": [
        { "name": "claim", "type": "core.epistemic.Claim", "required": true },
        { "name": "evidence", "type": "json", "required": true }
      ],
      "outputs": [
        { "name": "assessment", "type": "json", "required": true }
      ]
    },
    {
      "qualifiedName": "core.decision.compareScenarios",
      "description": "Compare scenarios using governed metrics and constraints",
      "deterministic": true,
      "inputs": [
        { "name": "decisionCase", "type": "core.decision.DecisionCase", "required": true },
        { "name": "scenarios", "type": "json", "required": true }
      ],
      "outputs": [
        { "name": "comparison", "type": "json", "required": true }
      ]
    },
    {
      "qualifiedName": "core.epistemic.buildEvidencePackageV2",
      "description": "Build a permissioned evidence package with provenance, freshness and exclusion summaries",
      "deterministic": true,
      "inputs": [
        { "name": "workCase", "type": "core.work.WorkCase", "required": true },
        { "name": "permissionedEvidence", "type": "json", "required": true }
      ],
      "outputs": [
        { "name": "package", "type": "json", "required": true }
      ]
    },
    {
      "qualifiedName": "core.work.validateStructuredResponse",
      "description": "Validate answer basis, evidence references and certainty against the epistemic assessment",
      "deterministic": true,
      "inputs": [
        { "name": "workCase", "type": "core.work.WorkCase", "required": true },
        { "name": "assessment", "type": "core.epistemic.EpistemicAssessment", "required": true },
        { "name": "response", "type": "json", "required": true }
      ],
      "outputs": [
        { "name": "validation", "type": "json", "required": true }
      ]
    },
    {
      "qualifiedName": "core.work.verifyOutcome",
      "description": "Separate execution, operational and goal success",
      "deterministic": true,
      "inputs": [
        { "name": "expectedOutcome", "type": "json", "required": true },
        { "name": "observedOutcome", "type": "json", "required": true }
      ],
      "outputs": [
        { "name": "verification", "type": "core.work.Verification", "required": true }
      ]
    },
    {
      "qualifiedName": "core.decision.buildDecisionLineage",
      "description": "Build a replayable lineage from evidence and decision through P2, task, action, verification and learning",
      "deterministic": true,
      "inputs": [
        { "name": "decision", "type": "core.decision.Decision", "required": true },
        { "name": "practiceObjects", "type": "json", "required": true }
      ],
      "outputs": [
        { "name": "lineage", "type": "json", "required": true }
      ]
    }
  ],
  "actionTypes": [
    {
      "qualifiedName": "core.work.assignTask",
      "description": "Assign an approved task through the governed delivery path",
      "targetType": "core.work.Task",
      "effect": "write",
      "gateway": "mandatory-action-gateway",
      "approval": "required",
      "inputs": [
        { "name": "task", "type": "core.work.Task", "required": true },
        { "name": "assigneePersonId", "type": "string", "required": true }
      ]
    },
    {
      "qualifiedName": "core.action.executeIntent",
      "description": "Execute an approved action intent with readback and rollback",
      "targetType": "core.action.ActionIntent",
      "effect": "write",
      "gateway": "mandatory-action-gateway",
      "approval": "required",
      "inputs": [
        { "name": "intent", "type": "core.action.ActionIntent", "required": true }
      ]
    },
    {
      "qualifiedName": "core.decision.approveDecision",
      "description": "Approve one selected alternative and authorize downstream P2 work",
      "targetType": "core.decision.DecisionCase",
      "effect": "write",
      "gateway": "mandatory-action-gateway",
      "approval": "required",
      "inputs": [
        { "name": "decisionCase", "type": "core.decision.DecisionCase", "required": true },
        { "name": "selectedAlternative", "type": "core.decision.DecisionAlternative", "required": true }
      ]
    }
  ],
  "policyTypes": [
    {
      "qualifiedName": "core.policy.permissionedEvidence",
      "description": "Evidence enters Agent context only after principal, purpose and resource ACL filtering",
      "appliesTo": ["core.epistemic.Evidence", "core.epistemic.Observation"],
      "effect": "filter"
    },
    {
      "qualifiedName": "core.policy.noDirectBusinessWrite",
      "description": "H Engine and Company Agent Core cannot write business systems directly",
      "appliesTo": ["core.action.ActionIntent"],
      "effect": "deny"
    },
    {
      "qualifiedName": "core.policy.privateBotIsolation",
      "description": "Employee private Bot history does not enter Company Ontology by default",
      "appliesTo": ["core.identity.Person"],
      "effect": "deny"
    },
    {
      "qualifiedName": "core.policy.workCaseAuthorityGate",
      "description": "Every work case must bind the requester, purpose and policy snapshot before evidence retrieval",
      "appliesTo": ["core.work.WorkCase", "core.work.WorkStage"],
      "effect": "filter"
    },
    {
      "qualifiedName": "core.policy.noHiddenChainOfThought",
      "description": "Persist only evidence references, rules, claims, assumptions, unknowns, conflicts and audit summaries",
      "appliesTo": ["core.work.WorkStage", "core.epistemic.EpistemicAssessment"],
      "effect": "deny"
    },
    {
      "qualifiedName": "core.policy.approvedDecisionBeforeTask",
      "description": "P2 task proposals require an approved decision and selected alternative",
      "appliesTo": ["core.decision.Decision", "core.work.P2", "core.work.Task"],
      "effect": "filter"
    },
    {
      "qualifiedName": "core.policy.verificationBeforeGoalSuccess",
      "description": "Technical execution cannot be promoted to operational or goal success without explicit verification evidence",
      "appliesTo": ["core.action.ActionIntent", "core.work.Verification"],
      "effect": "filter"
    },
    {
      "qualifiedName": "core.policy.noAutomaticLearningDeployment",
      "description": "Learning may propose a change but cannot deploy ontology, policy or business writes automatically",
      "appliesTo": ["core.work.Learning", "system.ontology.OntologyChangeProposal"],
      "effect": "deny"
    }
  ],
  "constraintTypes": [
    {
      "qualifiedName": "core.epistemic.requireProvenance",
      "description": "Every epistemic item must carry provenance",
      "targetType": "core.epistemic.EpistemicItem",
      "severity": "error",
      "rule": "provenanceId != null"
    },
    {
      "qualifiedName": "core.decision.requireDri",
      "description": "Every decision case must have one DRI",
      "targetType": "core.decision.DecisionCase",
      "severity": "error",
      "rule": "driPersonId != null"
    },
    {
      "qualifiedName": "core.work.separateOutcomeLevels",
      "description": "Verification records execution, operational and goal outcomes independently",
      "targetType": "core.work.Verification",
      "severity": "error",
      "rule": "executionSuccess != null && operationalSuccess != null && goalSuccess != null"
    },
    {
      "qualifiedName": "core.action.requireExpectedOutcome",
      "description": "Every action intent declares expected business outcome before approval",
      "targetType": "core.action.ActionIntent",
      "severity": "error",
      "rule": "expectedOutcome != null"
    },
    {
      "qualifiedName": "domain.device.noAutomaticControl",
      "description": "Device state is read-only until a deterministic safety kernel is approved",
      "targetType": "domain.device.DeviceUnit",
      "severity": "error",
      "rule": "directControlEnabled == false"
    },
    {
      "qualifiedName": "core.epistemic.requirePermissionSnapshot",
      "description": "Evidence used by the company brain carries a permission decision snapshot",
      "targetType": "core.epistemic.Evidence",
      "severity": "error",
      "rule": "permissionSnapshot != null"
    },
    {
      "qualifiedName": "core.epistemic.blockUnsupportedCertainty",
      "description": "Stale, conflicting or insufficient evidence cannot support a deterministic conclusion",
      "targetType": "core.epistemic.EpistemicAssessment",
      "severity": "error",
      "rule": "deterministicConclusionAllowed == false when completeness != 'sufficient' || freshnessStatus == 'stale' || contradictionStatus == 'conflicting'"
    },
    {
      "qualifiedName": "core.work.noHiddenChainOfThought",
      "description": "Work stages exclude private model reasoning and store only governed references and summaries",
      "targetType": "core.work.WorkStage",
      "severity": "error",
      "rule": "outputReferences excludes hidden_chain_of_thought"
    },
    {
      "qualifiedName": "core.work.taskRequiresApprovedDecision",
      "description": "Every newly compiled P2 task references an approved decision",
      "targetType": "core.work.Task",
      "severity": "error",
      "rule": "decisionId != null"
    },
    {
      "qualifiedName": "core.work.verificationRequiresEvidence",
      "description": "Completed verification references governed evidence for all three outcome levels",
      "targetType": "core.work.Verification",
      "severity": "error",
      "rule": "evidenceReferences != null && executionStatus != null && operationalStatus != null && goalStatus != null"
    },
    {
      "qualifiedName": "core.work.learningRequiresVerification",
      "description": "Learning can only be created from a completed verification",
      "targetType": "core.work.Learning",
      "severity": "error",
      "rule": "verificationId != null"
    }
  ]
}
