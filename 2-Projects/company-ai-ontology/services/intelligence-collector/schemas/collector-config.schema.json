{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futurus.local/schemas/company-intelligence-collector-config-v1.json",
  "title": "Company Intelligence Collector Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "publish",
    "sourceRegistryFile",
    "stateDir",
    "reportDir",
    "databaseNamespace",
    "accountNamespace",
    "credentialNamespace",
    "feishuOutlet",
    "sourceKeys"
  ],
  "properties": {
    "configVersion": { "const": "1.0.0" },
    "publish": { "const": false },
    "sourceRegistryFile": { "type": "string", "minLength": 1 },
    "stateDir": { "type": "string", "minLength": 1 },
    "reportDir": { "type": "string", "minLength": 1 },
    "databaseNamespace": { "const": "company_strategic_intelligence" },
    "accountNamespace": { "const": "company-ai-ontology-strategic-intelligence" },
    "credentialNamespace": { "const": "company-intelligence" },
    "sourceKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "maxItemsPerSource": { "type": "integer", "minimum": 1, "maximum": 100 },
    "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 5242880 },
    "feishuOutlet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "namespace"],
      "properties": {
        "mode": { "const": "disabled" },
        "namespace": { "const": "company-intelligence-feishu-outlet" }
      }
    }
  }
}
