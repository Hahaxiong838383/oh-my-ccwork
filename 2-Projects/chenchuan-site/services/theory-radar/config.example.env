# Secrets belong in /etc/theory-radar.env (mode 600), never in Git.
PUBLISH=false
THEORY_RADAR_STATE_DIR=/var/lib/theory-radar
THEORY_RADAR_CONTACT_EMAIL=admin@chenchuan.cc

ANALYSIS_PRIMARY_BASE_URL=https://api.x.ai/v1
ANALYSIS_PRIMARY_MODEL=grok-4.5
ANALYSIS_PRIMARY_API_KEY=
ANALYSIS_REASONING_EFFORT=high

ANALYSIS_FALLBACK_ENABLED=false
ANALYSIS_FALLBACK_BASE_URL=
ANALYSIS_FALLBACK_MODEL=
ANALYSIS_FALLBACK_API_KEY=

OPENALEX_API_KEY=
RADAR_WEBHOOK_URL=http://127.0.0.1:3000/api/radar-webhook
RADAR_WEBHOOK_TOKEN=

MIN_PAPERS=4
MAX_PAPERS=8
HTTP_TIMEOUT_SECONDS=45
ANALYSIS_TIMEOUT_SECONDS=240
ARXIV_QUERY_COOLDOWN_HOURS=6
