# ── Site ──
SITE_PORT=3100
DIRECTUS_URL=http://localhost:8055

# AI 前沿资讯雷达：全量新闻服务端缓存 TTL。
# 过期后的首个访问会阻塞拉新；拉取失败才回退上一份可用数据。
RADAR_FEED_CACHE_TTL_SECONDS=300

# ── Directus CMS ──
CMS_PORT=8055
CMS_PUBLIC_URL=http://localhost:8055
DIRECTUS_SECRET=change-me-to-a-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── Database ──
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=directus

# =============================================================================
# 访问统计后台（/admin）— 生产环境必填
# =============================================================================

# 管理员账号 + 密码（明文存储，注意 .env.local 权限 chmod 600 + 不入 git）
# 为什么不用 bcrypt hash：Next.js dotenv-expand 会把 hash 里的 $2b$10$ 当变量
# 展开破坏 hash。明文方案 + 文件权限 600 + JWT cookie + rate limit 足够保护
# 个人站后台。
ANALYTICS_ADMIN_USERNAME=admin
ANALYTICS_ADMIN_PASSWORD=请改成你自己的强密码

# JWT 签名密钥（至少 32 字符的随机字符串）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_JWT_SECRET=请生成 32 字符随机字符串

# IP 哈希盐（同上方法生成，配合月度盐让 IP hash 不可逆）
ANALYTICS_HASH_SECRET=请生成另一个 32 字符随机字符串

# SQLite 数据库路径（不填则默认 data/analytics.db）
# 生产环境建议：/var/www/chenchuan-site/data/analytics.db
# ANALYTICS_DB_PATH=/var/www/chenchuan-site/data/analytics.db

# middleware 内部写入统计接口的共享令牌（至少 32 字符，不能对外暴露）
ANALYTICS_INTERNAL_TOKEN=请生成第三个随机字符串

# middleware 直连 Next.js 的地址；PM2 端口变更时同步调整
# ANALYTICS_INTERNAL_HOST=127.0.0.1:3000

# 精确 IP 列表，逗号或空格分隔。仅放在生产 env，不提交真实地址。
# 站长调试流量会单独归入 owner；AI Ops、Kuma、维护节点归入 aiops。
ANALYTICS_OWNER_IPS=
ANALYTICS_AIOPS_IPS=

# =============================================================================
# Talk-With-My-AI /ai-os/chat — 1.0 上线必填
# =============================================================================

# DeepSeek Provider（简单聊天主力）
# 凭据存 .env.local（chmod 600）。本配置仅文档。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Gemini Proxy（复杂问题主力 / 川哥已有 proxy，凭据见 mycc memory/reference_gemini_proxy.md）
GEMINI_PROXY_BASE_URL=
GEMINI_PROXY_API_KEY=

# 每日预算上限（cents = ¥ × 100，默认 1000 = ¥10）
CHAT_DAILY_BUDGET_CENTS=1000

# 飞书预警 webhook（自定义机器人 URL）
# 不配则三级预警（50% / 80% / 100%）仅写 DB alert_*_sent=TRUE 但不发请求
FEISHU_CHAT_ALERT_WEBHOOK=

# MiniMax Provider（复杂问题主力，2026-07-01 替代 Gemini；reasoning_effort=none + 客户端过滤 <think>）
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
