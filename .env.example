# 飞书通道配置
# 复制此文件为 .env 并填入你的飞书应用凭证

# 飞书应用 ID（在飞书开发者后台获取）
FEISHU_APP_ID=your_feishu_app_id_here

# 飞书应用密钥（在飞书开发者后台获取）
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 接收消息的用户/群组 ID
FEISHU_RECEIVE_USER_ID=your_receive_user_id_here

# 接收 ID 类型：open_id（用户）或 chat_id（群聊）
FEISHU_RECEIVE_ID_TYPE=chat_id

# 连接模式：websocket（长连接）或 poll（轮询）
FEISHU_CONNECTION_MODE=websocket

# 是否显示工具调用：true（显示）或 false（不显示）
# 默认为 true，显示工具调用详情便于调试
FEISHU_SHOW_TOOL_USE=true

# ===== 远程终端配置 =====
# 终端访问密码（设置后启用远程终端功能）
TERMINAL_PASSWORD=
CC_REMOTE_PASSWORD=
CC_REMOTE_PASS=

# ===== Cloudflare 配置 =====
CF_API_TOKEN=
CF_ZONE_ID=
CF_TUNNEL_TOKEN=
# 最大终端会话数
CC_REMOTE_MAX_SESSIONS=10

# ===== 阿里云（deploy-user.sh 使用）=====
ALIBABA_AK_ID=
ALIBABA_AK_SECRET=

# ===== FRP 中转 =====
RELAY_IP=
FRP_TOKEN=

# ===== VPS 服务器信息 =====
DMIT_IP=
LISA_IP=
RACKNERD_IP=

# ===== 飞书 Webhook =====
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ===== 飞书 Bitable =====
FEISHU_BITABLE_APP_TOKEN=

# ===== GitHub =====
GITHUB_TOKEN=
