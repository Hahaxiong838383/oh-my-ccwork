# 飞书通道配置
# 复制此文件为 .env 并填入你的飞书应用凭证

# 飞书应用 ID（在飞书开发者后台获取）
FEISHU_APP_ID=your_feishu_app_id_here

# 飞书应用密钥（在飞书开发者后台获取）
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 接收消息的用户/群组 ID
FEISHU_RECEIVE_USER_ID=your_receive_user_id_here

# 接收 ID 类型：open_id（用户）或 chat_id（群聊）
FEISHU_RECEIVE_ID_TYPE=chat_id

# 连接模式：websocket（长连接）或 poll（轮询）
FEISHU_CONNECTION_MODE=websocket

# 是否显示工具调用：true（显示）或 false（不显示）
# 默认为 true，显示工具调用详情便于调试
FEISHU_SHOW_TOOL_USE=true

# ===== 远程终端配置 =====
# 终端访问密码（设置后启用远程终端功能）
TERMINAL_PASSWORD=

# ===== Cloudflare Named Tunnel（推荐，解决 Error 1014）=====
# 在 Cloudflare Dashboard → Zero Trust → Networks → Tunnels 创建
# 创建时配置公共主机名：CF_DOMAIN → http://localhost:18080
# 创建完成后复制 Tunnel Token 填入下方
CF_TUNNEL_TOKEN=

# ===== Cloudflare DNS 自动配置（可选）=====
# 配合 CF_TUNNEL_TOKEN 使用时，自动创建 CNAME 指向 {uuid}.cfargotunnel.com
# 不配置 CF_TUNNEL_TOKEN 时为 Quick Tunnel 模式（可能触发 Error 1014）
CF_API_TOKEN=
CF_ZONE_ID=
CF_DOMAIN=cli.hahaxiong.top
CF_SUBDOMAIN=
# 最大终端会话数
CC_REMOTE_MAX_SESSIONS=10
