# ============================================
# Daily Tech Pulse 环境变量配置
# ============================================

# ---------------- 定时设置 ----------------
# Cron 表达式：每天 8:00、14:00、20:00 执行
# 可选，默认 "0 8,14,20 * * *"
# CRON_EXPRESSION="0 8,14,20 * * *"

# 每次推送的热度条目数量
# 可选，默认 20
# TOP_N=20

# 推送渠道：email,feishu（多个用逗号分隔）
# 可选，默认 "email,feishu"
# PUSH_CHANNELS=email,feishu

# ---------------- 邮件配置 ----------------
# SMTP 服务器地址
SMTP_HOST=smtp.qq.com

# SMTP 端口（465 或 587）
SMTP_PORT=587

# SMTP 用户名（通常是完整邮箱）
SMTP_USER=your-email@qq.com

# SMTP 密码/授权码
SMTP_PASS=your-auth-code

# 收件人邮箱
EMAIL_TO=13911184569@163.com

# 发件人邮箱（可选，默认等于 SMTP_USER）
# EMAIL_FROM=your-email@qq.com

# ---------------- 飞书配置（可选） ----------------
# 方式一：Webhook 机器人
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# 方式二：飞书应用（需要配置应用权限）
# FEISHU_APP_ID=cli_xxxxx
# FEISHU_APP_SECRET=xxxxx
# FEISHU_CHAT_ID=oc_xxxxx
